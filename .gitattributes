# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.cs text diff=csharp eol=lf
*.cshtml text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.sln text eol=lf
*.editorconfig text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf

# Windows specific scripts
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.docx binary
*.zip binary
*.dll binary
*.pdb binary
*.exe binary
