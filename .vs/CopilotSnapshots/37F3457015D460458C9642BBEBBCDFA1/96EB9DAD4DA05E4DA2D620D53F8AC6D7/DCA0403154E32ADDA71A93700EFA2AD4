@model SupplierSelectionDSS.Data.Entities.EvaluationBatch

@{
    ViewData["Title"] = "Evaluation Batch";

    var isAdmin =
        User.IsInRole("Administrator");

    var isPurchasing =
        User.IsInRole("PurchasingStaff");

    var isExpert =
        User.IsInRole("Expert");

    var canEvaluate =
        isAdmin ||
        isPurchasing ||
        isExpert;

    var canAHP =
        isAdmin ||
        isExpert;
}


<!-- =========================================================
     PAGE HEADER
     ========================================================= -->

<div class="page-header evaluation-batch-header">

    <div>

        <div class="page-eyebrow">
            EVALUATION BATCH
        </div>

        <h1 class="page-title">
            @Model.BatchCode.
        </h1>

        <p class="page-description">
            @Model.BatchName
        </p>

    </div>


    <div class="evaluation-batch-header-actions">

        <span class="status-pill
            status-@Model.Status.ToLowerInvariant()">

            @Model.Status

        </span>


        <a asp-action="Index"
           class="btn-outline">

            Back

        </a>

    </div>

</div>


@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert-success">
        @successMessage
    </div>
}


@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert-danger">
        @errorMessage
    </div>
}


<!-- =========================================================
     WORKFLOW STEPPER
     ========================================================= -->

<div class="batch-workflow">

    <!-- 01 -->

    <div class="batch-workflow-step batch-step-complete">

        <div class="batch-workflow-number">
            01
        </div>

        <div class="batch-workflow-content">

            <span>
                Setup
            </span>

            <small>
                Batch scope
            </small>

        </div>

    </div>


    <div class="batch-workflow-line"></div>


    <!-- 02 -->

    <div class="batch-workflow-step
        @(Model.Status == "Draft"
            ? "batch-step-current"
            : "batch-step-complete")">

        <div class="batch-workflow-number">
            02
        </div>

        <div class="batch-workflow-content">

            <span>
                Evaluation
            </span>

            <small>
                Supplier scores
            </small>

        </div>

    </div>


    <div class="batch-workflow-line"></div>


    <!-- 03 -->

    <div class="batch-workflow-step">

        <div class="batch-workflow-number">
            03
        </div>

        <div class="batch-workflow-content">

            <span>
                AHP
            </span>

            <small>
                Criteria weights
            </small>

        </div>

    </div>


    <div class="batch-workflow-line"></div>


    <!-- 04 -->

    <div class="batch-workflow-step batch-step-disabled">

        <div class="batch-workflow-number">
            04
        </div>

        <div class="batch-workflow-content">

            <span>
                TOPSIS
            </span>

            <small>
                Supplier ranking
            </small>

        </div>

    </div>


    <div class="batch-workflow-line"></div>


    <!-- 05 -->

    <div class="batch-workflow-step batch-step-disabled">

        <div class="batch-workflow-number">
            05
        </div>

        <div class="batch-workflow-content">

            <span>
                Result
            </span>

            <small>
                Approval
            </small>

        </div>

    </div>

</div>


<!-- =========================================================
     SUMMARY
     ========================================================= -->

<div class="batch-summary-grid">


    <!-- Product Group -->

    <div class="surface-card batch-summary-card">

        <span class="card-label">
            PRODUCT GROUP
        </span>

        <strong class="batch-summary-value-text">
            @Model.Group.GroupCode
        </strong>

        <span class="batch-summary-meta">
            @Model.Group.GroupName
        </span>

    </div>


    <!-- Suppliers -->

    <div class="surface-card batch-summary-card">

        <span class="card-label">
            SUPPLIERS
        </span>

        <strong class="batch-summary-value">
            @Model.Suppliers.Count.ToString("00")
        </strong>

        <span class="batch-summary-meta">
            Participating suppliers
        </span>

    </div>


    <!-- Criteria -->

    <div class="surface-card batch-summary-card">

        <span class="card-label">
            CRITERIA
        </span>

        <strong class="batch-summary-value">
            @Model.Criteria.Count.ToString("00")
        </strong>

        <span class="batch-summary-meta">
            Evaluation criteria
        </span>

    </div>


    <!-- Period -->

    <div class="surface-card batch-summary-card">

        <span class="card-label">
            PERIOD
        </span>

        <strong class="batch-summary-value-text">

            @if (Model.StartDate.HasValue)
            {
                    @Model.StartDate.Value.ToString("dd/MM/yyyy")
            }
            else
            {
                @:Not set
            }

        </strong>

        <span class="batch-summary-meta">

            @if (Model.EndDate.HasValue)
            {
                <text>&rarr; @Model.EndDate.Value.ToString("dd/MM/yyyy")</text>
            }

        </span>  


    </div>

</div>


<!-- =========================================================
     CURRENT ACTION
     ========================================================= -->

<div class="batch-action-card">

    <div class="batch-action-content">

        <div class="page-eyebrow">
            DECISION WORKFLOW
        </div>


        @if (Model.Status == "Draft")
        {
            <h2>
                Evaluate this batch.
            </h2>

            <p>
                Nhập dữ liệu đánh giá cho các nhà cung cấp
                trước khi thực hiện AHP.
            </p>
        }
        else if (Model.Status == "Evaluating")
        {
            <h2>
                Continue evaluation.
            </h2>

            <p>
                Tiếp tục hoàn thiện dữ liệu đánh giá và
                chuẩn bị cho bước xác định trọng số AHP.
            </p>
        }
        else if (Model.Status == "Completed")
        {
            <h2>
                Evaluation completed.
            </h2>

            <p>
                Batch đã hoàn tất quy trình đánh giá.
            </p>
        }
        else
        {
            <h2>
                Batch workspace.
            </h2>

            <p>
                Quản lý các bước đánh giá và ra quyết định
                cho batch này.
            </p>
        }

    </div>


    <div class="batch-action-buttons">

        @if (canEvaluate &&
             (Model.Status == "Draft" ||
              Model.Status == "Evaluating"))
        {
            <a asp-controller="Evaluation"
               asp-action="Index"
               asp-route-batchId="@Model.BatchId"
               class="btn-primary">

                Evaluation

            </a>
        }


        @if (canAHP &&
             (Model.Status == "Draft" ||
              Model.Status == "Evaluating"))
        {
            <a href="@Url.Action(
                               "Index",
                               "AHP",
                               new { batchId = Model.BatchId })"
               class="btn-outline">

                AHP

            </a>
        }


        <!-- TOPSIS chưa triển khai ở Bước hiện tại -->

        <button type="button"
                class="btn-outline batch-btn-disabled"
                disabled>

            TOPSIS

        </button>

    </div>

</div>


<!-- =========================================================
     SUPPLIERS
     ========================================================= -->

<div class="dashboard-section">

    <div class="section-heading">

        <div>

            <div class="page-eyebrow">
                SCOPE
            </div>

            <h2 class="section-title">
                Suppliers.
            </h2>

        </div>

    </div>


    <div class="table-card">

        @if (Model.Suppliers.Any())
        {
            <div class="data-table-wrapper">

                <table class="data-table">

                    <thead>

                        <tr>

                            <th>
                                Code
                            </th>

                            <th>
                                Supplier
                            </th>

                            <th>
                                Status
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (
                            var supplier
                            in Model.Suppliers
                                .OrderBy(x => x.SupplierCode))
                        {
                            <tr>

                                <td>

                                    <strong>
                                        @supplier.SupplierCode
                                    </strong>

                                </td>


                                <td>

                                    <strong>
                                        @supplier.SupplierName
                                    </strong>

                                </td>


                                <td>

                                    <span class="status-pill
                                        status-@supplier.Status.ToLowerInvariant()">

                                        @supplier.Status

                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <h3>
                    No suppliers.
                </h3>

                <p>
                    Batch chưa có nhà cung cấp tham gia.
                </p>

            </div>
        }

    </div>

</div>


<!-- =========================================================
     CRITERIA
     ========================================================= -->

<div class="dashboard-section">

    <div class="section-heading">

        <div>

            <div class="page-eyebrow">
                EVALUATION
            </div>

            <h2 class="section-title">
                Criteria.
            </h2>

        </div>

    </div>


    <div class="table-card">

        @if (Model.Criteria.Any())
        {
            <div class="data-table-wrapper">

                <table class="data-table">

                    <thead>

                        <tr>

                            <th>
                                Code
                            </th>

                            <th>
                                Criteria
                            </th>

                            <th>
                                Type
                            </th>

                            <th>
                                Unit
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (
                            var criterion
                            in Model.Criteria
                                .OrderBy(x => x.CriteriaCode))
                        {
                            <tr>

                                <td>

                                    <strong>
                                        @criterion.CriteriaCode
                                    </strong>

                                </td>


                                <td>

                                    <strong>
                                        @criterion.CriteriaName
                                    </strong>

                                    @if (
                                        !string.IsNullOrWhiteSpace(
                                            criterion.Description))
                                    {
                                        <span class="table-muted">
                                            @criterion.Description
                                        </span>
                                    }

                                </td>


                                <td>

                                    @if (
                                        criterion.CriteriaType
                                        == "Benefit")
                                    {
                                        <span class="criteria-type criteria-benefit">
                                            Benefit
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="criteria-type criteria-cost">
                                            Cost
                                        </span>
                                    }

                                </td>


                                <td>

                                    @(
                                        string.IsNullOrWhiteSpace(
                                            criterion.Unit)
                                            ? "—"
                                            : criterion.Unit
                                    )

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <h3>
                    No criteria.
                </h3>

                <p>
                    Batch chưa có tiêu chí đánh giá.
                </p>

            </div>
        }

    </div>

</div>