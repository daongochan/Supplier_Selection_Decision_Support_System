@model SupplierSelectionDSS.Models.TOPSISViewModel

@{
    ViewData["Title"] = "TOPSIS";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/topsis.css" asp-append-version="true" />
}

<div class="page-header">

    <div>

        <div class="page-eyebrow">
            TOPSIS · TECHNIQUE FOR ORDER PREFERENCE
        </div>

        <h1 class="page-title">
            Supplier ranking
        </h1>

        <p class="page-description">
            @Model.BatchCode
            ·
            @Model.BatchName
        </p>

    </div>


    <span class="status-pill status-@Model.Status.ToLowerInvariant()">
        @Model.Status
    </span>

</div>


<!-- =========================================================
     AHP STATUS
     ========================================================= -->

<div class="topsis-readiness-card">

    <div>

        <div class="page-eyebrow">
            AHP READINESS
        </div>

        <h2>
            Criteria weights
        </h2>

    </div>


    @if (!Model.HasAHPResult)
    {
        <span class="topsis-readiness-badge topsis-badge-error">
            AHP result unavailable
        </span>
    }
    else if (!Model.IsAHPConsistent)
    {
        <span class="topsis-readiness-badge topsis-badge-error">
            AHP inconsistent ·
            CR = @Model.AHPConsistencyRatio.ToString("0.0000")
        </span>
    }
    else
    {
        <span class="topsis-readiness-badge topsis-badge-success">
            ✓ AHP consistent ·
            CR = @Model.AHPConsistencyRatio.ToString("0.0000")
        </span>
    }

</div>


<!-- =========================================================
     CRITERIA
     ========================================================= -->

<div class="topsis-summary-grid">

    @foreach (var criterion in Model.Criteria)
    {
        <div class="topsis-criteria-card">

            <span class="topsis-criteria-code">
                @criterion.CriteriaCode
            </span>

            <strong>
                @criterion.CriteriaName
            </strong>

            <div class="topsis-criteria-meta">

                <span>
                    @criterion.CriteriaType
                </span>

                @if (!string.IsNullOrWhiteSpace(
                    criterion.Unit))
                {
                    <span>
                        · @criterion.Unit
                    </span>
                }

            </div>

            <div class="topsis-weight">

                <span>
                    AHP Weight
                </span>

                <strong>
                    @(
                        ((double)criterion.Weight * 100)
                        .ToString("0.00")
                    )%
                </strong>

            </div>

        </div>
    }

</div>


<!-- =========================================================
     DECISION MATRIX
     ========================================================= -->

<div class="table-card topsis-matrix-card">

    <div class="topsis-card-header">

        <div>

            <div class="page-eyebrow">
                DECISION MATRIX
            </div>

            <h2 class="section-title">
                Raw evaluation values
            </h2>

        </div>

    </div>


    <div class="topsis-table-wrapper">

        <table class="topsis-table">

            <thead>

                <tr>

                    <th class="topsis-supplier-column">
                        Supplier
                    </th>

                    @foreach (var criterion
                        in Model.Criteria)
                    {
                        <th>

                            <span>
                                @criterion.CriteriaCode
                            </span>

                            <small>
                                @criterion.CriteriaType
                            </small>

                        </th>
                    }

                </tr>

            </thead>


            <tbody>

                @foreach (var supplier
                    in Model.Suppliers)
                {
                    <tr>

                        <td class="topsis-supplier-cell">

                            <strong>
                                @supplier.SupplierCode
                            </strong>

                            <span>
                                @supplier.SupplierName
                            </span>

                        </td>


                        @foreach (var criterion
                            in Model.Criteria)
                        {
                            <td>

                                @if (supplier.Scores.TryGetValue(
                                    criterion.CriteriaId,
                                    out var score))
                                {
                                    <strong>
                                        @score.ToString("N4")
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(
                                        criterion.Unit))
                                    {
                                        <small>
                                            @criterion.Unit
                                        </small>
                                    }
                                }
                                else
                                {
                                    <span class="topsis-missing">
                                        —
                                    </span>
                                }

                            </td>
                        }

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


<!-- =========================================================
     CALCULATE
     ========================================================= -->
@if (Model.HasAHPResult &&
     Model.IsAHPConsistent)
{
    <form method="post"
          action="@Url.Action(
                      "Calculate",
                      "TOPSIS",
                      new { batchId = Model.BatchId })"
          class="topsis-calculate-form">

        @Html.AntiForgeryToken()

        <div>

            <div class="page-eyebrow">
                DECISION CALCULATION
            </div>

            <h2>
                Calculate supplier ranking
            </h2>

            <p>
                TOPSIS sẽ sử dụng Evaluation Scores và
                trọng số AHP hiện tại để xác định PIS,
                NIS và thứ hạng nhà cung cấp.
            </p>

        </div>


        <button type="submit"
                class="btn-primary"
                data-dss-confirm="Tính toán TOPSIS sẽ tính toán lại xếp hạng các nhà cung cấp dựa trên ma trận đánh giá và trọng số AHP. Bạn có muốn tiếp tục?"
                data-dss-title="Xác nhận tính TOPSIS"
                data-dss-btn-text="Tính toán">

            Calculate TOPSIS

        </button>

    </form>
}
else
{
    <div class="topsis-lock-card">

        <div class="page-eyebrow">
            TOPSIS LOCKED
        </div>

        <h2>
            AHP must be consistent first
        </h2>

        <p>
            Hoàn thành AHP và đạt CR ≤ 0.10 trước khi
            thực hiện TOPSIS.
        </p>

    </div>
}

<!-- =========================================================
     NORMALIZED MATRIX (R)
     ========================================================= -->
@if (Model.NormalizedMatrix.Any())
{
    <div class="table-card topsis-matrix-card">
        <div class="topsis-card-header">
            <div>
                <div class="page-eyebrow">
                    STEP 1 · VECTOR NORMALIZATION
                </div>
                <h2 class="section-title">
                    Ma trận chuẩn hóa (Vector Normalized Matrix R)
                </h2>
            </div>
        </div>

        <div class="topsis-table-wrapper">
            <table class="topsis-table">
                <thead>
                    <tr>
                        <th class="topsis-supplier-column">
                            Nhà cung cấp
                        </th>
                        @foreach (var criterion in Model.Criteria)
                        {
                            <th>
                                <span>@criterion.CriteriaCode</span>
                                <small>@criterion.CriteriaType</small>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.NormalizedMatrix)
                    {
                        <tr>
                            <td class="topsis-supplier-cell">
                                <strong>@row.SupplierCode</strong>
                                <span>@row.SupplierName</span>
                            </td>
                            @foreach (var criterion in Model.Criteria)
                            {
                                <td>
                                    @if (row.Values.TryGetValue(criterion.CriteriaId, out var val))
                                    {
                                        <strong>@val.ToString("0.000000")</strong>
                                    }
                                    else
                                    {
                                        <span class="topsis-missing">—</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- =========================================================
     WEIGHTED NORMALIZED MATRIX (V)
     ========================================================= -->
@if (Model.WeightedMatrix.Any())
{
    <div class="table-card topsis-matrix-card">
        <div class="topsis-card-header">
            <div>
                <div class="page-eyebrow">
                    STEP 2 · WEIGHTED MATRIX
                </div>
                <h2 class="section-title">
                    Ma trận chuẩn hóa có trọng số (V = [v<sub>ij</sub>])
                </h2>
            </div>
        </div>

        <div class="topsis-table-wrapper">
            <table class="topsis-table">
                <thead>
                    <tr>
                        <th class="topsis-supplier-column">
                            Nhà cung cấp
                        </th>
                        @foreach (var criterion in Model.Criteria)
                        {
                            <th>
                                <span>@criterion.CriteriaCode</span>
                                <small>w = @(((double)criterion.Weight * 100).ToString("0.00"))%</small>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.WeightedMatrix)
                    {
                        <tr>
                            <td class="topsis-supplier-cell">
                                <strong>@row.SupplierCode</strong>
                                <span>@row.SupplierName</span>
                            </td>
                            @foreach (var criterion in Model.Criteria)
                            {
                                <td>
                                    @if (row.Values.TryGetValue(criterion.CriteriaId, out var val))
                                    {
                                        <strong>@val.ToString("0.000000")</strong>
                                    }
                                    else
                                    {
                                        <span class="topsis-missing">—</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- =========================================================
     IDEAL SOLUTIONS
     ========================================================= -->
@if (Model.IdealSolutions.Any())
{
    <div class="table-card topsis-ideal-card">


        <div class="topsis-card-header">

            <div>

                <div class="page-eyebrow">
                    IDEAL SOLUTIONS
                </div>

                <h2 class="section-title">
                    PIS & NIS (Ideal Solutions)
                </h2>

            </div>

        </div>


        <div class="topsis-table-wrapper">

            <table class="topsis-table">

                <thead>

                    <tr>

                        <th>
                            Criteria
                        </th>

                        <th>
                            Type
                        </th>

                        <th>
                            PIS
                        </th>

                        <th>
                            NIS
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (
                        var ideal
                        in Model.IdealSolutions)
                    {
                        <tr>

                            <td>

                                <strong>
                                    @ideal.CriteriaCode
                                </strong>

                                <span>
                                    @ideal.CriteriaName
                                </span>

                            </td>


                            <td>
                                @ideal.CriteriaType
                            </td>


                            <td class="topsis-pis">
                                @ideal.PISValue.ToString("N6")
                            </td>


                            <td class="topsis-nis">
                                @ideal.NISValue.ToString("N6")
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}


<!-- =========================================================
     RANKING
     ========================================================= -->
@if (Model.Ranking.Any())
{
    @if (Model.IsIndistinguishable)
    {
        <div class="alert alert-warning mb-3" style="border-radius: var(--radius-md); padding: 14px 18px; border: 1px solid rgba(234, 179, 8, 0.4); background: rgba(234, 179, 8, 0.1);">
            <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>
            <strong>Không phân biệt được:</strong> Tất cả các nhà cung cấp có điểm đánh giá giống hệt nhau trên mọi tiêu chí. Khoảng cách D+ và D- đều bằng 0, không có sự khác biệt thứ hạng.
        </div>
    }

    @if (Model.HasTies)
    {
        <div class="alert alert-info mb-3" style="border-radius: var(--radius-md); padding: 14px 18px; border: 1px solid rgba(59, 130, 246, 0.4); background: rgba(59, 130, 246, 0.1);">
            <i class="bi bi-info-circle-fill me-2 text-primary"></i>
            <strong>Ghi chú xếp hạng:</strong> Có nhà cung cấp đồng hạng (cùng điểm Closeness Coefficient). Hệ thống áp dụng chuẩn xếp hạng Standard Competition Ranking (1, 2, 2, 4).
        </div>
    }

    @if (Model.ZeroVarianceCriteriaCodes.Any())
    {
        <div class="alert alert-warning mb-3" style="border-radius: var(--radius-md); padding: 14px 18px; border: 1px solid rgba(234, 179, 8, 0.4); background: rgba(234, 179, 8, 0.1);">
            <i class="bi bi-exclamation-circle-fill me-2 text-warning"></i>
            <strong>Tiêu chí không phân biệt:</strong> Tiêu chí [@string.Join(", ", Model.ZeroVarianceCriteriaCodes)] có giá trị bằng nhau hoặc bằng 0 ở mọi nhà cung cấp, đã được chuẩn hóa = 0 và không ảnh hưởng đến tỷ trọng phân biệt.
        </div>
    }

    <div class="table-card topsis-ranking-card">

        <div class="topsis-card-header">

            <div>

                <div class="page-eyebrow">
                    FINAL RANKING
                </div>

                <h2 class="section-title">
                    Supplier ranking
                </h2>

            </div>

        </div>


        <div class="topsis-table-wrapper">

            <table class="topsis-table topsis-ranking-table">

                <thead>

                    <tr>

                        <th>
                            Rank
                        </th>

                        <th>
                            Supplier
                        </th>

                        <th>
                            Distance to PIS
                        </th>

                        <th>
                            Distance to NIS
                        </th>

                        <th>
                            Closeness (Ci*)
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var ranking
                        in Model.Ranking
                            .OrderBy(
                                x => x.RankNo))
                    {
                        var isWinner = ranking.RankNo == 1;
                        var pct = Math.Clamp((double)ranking.ClosenessCoefficient * 100, 0, 100);

                        <tr class="@(isWinner ? "topsis-winner-row" : "")">

                            <td>

                                <span class="topsis-rank @(isWinner ? "topsis-rank-winner" : "")">
                                    @if (isWinner)
                                    {
                                        <i class="bi bi-trophy-fill me-1"></i>
                                    }
                                    @ranking.RankNo
                                </span>

                            </td>


                            <td>

                                <strong>
                                    @ranking.SupplierCode
                                </strong>

                                <span>
                                    @ranking.SupplierName
                                </span>

                            </td>


                            <td>
                                @ranking.DistanceToPIS.ToString("0.000000")
                            </td>


                            <td>
                                @ranking.DistanceToNIS.ToString("0.000000")
                            </td>


                            <td>

                                <div style="display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-width: 140px;">
                                    <div style="flex: 1; height: 6px; background: var(--surface-muted); border-radius: 999px; overflow: hidden; min-width: 50px;">
                                        <div style="height: 100%; width: @(pct)%; background: @(isWinner ? "#c67d29" : "var(--lavender-dark)"); border-radius: 999px;"></div>
                                    </div>
                                    <strong class="topsis-score" style="font-family: var(--font-sans); font-variant-numeric: tabular-nums;">
                                        @ranking.ClosenessCoefficient.ToString("0.000000")
                                    </strong>
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}

<!-- =========================================================
     SENSITIVITY ANALYSIS (ACADEMIC FEATURE)
     ========================================================= -->
@if (Model.SensitivityAnalysis != null && Model.SensitivityAnalysis.Scenarios.Any())
{
    <div class="table-card topsis-matrix-card">
        <div class="topsis-card-header d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <div class="page-eyebrow">
                    ACADEMIC FEATURE · PHÂN TÍCH ĐỘ NHẠY
                </div>
                <h2 class="section-title">
                    Độ vững bền của thứ hạng (Sensitivity Analysis ±10%, ±20%)
                </h2>
                <p class="text-muted mt-1" style="font-size: 14px; max-width: 800px;">
                    @Model.SensitivityAnalysis.SummaryMessage
                </p>
            </div>
            <div>
                @if (Model.SensitivityAnalysis.IsOverallRobust)
                {
                    <span class="topsis-readiness-badge topsis-badge-success">
                        ✓ Quyết định vững bền (100% kịch bản giữ nguyên #1)
                    </span>
                }
                else
                {
                    <span class="topsis-readiness-badge topsis-badge-error">
                        ⚠️ Nhạy cảm với biến động (Độ vững bền: @Model.SensitivityAnalysis.RobustnessPercentage%)
                    </span>
                }
            </div>
        </div>

        <div class="topsis-table-wrapper">
            <table class="topsis-table">
                <thead>
                    <tr>
                        <th>Tiêu chí biến thiên</th>
                        <th>Trọng số gốc</th>
                        <th>Độ lệch (Delta)</th>
                        <th>Trọng số mới</th>
                        <th>Nhà cung cấp #1 mới</th>
                        <th>Điểm Closeness</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var scenario in Model.SensitivityAnalysis.Scenarios)
                    {
                        @foreach (var run in scenario.Runs)
                        {
                            <tr>
                                <td>
                                    <strong>@scenario.CriteriaCode</strong>
                                    <span>@scenario.CriteriaName</span>
                                </td>
                                <td>@scenario.BaseWeight.ToString("0.0000")</td>
                                <td>
                                    <strong>@(run.DeltaPercent > 0 ? "+" : "")@run.DeltaPercent%</strong>
                                </td>
                                <td>@run.NewWeight.ToString("0.0000")</td>
                                <td>
                                    <strong>@run.TopSupplierCode</strong>
                                    <span>@run.TopSupplierName</span>
                                </td>
                                <td>
                                    <strong>@run.TopSupplierCloseness.ToString("0.000000")</strong>
                                </td>
                                <td>
                                    @if (run.IsStable)
                                    {
                                        <span class="badge" style="background: var(--sage-soft); color: var(--sage-dark); font-weight: 600; padding: 4px 8px; border-radius: 999px;">
                                            ✓ Ổn định
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background: var(--danger-soft); color: var(--danger-dark); font-weight: 600; padding: 4px 8px; border-radius: 999px;">
                                            ⚠️ Thay đổi #1
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.Ranking != null &&
     Model.Ranking.Any())

{
    <div class="topsis-next-step">

        <div class="topsis-next-step-content">

            <div class="page-eyebrow">
                NEXT STEP
            </div>

            <h2>
                TOPSIS calculation completed.
            </h2>

            <p>
                Kết quả xếp hạng nhà cung cấp đã được lưu.
                Bạn có thể chuyển sang Decision Result để
                xem nhà cung cấp được đề xuất.
            </p>

            <div class="topsis-next-step-meta">

                <span>
                    <i class="bi bi-check-circle-fill"></i>
                    @Model.Ranking.Count suppliers ranked
                </span>

                @{
                    var winner =
                        Model.Ranking
                            .OrderBy(x => x.RankNo)
                            .FirstOrDefault();
                }

                @if (winner != null)
                {
                    <span>
                        <i class="bi bi-trophy-fill"></i>
                        Recommended:
                        <strong>
                            @winner.SupplierCode
                        </strong>
                    </span>
                }

            </div>

        </div>


        <div class="topsis-next-step-actions">

            <a asp-controller="EvaluationBatch"
               asp-action="Details"
               asp-route-id="@Model.BatchId"
               class="btn-outline">

                Batch Details

            </a>


            <a asp-controller="DecisionResult"
               asp-action="Index"
               asp-route-batchId="@Model.BatchId"
               class="btn-primary">

                View Decision Result

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>

    </div>
}