@model SupplierSelectionDSS.Models.TOPSISViewModel

@{
    ViewData["Title"] = "TOPSIS Supplier Ranking";
    var canCalculate = Model.Status != "Completed" && Model.Status != "Cancelled";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/topsis.css" asp-append-version="true" />
    <style>
        .topsis-details-card {
            margin-top: 20px;
            overflow: hidden;
        }
        .topsis-details-summary {
            cursor: pointer;
            padding: 18px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            list-style: none;
            user-select: none;
        }
        .topsis-details-summary::-webkit-details-marker {
            display: none;
        }
        .topsis-details-summary .topsis-chevron {
            transition: transform 0.2s ease;
            font-size: 16px;
            color: var(--muted);
        }
        details.topsis-details-card[open] .topsis-details-summary .topsis-chevron {
            transform: rotate(180deg);
        }
        .topsis-details-body {
            border-top: 1px solid var(--border);
            padding-top: 8px;
        }
    </style>
}

<div class="page-header">

    <div>

        <div class="page-eyebrow">
            TOPSIS · TECHNIQUE FOR ORDER PREFERENCE BY SIMILARITY TO IDEAL SOLUTION
        </div>

        <h1 class="page-title">
            Supplier ranking
        </h1>

        <p class="page-description">
            @Model.BatchCode
            ·
            @Model.BatchName
        </p>

    </div>

    <div class="page-header-actions">
        <span class="status-pill status-@Model.Status.ToLowerInvariant()">
            @Model.Status
        </span>

        <a asp-controller="EvaluationBatch"
           asp-action="Details"
           asp-route-id="@Model.BatchId"
           class="btn-outline">
            Back to Batch
        </a>
    </div>

</div>


<!-- =========================================================
     AHP STATUS & CALCULATE ACTION (PRIMARY FOCUS)
     ========================================================= -->

<div class="topsis-readiness-card">

    <div>

        <div class="page-eyebrow">
            AHP READINESS
        </div>

        <h2>
            Criteria weights &amp; consistency
        </h2>

    </div>


    @if (!Model.HasAHPResult)
    {
        <span class="topsis-readiness-badge topsis-badge-error">
            AHP result unavailable
        </span>
    }
    else if (!Model.IsAHPConsistent)
    {
        <span class="topsis-readiness-badge topsis-badge-error">
            AHP inconsistent ·
            CR = @Model.AHPConsistencyRatio.ToString("0.0000")
        </span>
    }
    else
    {
        <span class="topsis-readiness-badge topsis-badge-success">
            ✓ AHP consistent ·
            CR = @Model.AHPConsistencyRatio.ToString("0.0000")
        </span>
    }

</div>

@if (Model.HasAHPResult && Model.IsAHPConsistent)
{
    @if (canCalculate)
    {
        <form method="post"
              action="@Url.Action(
                          "Calculate",
                          "TOPSIS",
                          new { batchId = Model.BatchId })"
              class="topsis-calculate-form">

            @Html.AntiForgeryToken()
            <input type="hidden"
                   name="rowVersion"
                   value="@Model.RowVersion" />

            <div>

                <div class="page-eyebrow">
                    DECISION CALCULATION
                </div>

                <h2>
                    Calculate supplier ranking
                </h2>

                <p>
                    TOPSIS uses the batch evaluation scores and consistent AHP criteria weights to compute Positive/Negative Ideal Solutions (PIS/NIS), Euclidean distances, and final Closeness Coefficients.
                </p>

            </div>


            <button type="submit"
                    class="btn-primary"
                    data-dss-confirm="Calculating TOPSIS will recompute supplier rankings from the current evaluation matrix and AHP weights. Do you want to continue?"
                    data-dss-title="Calculate TOPSIS Ranking"
                    data-dss-btn-text="Calculate TOPSIS">

                Calculate TOPSIS

            </button>

        </form>
    }
}
else
{
    <div class="topsis-lock-card">

        <div class="page-eyebrow">
            TOPSIS LOCKED
        </div>

        <h2>
            AHP must be consistent first
        </h2>

        <p>
            Complete the AHP pairwise comparison and achieve CR ≤ 0.10 before running TOPSIS ranking.
        </p>

    </div>
}


<!-- =========================================================
     PRIMARY OUTCOME: FINAL SUPPLIER RANKING
     ========================================================= -->
@if (Model.Ranking.Any())
{
    @if (Model.IsIndistinguishable)
    {
        <div class="alert alert-warning mb-3" style="border-radius: var(--radius-md); padding: 14px 18px; border: 1px solid rgba(234, 179, 8, 0.4); background: rgba(234, 179, 8, 0.1);">
            <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>
            <strong>Indistinguishable Alternatives:</strong> All suppliers have identical scores across all criteria. Distances D+ and D- are 0, resulting in tied rankings.
        </div>
    }

    @if (Model.HasTies)
    {
        <div class="alert alert-info mb-3" style="border-radius: var(--radius-md); padding: 14px 18px; border: 1px solid rgba(59, 130, 246, 0.4); background: rgba(59, 130, 246, 0.1);">
            <i class="bi bi-info-circle-fill me-2 text-primary"></i>
            <strong>Tied Ranking Notice:</strong> One or more suppliers share the same Closeness Coefficient. Standard Competition Ranking (1, 2, 2, 4) has been applied.
        </div>
    }

    @if (Model.ZeroVarianceCriteriaCodes.Any())
    {
        <div class="alert alert-warning mb-3" style="border-radius: var(--radius-md); padding: 14px 18px; border: 1px solid rgba(234, 179, 8, 0.4); background: rgba(234, 179, 8, 0.1);">
            <i class="bi bi-exclamation-circle-fill me-2 text-warning"></i>
            <strong>Zero-Variance Criteria:</strong> Criteria [@string.Join(", ", Model.ZeroVarianceCriteriaCodes)] have identical or zero values across all suppliers and do not contribute to differentiation.
        </div>
    }

    <div class="table-card topsis-ranking-card">

        <div class="topsis-card-header">

            <div>

                <div class="page-eyebrow">
                    FINAL RANKING
                </div>

                <h2 class="section-title">
                    Supplier ranking
                </h2>

            </div>

        </div>


        <div class="topsis-table-wrapper">

            <table class="topsis-table topsis-ranking-table">

                <thead>

                    <tr>

                        <th>
                            Rank
                        </th>

                        <th>
                            Supplier
                        </th>

                        <th>
                            Distance to PIS (D+)
                        </th>

                        <th>
                            Distance to NIS (D-)
                        </th>

                        <th>
                            Closeness (Ci*)
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var ranking
                        in Model.Ranking
                            .OrderBy(
                                x => x.RankNo))
                    {
                        var isWinner = ranking.RankNo == 1;
                        var pct = Math.Clamp((double)ranking.ClosenessCoefficient * 100, 0, 100);

                        <tr class="@(isWinner ? "topsis-winner-row" : "")">

                            <td>

                                <span class="topsis-rank @(isWinner ? "topsis-rank-winner" : "")">
                                    @if (isWinner)
                                    {
                                        <i class="bi bi-trophy-fill me-1"></i>
                                    }
                                    @ranking.RankNo
                                </span>

                            </td>


                            <td>

                                <strong>
                                    @ranking.SupplierCode
                                </strong>

                                <span>
                                    @ranking.SupplierName
                                </span>

                            </td>


                            <td>
                                @ranking.DistanceToPIS.ToString("0.000000")
                            </td>


                            <td>
                                @ranking.DistanceToNIS.ToString("0.000000")
                            </td>


                            <td>

                                <div style="display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-width: 140px;">
                                    <div style="flex: 1; height: 6px; background: var(--surface-muted); border-radius: 999px; overflow: hidden; min-width: 50px;">
                                        <div style="height: 100%; width: @(pct)%; background: @(isWinner ? "#c67d29" : "var(--lavender-dark)"); border-radius: 999px;"></div>
                                    </div>
                                    <strong class="topsis-score" style="font-family: var(--font-sans); font-variant-numeric: tabular-nums;">
                                        @ranking.ClosenessCoefficient.ToString("0.000000")
                                    </strong>
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <div class="topsis-next-step">

        <div class="topsis-next-step-content">

            <div class="page-eyebrow">
                NEXT STEP
            </div>

            <h2>
                TOPSIS calculation completed.
            </h2>

            <p>
                Supplier rankings have been saved. Proceed to Decision Result to review the recommended supplier and record the approval decision.
            </p>

            <div class="topsis-next-step-meta">

                <span>
                    <i class="bi bi-check-circle-fill"></i>
                    @Model.Ranking.Count suppliers ranked
                </span>

                @{
                    var winner =
                        Model.Ranking
                            .OrderBy(x => x.RankNo)
                            .FirstOrDefault();
                }

                @if (winner != null)
                {
                    <span>
                        <i class="bi bi-trophy-fill"></i>
                        Recommended:
                        <strong>
                            @winner.SupplierCode
                        </strong>
                    </span>
                }

            </div>

        </div>


        <div class="topsis-next-step-actions">

            <a asp-controller="EvaluationBatch"
               asp-action="Details"
               asp-route-id="@Model.BatchId"
               class="btn-outline">

                Batch Details

            </a>


            <a asp-controller="DecisionResult"
               asp-action="Index"
               asp-route-batchId="@Model.BatchId"
               class="btn-primary">

                View Decision Result

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>

    </div>
}


<!-- =========================================================
     SENSITIVITY ANALYSIS
     ========================================================= -->
@if (Model.SensitivityAnalysis != null && Model.SensitivityAnalysis.Scenarios.Any())
{
    <details class="table-card topsis-matrix-card topsis-details-card" open>
        <summary class="topsis-details-summary">
            <div>
                <div class="page-eyebrow">
                    ROBUSTNESS CHECK · SENSITIVITY ANALYSIS
                </div>
                <h2 class="section-title">
                    Ranking Robustness (Weight Perturbation ±10%, ±20%)
                </h2>
                <p class="text-muted mt-1" style="font-size: 14px; max-width: 800px; margin-bottom: 0;">
                    @Model.SensitivityAnalysis.SummaryMessage
                </p>
            </div>
            <div style="display: flex; align-items: center; gap: 12px;">
                @if (Model.SensitivityAnalysis.IsOverallRobust)
                {
                    <span class="topsis-readiness-badge topsis-badge-success">
                        ✓ Robust (100% scenarios keep Rank #1)
                    </span>
                }
                else
                {
                    <span class="topsis-readiness-badge topsis-badge-error">
                        ⚠️ Sensitive (Robustness: @Model.SensitivityAnalysis.RobustnessPercentage%)
                    </span>
                }
                <i class="bi bi-chevron-down topsis-chevron"></i>
            </div>
        </summary>

        <div class="topsis-details-body">
            <div class="topsis-table-wrapper">
                <table class="topsis-table">
                    <thead>
                        <tr>
                            <th>Perturbed Criterion</th>
                            <th>Base Weight</th>
                            <th>Perturbation (Delta)</th>
                            <th>Adjusted Weight</th>
                            <th>Resulting #1 Supplier</th>
                            <th>Closeness (Ci*)</th>
                            <th>Stability</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var scenario in Model.SensitivityAnalysis.Scenarios)
                        {
                            @foreach (var run in scenario.Runs)
                            {
                                <tr>
                                    <td>
                                        <strong>@scenario.CriteriaCode</strong>
                                        <span>@scenario.CriteriaName</span>
                                    </td>
                                    <td>@scenario.BaseWeight.ToString("0.0000")</td>
                                    <td>
                                        <strong>@(run.DeltaPercent > 0 ? "+" : "")@run.DeltaPercent%</strong>
                                    </td>
                                    <td>@run.NewWeight.ToString("0.0000")</td>
                                    <td>
                                        <strong>@run.TopSupplierCode</strong>
                                        <span>@run.TopSupplierName</span>
                                    </td>
                                    <td>
                                        <strong>@run.TopSupplierCloseness.ToString("0.000000")</strong>
                                    </td>
                                    <td>
                                        @if (run.IsStable)
                                        {
                                            <span class="badge" style="background: var(--sage-soft); color: var(--sage-dark); font-weight: 600; padding: 4px 8px; border-radius: 999px;">
                                                ✓ Stable
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background: var(--danger-soft); color: var(--danger-dark); font-weight: 600; padding: 4px 8px; border-radius: 999px;">
                                                ⚠️ Rank #1 Shifted
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </details>
}


<!-- =========================================================
     PROGRESSIVE DISCLOSURE: INTERMEDIATE MATRICES & INPUTS
     ========================================================= -->

<details class="table-card topsis-matrix-card topsis-details-card" @(!Model.Ranking.Any() ? "open" : null)>
    <summary class="topsis-details-summary">
        <div>
            <div class="page-eyebrow">
                INPUTS · CRITERIA WEIGHTS &amp; RAW DECISION MATRIX
            </div>
            <h2 class="section-title">
                AHP Criteria Weights &amp; Raw Evaluation Matrix
            </h2>
        </div>
        <i class="bi bi-chevron-down topsis-chevron"></i>
    </summary>

    <div class="topsis-details-body" style="padding: 18px 24px 24px;">
        <div class="topsis-summary-grid" style="margin-bottom: 24px;">
            @foreach (var criterion in Model.Criteria)
            {
                <div class="topsis-criteria-card">
                    <span class="topsis-criteria-code">
                        @criterion.CriteriaCode
                    </span>
                    <strong>
                        @criterion.CriteriaName
                    </strong>
                    <div class="topsis-criteria-meta">
                        <span>@criterion.CriteriaType</span>
                        @if (!string.IsNullOrWhiteSpace(criterion.Unit))
                        {
                            <span>· @criterion.Unit</span>
                        }
                    </div>
                    <div class="topsis-weight">
                        <span>AHP Weight</span>
                        <strong>@(((double)criterion.Weight * 100).ToString("0.00"))%</strong>
                    </div>
                </div>
            }
        </div>

        <div class="topsis-table-wrapper">
            <table class="topsis-table">
                <thead>
                    <tr>
                        <th class="topsis-supplier-column">Supplier</th>
                        @foreach (var criterion in Model.Criteria)
                        {
                            <th>
                                <span>@criterion.CriteriaCode</span>
                                <small>@criterion.CriteriaType</small>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var supplier in Model.Suppliers)
                    {
                        <tr>
                            <td class="topsis-supplier-cell">
                                <strong>@supplier.SupplierCode</strong>
                                <span>@supplier.SupplierName</span>
                            </td>
                            @foreach (var criterion in Model.Criteria)
                            {
                                <td>
                                    @if (supplier.Scores.TryGetValue(criterion.CriteriaId, out var score))
                                    {
                                        <strong>@score.ToString("N4")</strong>
                                        @if (!string.IsNullOrWhiteSpace(criterion.Unit))
                                        {
                                            <small>@criterion.Unit</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="topsis-missing">—</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</details>

@if (Model.NormalizedMatrix.Any() || Model.WeightedMatrix.Any() || Model.IdealSolutions.Any())
{
    <details class="table-card topsis-matrix-card topsis-details-card">
        <summary class="topsis-details-summary">
            <div>
                <div class="page-eyebrow">
                    INTERMEDIATE CALCULATIONS · STEP-BY-STEP MATRICES
                </div>
                <h2 class="section-title">
                    Normalized Matrix (R), Weighted Matrix (V) &amp; Ideal Solutions (PIS/NIS)
                </h2>
            </div>
            <i class="bi bi-chevron-down topsis-chevron"></i>
        </summary>

        <div class="topsis-details-body" style="padding: 18px 24px 24px;">
            @if (Model.NormalizedMatrix.Any())
            {
                <h3 style="font-size: 16px; margin: 8px 0 12px;">Step 1 · Vector Normalized Matrix (R)</h3>
                <div class="topsis-table-wrapper" style="margin-bottom: 24px;">
                    <table class="topsis-table">
                        <thead>
                            <tr>
                                <th class="topsis-supplier-column">Supplier</th>
                                @foreach (var criterion in Model.Criteria)
                                {
                                    <th>
                                        <span>@criterion.CriteriaCode</span>
                                        <small>@criterion.CriteriaType</small>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.NormalizedMatrix)
                            {
                                <tr>
                                    <td class="topsis-supplier-cell">
                                        <strong>@row.SupplierCode</strong>
                                        <span>@row.SupplierName</span>
                                    </td>
                                    @foreach (var criterion in Model.Criteria)
                                    {
                                        <td>
                                            @if (row.Values.TryGetValue(criterion.CriteriaId, out var val))
                                            {
                                                <strong>@val.ToString("0.000000")</strong>
                                            }
                                            else
                                            {
                                                <span class="topsis-missing">—</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (Model.WeightedMatrix.Any())
            {
                <h3 style="font-size: 16px; margin: 8px 0 12px;">Step 2 · Weighted Normalized Matrix (V = [v<sub>ij</sub>])</h3>
                <div class="topsis-table-wrapper" style="margin-bottom: 24px;">
                    <table class="topsis-table">
                        <thead>
                            <tr>
                                <th class="topsis-supplier-column">Supplier</th>
                                @foreach (var criterion in Model.Criteria)
                                {
                                    <th>
                                        <span>@criterion.CriteriaCode</span>
                                        <small>w = @(((double)criterion.Weight * 100).ToString("0.00"))%</small>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.WeightedMatrix)
                            {
                                <tr>
                                    <td class="topsis-supplier-cell">
                                        <strong>@row.SupplierCode</strong>
                                        <span>@row.SupplierName</span>
                                    </td>
                                    @foreach (var criterion in Model.Criteria)
                                    {
                                        <td>
                                            @if (row.Values.TryGetValue(criterion.CriteriaId, out var val))
                                            {
                                                <strong>@val.ToString("0.000000")</strong>
                                            }
                                            else
                                            {
                                                <span class="topsis-missing">—</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (Model.IdealSolutions.Any())
            {
                <h3 style="font-size: 16px; margin: 8px 0 12px;">Step 3 · Positive &amp; Negative Ideal Solutions (PIS / NIS)</h3>
                <div class="topsis-table-wrapper">
                    <table class="topsis-table">
                        <thead>
                            <tr>
                                <th>Criteria</th>
                                <th>Type</th>
                                <th>PIS (A+)</th>
                                <th>NIS (A-)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ideal in Model.IdealSolutions)
                            {
                                <tr>
                                    <td>
                                        <strong>@ideal.CriteriaCode</strong>
                                        <span>@ideal.CriteriaName</span>
                                    </td>
                                    <td>@ideal.CriteriaType</td>
                                    <td class="topsis-pis">@ideal.PISValue.ToString("N6")</td>
                                    <td class="topsis-nis">@ideal.NISValue.ToString("N6")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </details>
}
