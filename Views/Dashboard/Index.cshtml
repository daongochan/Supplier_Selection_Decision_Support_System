@model SupplierSelectionDSS.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">

    <div>

        <h1 class="page-title">
            Decision workspace
        </h1>

        <p class="page-description">
            Tổng quan hoạt động đánh giá và lựa chọn nhà cung cấp.
        </p>

    </div>


    @if (User.IsInRole("Administrator") ||
         User.IsInRole("PurchasingStaff"))
    {
        <a asp-controller="EvaluationBatch"
           asp-action="Create"
           class="btn-primary">

            New evaluation

        </a>
    }

</div>


<!-- =========================================================
     KPI
     ========================================================= -->

<div class="dashboard-grid dashboard-grid-4">

    <!-- Suppliers -->
    <a asp-controller="Supplier" asp-action="Index" class="dashboard-card dashboard-card-accent text-decoration-none">
        <div class="dashboard-card-top">
            <span class="card-label">SUPPLIERS</span>
            <span class="semantic-dot"></span>
        </div>
        <strong class="card-value">@Model.SupplierCount.ToString("00")</strong>
        <span class="card-meta">@Model.ActiveSupplierCount active suppliers</span>
    </a>

    <!-- Criteria -->
    <a asp-controller="Criteria" asp-action="Index" class="dashboard-card dashboard-card-lavender text-decoration-none">
        <div class="dashboard-card-top">
            <span class="card-label">CRITERIA</span>
            <span class="semantic-dot"></span>
        </div>
        <strong class="card-value">@Model.CriteriaCount.ToString("00")</strong>
        <span class="card-meta">@Model.ActiveCriteriaCount active criteria</span>
    </a>

    <!-- Evaluation batches -->
    <a asp-controller="EvaluationBatch" asp-action="Index" class="dashboard-card dashboard-card-sky text-decoration-none">
        <div class="dashboard-card-top">
            <span class="card-label">EVALUATION BATCHES</span>
            <span class="semantic-dot"></span>
        </div>
        <strong class="card-value">@Model.EvaluationBatchCount.ToString("00")</strong>
        <span class="card-meta">@Model.DraftBatchCount draft</span>
    </a>

    <!-- Completed -->
    <a asp-controller="EvaluationBatch" asp-action="Index" asp-route-status="Completed" class="dashboard-card dashboard-card-sage text-decoration-none">
        <div class="dashboard-card-top">
            <span class="card-label">COMPLETED</span>
            <span class="semantic-dot"></span>
        </div>
        <strong class="card-value">@Model.CompletedBatchCount.ToString("00")</strong>
        <span class="card-meta">Completed evaluations</span>
    </a>

</div>


<!-- =========================================================
     RECENT BATCHES
     ========================================================= -->

<div class="dashboard-section">

    <div class="section-heading">

        <div>

            <h2 class="section-title">
                Recent evaluation batches
            </h2>

        </div>

    </div>


    <div class="table-card">

        @if (Model.RecentBatches.Any())
        {
            <div class="data-table-wrapper">

                <table class="data-table">

                    <thead>

                        <tr>
                            <th>Code</th>
                            <th>Batch</th>
                            <th>Product Group</th>
                            <th>Status</th>
                            <th>Created</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (
                            var batch
                            in Model.RecentBatches)
                        {
                            <tr>

                                <td>

                                    <a asp-controller="EvaluationBatch"
                                       asp-action="Details"
                                       asp-route-id="@batch.BatchId"
                                       class="text-decoration-none">
                                        <strong>
                                            @batch.BatchCode
                                        </strong>
                                    </a>

                                </td>


                                <td>

                                    <a asp-controller="EvaluationBatch"
                                       asp-action="Details"
                                       asp-route-id="@batch.BatchId"
                                       class="text-decoration-none text-body">
                                        <strong>
                                            @batch.BatchName
                                        </strong>
                                    </a>

                                </td>


                                <td>
                                    @batch.GroupName
                                </td>


                                <td>

                                    <span class="status-pill
                                        status-@batch.Status.ToLowerInvariant()">

                                        @batch.Status

                                    </span>

                                </td>


                                <td>

                                    @batch.CreatedAt.ToString("dd/MM/yyyy")

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <h3>
                    No evaluation batches yet.
                </h3>

                <p>
                    Create your first evaluation batch to begin
                    the supplier selection process.
                </p>


                @if (User.IsInRole("Administrator") ||
                     User.IsInRole("PurchasingStaff"))
                {
                    <a asp-controller="EvaluationBatch"
                       asp-action="Create"
                       class="btn-primary">

                        Create evaluation

                    </a>
                }

            </div>
        }

    </div>

</div>


<!-- =========================================================
     TOPSIS
     ========================================================= -->

<div class="dashboard-section">

    <div class="section-heading">

        <div>

            <h2 class="section-title">
                Latest TOPSIS ranking
            </h2>

        </div>

    </div>


    @if (Model.TopRankings.Any())
    {
        <div class="table-card">

            <div class="data-table-wrapper">

                <table class="data-table">

                    <thead>

                        <tr>
                            <th>Rank</th>
                            <th>Supplier</th>
                            <th>Batch</th>
                            <th>Closeness coefficient</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (
                            var ranking
                            in Model.TopRankings)
                        {
                            <tr>

                                <td>

                                    <span class="rank-number">
                                        #@ranking.RankNo
                                    </span>

                                </td>


                                <td>

                                    <strong>
                                        @ranking.SupplierName
                                    </strong>

                                    <span class="table-muted">
                                        @ranking.SupplierCode
                                    </span>

                                </td>


                                <td>

                                    <a asp-controller="EvaluationBatch"
                                       asp-action="Details"
                                       asp-route-id="@ranking.BatchId"
                                       class="text-decoration-none">
                                        <strong>
                                            @ranking.BatchCode
                                        </strong>
                                    </a>

                                    <span class="table-muted">
                                        @ranking.BatchName
                                    </span>

                                </td>


                                <td>

                                    <strong style="font-family: var(--font-sans); font-variant-numeric: tabular-nums;">
                                        @ranking.ClosenessCoefficient.ToString("0.000")
                                    </strong>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }
    else
    {
        <div class="table-card">

            <div class="empty-state">

                <h3>
                    No TOPSIS results yet.
                </h3>

                <p>
                    Ranking will appear here after an evaluation
                    batch completes AHP and TOPSIS processing.
                </p>

            </div>

        </div>
    }

</div>


<!-- =========================================================
     ATMOSPHERIC FEATURE
     ========================================================= -->

<div class="dashboard-feature">

    <div class="feature-orb"></div>


    <div class="feature-content">

        <div class="page-eyebrow">
            DECISION INTELLIGENCE
        </div>

        <h2>
            AHP weights.
            TOPSIS ranking.
            One decision workspace.
        </h2>

        <p>
            Hệ thống kết hợp trọng số AHP và phương pháp TOPSIS
            để hỗ trợ doanh nghiệp lựa chọn nhà cung cấp dựa
            trên nhiều tiêu chí.
        </p>

    </div>

</div>