@model SupplierSelectionDSS.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var canAccessAhp = User.IsInRole("Administrator") || User.IsInRole("Expert");
    var canAccessTopsis = User.IsInRole("Administrator") || User.IsInRole("Expert");
    var canAccessEvaluation = User.IsInRole("Administrator") || User.IsInRole("PurchasingStaff") || User.IsInRole("Expert") || User.IsInRole("Manager");
    var canAccessApproval = User.IsInRole("Administrator") || User.IsInRole("Manager");
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/dashboard.css" asp-append-version="true" />
}

<!-- =========================================================
     1. DASHBOARD HEADER & CONTEXT CONTROLS
     ========================================================= -->
<div class="dashboard-header-container">
    <div class="dashboard-header-left">
        <h1 class="page-title">Dashboard</h1>
        <p class="page-description">
            Supplier Selection Decision Support System utilizing Analytic Hierarchy Process (AHP) and TOPSIS.
        </p>
    </div>

    <div class="dashboard-header-right">
        <!-- Live Clock -->
        <div id="dashboard-live-clock" class="dashboard-clock-card" aria-label="System Time">
            <i class="bi bi-clock"></i> <span>Loading...</span>
        </div>

        <!-- Global Batch Context Switcher -->
        <div class="batch-selector-box" title="Select an evaluation batch to view context data">
            <label for="batch-context-select"><i class="bi bi-layers"></i> Batch:</label>
            <select id="batch-context-select">
                @if (Model.AvailableBatches.Any())
                {
                    @foreach (var b in Model.AvailableBatches)
                    {
                        <option value="@b.BatchId" selected="@(Model.SelectedBatchId == b.BatchId)">
                            @b.BatchCode (@b.Status)
                        </option>
                    }
                }
                else
                {
                    <option value="">(No batches available)</option>
                }
            </select>
        </div>
    </div>
</div>

<!-- =========================================================
     2. CURRENT BATCH CONTEXT BANNER
     ========================================================= -->
@if (Model.CurrentBatch != null)
{
    var statusClass = Model.CurrentBatch.Status switch
    {
        "Completed" => "status-active",
        "Evaluating" => "status-active",
        "Draft" => "status-inactive",
        "Cancelled" => "status-inactive",
        _ => "status-inactive"
    };

    <div class="current-batch-banner">
        <div class="batch-banner-icon">
            <i class="bi bi-box-seam"></i>
        </div>

        <div class="batch-banner-info">
            <span class="batch-banner-label">Active Evaluation Batch</span>
            <div class="batch-banner-title">@Model.CurrentBatch.BatchCode</div>
            <div class="batch-banner-sub" title="@Model.CurrentBatch.BatchName">@Model.CurrentBatch.BatchName</div>
        </div>

        <div class="batch-banner-field">
            <span class="field-label">Product Group</span>
            <div class="field-value">@Model.CurrentBatch.GroupName</div>
        </div>

        <div class="batch-banner-field">
            <span class="field-label">Status</span>
            <div>
                <span class="status-pill @statusClass">@Model.CurrentBatch.Status</span>
            </div>
        </div>

        <div class="batch-progress-wrapper">
            <div class="batch-progress-text">
                <strong>Scoring Progress</strong>
                <span>@Model.CurrentBatch.ScoredSuppliers / @Model.CurrentBatch.TotalSuppliers Suppliers with scores (@Model.CurrentBatch.ProgressPercent%)</span>
            </div>
            <div class="batch-progress-bar">
                <div class="batch-progress-fill" style="width: @Model.CurrentBatch.ProgressPercent%;"></div>
            </div>
        </div>

        <a asp-controller="EvaluationBatch" asp-action="Details" asp-route-id="@Model.CurrentBatch.BatchId" class="btn-banner-action">
            <span>View Details</span>
            <i class="bi bi-arrow-right"></i>
        </a>
    </div>
}
else
{
    <div class="current-batch-banner banner-simple-grid">
        <div>
            <div class="batch-banner-title">No evaluation batches recorded in the system</div>
            <div class="batch-banner-sub">Create your first evaluation batch to begin the multi-criteria supplier selection process.</div>
        </div>
        <a asp-controller="EvaluationBatch" asp-action="Create" class="btn-primary">
            <i class="bi bi-plus-lg"></i>
            <span>New Evaluation Batch</span>
        </a>
    </div>
}

<!-- =========================================================
     3. 6 KPI SUMMARY CARDS
     ========================================================= -->
<div class="dashboard-kpi-grid">
    <!-- 1. Suppliers -->
    <a asp-controller="Supplier" asp-action="Index" class="dss-kpi-card" title="View supplier list">
        <div class="kpi-card-top">
            <span class="kpi-label">Suppliers</span>
            <div class="kpi-icon-wrap"><i class="bi bi-building"></i></div>
        </div>
        <div class="kpi-card-body">
            <div class="kpi-value">@Model.TotalSuppliers.ToString("N0")</div>
            <div class="kpi-meta">
                <span class="kpi-dot dot-success"></span>
                <span>@Model.ActiveSuppliers active</span>
            </div>
        </div>
    </a>

    <!-- 2. Product Groups -->
    <a asp-controller="ProductGroup" asp-action="Index" class="dss-kpi-card" title="View product groups">
        <div class="kpi-card-top">
            <span class="kpi-label">Product Groups</span>
            <div class="kpi-icon-wrap"><i class="bi bi-boxes"></i></div>
        </div>
        <div class="kpi-card-body">
            <div class="kpi-value">@Model.TotalProductGroups.ToString("N0")</div>
            <div class="kpi-meta">
                <span class="kpi-meta-text">Active categories</span>
            </div>
        </div>
    </a>

    <!-- 3. Evaluation Batches -->
    <a asp-controller="EvaluationBatch" asp-action="Index" class="dss-kpi-card" title="View evaluation batches">
        <div class="kpi-card-top">
            <span class="kpi-label">Evaluation Batches</span>
            <div class="kpi-icon-wrap"><i class="bi bi-calendar2-check"></i></div>
        </div>
        <div class="kpi-card-body">
            <div class="kpi-value">@Model.TotalBatches.ToString("N0")</div>
            <div class="kpi-meta">
                <span class="kpi-dot dot-success"></span>
                <span>@Model.CompletedBatches completed</span>
            </div>
        </div>
    </a>

    <!-- 4. Criteria -->
    <a asp-controller="Criteria" asp-action="Index" class="dss-kpi-card" title="View evaluation criteria">
        <div class="kpi-card-top">
            <span class="kpi-label">Criteria</span>
            <div class="kpi-icon-wrap"><i class="bi bi-sliders"></i></div>
        </div>
        <div class="kpi-card-body">
            <div class="kpi-value">@Model.TotalCriteria.ToString("N0")</div>
            <div class="kpi-meta">
                <span class="kpi-meta-text">DSS criteria set</span>
            </div>
        </div>
    </a>

    <!-- 5. CR (AHP) of Selected Batch -->
    <div class="dss-kpi-card">
        <div class="kpi-card-top">
            <span class="kpi-label">CR Ratio (AHP)</span>
            <div class="kpi-icon-wrap"><i class="bi bi-shield-check"></i></div>
        </div>
        <div class="kpi-card-body">
            <div class="kpi-value">
                @(Model.AhpCrValue.HasValue ? Model.AhpCrValue.Value.ToString("0.0000") : "—")
            </div>
            <div class="kpi-meta">
                @if (Model.AhpCrValue.HasValue)
                {
                    if (Model.IsAhpConsistent == true)
                    {
                        <span class="kpi-dot dot-success"></span>
                        <span class="text-success-soft">Consistent</span>
                    }
                    else
                    {
                        <span class="kpi-dot dot-warning"></span>
                        <span class="text-warning-soft">Inconsistent</span>
                    }
                }
                else
                {
                    <span class="kpi-meta-text">Not calculated</span>
                }
            </div>
        </div>
    </div>

    <!-- 6. Top 1 (TOPSIS) of Selected Batch -->
    <div class="dss-kpi-card">
        <div class="kpi-card-top">
            <span class="kpi-label">Top 1 (TOPSIS)</span>
            <div class="kpi-icon-wrap"><i class="bi bi-trophy"></i></div>
        </div>
        <div class="kpi-card-body">
            <div class="kpi-value @(!string.IsNullOrWhiteSpace(Model.Top1SupplierName) ? "kpi-value-text" : "")" title="@Model.Top1SupplierName">
                @(!string.IsNullOrWhiteSpace(Model.Top1SupplierName) ? Model.Top1SupplierName : "—")
            </div>
            <div class="kpi-meta">
                @if (Model.Top1ClosenessCoefficient.HasValue)
                {
                    <span class="kpi-dot dot-accent"></span>
                    <span>CC: @Model.Top1ClosenessCoefficient.Value.ToString("0.0000")</span>
                }
                else
                {
                    <span class="kpi-meta-text">Not ranked yet</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- =========================================================
     4. ROW 1 CHARTS (3 COLUMNS)
     ========================================================= -->
<div class="dashboard-row1-grid">
    <!-- Col 1: Evaluation Batch Status (Donut) -->
    <div class="panel-card">
        <div class="panel-header">
            <div>
                <h3 class="panel-title">Evaluation Batch Status</h3>
                <p class="panel-subtitle">Distribution by workflow stage</p>
            </div>
        </div>

        <div class="donut-card-body">
            <div class="donut-chart-wrapper">
                <canvas id="batchStatusDonutCanvas" role="img" aria-label="Evaluation batch status distribution chart"></canvas>
                <div class="donut-center-text">
                    <span class="donut-center-val">@Model.TotalBatches</span>
                    <span class="donut-center-lbl">Total Batches</span>
                </div>
            </div>

            <div class="sr-only">
                <table>
                    <caption>Evaluation batch status distribution</caption>
                    <thead><tr><th scope="col">Status</th><th scope="col">Count</th></tr></thead>
                    <tbody>
                        @for (int i = 0; i < Model.BatchStatusDistribution.Labels.Count; i++)
                        {
                            <tr><td>@Model.BatchStatusDistribution.Labels[i]</td><td>@Model.BatchStatusDistribution.Values[i]</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="donut-chart-legend">
                @for (int i = 0; i < Model.BatchStatusDistribution.Labels.Count; i++)
                {
                    var label = Model.BatchStatusDistribution.Labels[i];
                    var val = Model.BatchStatusDistribution.Values[i];
                    var color = Model.BatchStatusDistribution.Colors[i];
                    var pct = Model.TotalBatches > 0 ? (val * 100.0 / Model.TotalBatches).ToString("0.#") : "0";

                    <div class="donut-legend-item">
                        <div class="donut-legend-left">
                            <span class="donut-legend-dot" style="background-color: @color;"></span>
                            <span class="donut-legend-label">@label</span>
                        </div>
                        <div class="donut-legend-right">@val (@pct%)</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Col 2: Evaluation Trend Over Time (Line) -->
    <div class="panel-card">
        <div class="panel-header">
            <div>
                <h3 class="panel-title">Evaluation Trend Over Time</h3>
                <p class="panel-subtitle">Monthly batch count and total supplier participations across batches</p>
            </div>
            <div class="trend-legend-group" id="trendLegendGroup">
                <button type="button" class="trend-legend-pill" data-dataset-index="0" title="Toggle Supplier Participations">
                    <span class="trend-legend-dot dot-suppliers"></span>
                    <span class="trend-legend-label">Supplier Participations</span>
                </button>
                <button type="button" class="trend-legend-pill" data-dataset-index="1" title="Toggle Evaluation Batches">
                    <span class="trend-legend-dot dot-batches"></span>
                    <span class="trend-legend-label">Evaluation Batches</span>
                </button>
            </div>
        </div>

        <div class="line-chart-container">
            <canvas id="evaluationTrendCanvas" role="img" aria-label="Evaluation trend over time chart"></canvas>
        </div>

        <div class="sr-only">
            <table>
                <caption>Evaluation trend over time</caption>
                <thead><tr><th scope="col">Month</th><th scope="col">Supplier Participations</th><th scope="col">Evaluation Batches</th></tr></thead>
                <tbody>
                    @for (int i = 0; i < Model.EvaluationTrend.MonthLabels.Count; i++)
                    {
                        <tr>
                            <td>@Model.EvaluationTrend.MonthLabels[i]</td>
                            <td>@(i < Model.EvaluationTrend.SupplierCounts.Count ? Model.EvaluationTrend.SupplierCounts[i] : 0)</td>
                            <td>@(i < Model.EvaluationTrend.BatchCounts.Count ? Model.EvaluationTrend.BatchCounts[i] : 0)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Col 3: Supplier Status Distribution (Donut) -->
    <div class="panel-card">
        <div class="panel-header">
            <div>
                <h3 class="panel-title">Supplier Status Distribution</h3>
                <p class="panel-subtitle">By operational status</p>
            </div>
        </div>

        <div class="donut-card-body">
            <div class="donut-chart-wrapper">
                <canvas id="supplierStatusDonutCanvas" role="img" aria-label="Supplier operational status distribution chart"></canvas>
                <div class="donut-center-text">
                    <span class="donut-center-val">@Model.TotalSuppliers</span>
                    <span class="donut-center-lbl">Total Suppliers</span>
                </div>
            </div>

            <div class="sr-only">
                <table>
                    <caption>Supplier operational status distribution</caption>
                    <thead><tr><th scope="col">Status</th><th scope="col">Count</th></tr></thead>
                    <tbody>
                        @for (int i = 0; i < Model.SupplierStatusDistribution.Labels.Count; i++)
                        {
                            <tr><td>@Model.SupplierStatusDistribution.Labels[i]</td><td>@Model.SupplierStatusDistribution.Values[i]</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="donut-chart-legend">
                @for (int i = 0; i < Model.SupplierStatusDistribution.Labels.Count; i++)
                {
                    var label = Model.SupplierStatusDistribution.Labels[i];
                    var val = Model.SupplierStatusDistribution.Values[i];
                    var color = Model.SupplierStatusDistribution.Colors[i];
                    var pct = Model.TotalSuppliers > 0 ? (val * 100.0 / Model.TotalSuppliers).ToString("0.#") : "0";

                    <div class="donut-legend-item">
                        <div class="donut-legend-left">
                            <span class="donut-legend-dot" style="background-color: @color;"></span>
                            <span class="donut-legend-label">@label</span>
                        </div>
                        <div class="donut-legend-right">@val (@pct%)</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- =========================================================
     5. ROW 2: TOPSIS RANKING, BAR CHART & WORKFLOW (PANELS)
     ========================================================= -->
<div class="dashboard-row2-grid">
    @if (Model.TopTopsisRankings.Any())
    {
        <!-- Panel 1: Top 5 Suppliers by TOPSIS -->
        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <h3 class="panel-title">Top 5 Suppliers by TOPSIS</h3>
                    <p class="panel-subtitle">Ranking based on Closeness Coefficient (CC)</p>
                </div>
                @if (Model.SelectedBatchId.HasValue && canAccessTopsis)
                {
                    <a asp-controller="TOPSIS" asp-action="Index" asp-route-batchId="@Model.SelectedBatchId.Value" class="btn-banner-action dashboard-btn-sm">
                        TOPSIS Details
                    </a>
                }
            </div>

            <div class="data-table-wrapper dashboard-table-nowrap">
                <table class="data-table dashboard-top-table">
                    <thead>
                        <tr>
                            <th scope="col" class="w-col-rank">Rank</th>
                            <th scope="col">Supplier</th>
                            <th scope="col">Product Group</th>
                            <th scope="col" class="text-end-cell">CC Score</th>
                            <th scope="col" class="text-center-cell">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rank in Model.TopTopsisRankings)
                        {
                            var badgeClass = rank.RankNo switch
                            {
                                1 => "rank-1",
                                2 => "rank-2",
                                3 => "rank-3",
                                _ => "rank-other"
                            };

                            <tr>
                                <td>
                                    <span class="rank-badge @badgeClass">@rank.RankNo</span>
                                </td>
                                <td>
                                    <strong>@rank.SupplierName</strong>
                                    <div class="table-muted cell-code-sm">@rank.SupplierCode</div>
                                </td>
                                <td>
                                    <span class="supplier-group-pill cell-group-pill">@rank.GroupName</span>
                                </td>
                                <td class="cell-score-val">
                                    @rank.ClosenessCoefficient.ToString("0.0000")
                                </td>
                                <td class="text-center-cell">
                                    <span class="status-pill status-active status-pill-sm">Active</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Panel 2: TOPSIS Ranking Bar Chart -->
        <div class="panel-card">
            <div class="panel-header">
                <div>
                    <h3 class="panel-title">TOPSIS Ranking Chart</h3>
                    <p class="panel-subtitle">Comparative Closeness Coefficient of top suppliers</p>
                </div>
            </div>

            <div class="topsis-bar-chart-container">
                <canvas id="topsisBarChartCanvas" role="img" aria-label="TOPSIS ranking comparison bar chart"></canvas>
            </div>
            <div class="sr-only">
                <table>
                    <caption>TOPSIS supplier ranking</caption>
                    <thead><tr><th scope="col">Rank</th><th scope="col">Supplier</th><th scope="col">CC Score</th></tr></thead>
                    <tbody>
                        @foreach (var rank in Model.TopTopsisRankings)
                        {
                            <tr><td>@rank.RankNo</td><td>@rank.SupplierName</td><td>@rank.ClosenessCoefficient.ToString("0.0000")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- Consolidated Informative Single Empty State Spanning Columns 1 & 2 -->
        <div class="panel-card panel-card-span2">
            <div class="panel-header">
                <div>
                    <h3 class="panel-title">TOPSIS Supplier Ranking & Analysis</h3>
                    <p class="panel-subtitle">Multi-criteria ranking based on closeness coefficients</p>
                </div>
            </div>

            <div class="empty-state dashboard-empty-state" style="padding: 48px 24px;">
                <i class="bi bi-diagram-3 dashboard-empty-icon" style="font-size: 38px;"></i>
                <h4 class="dashboard-empty-title">TOPSIS Ranking Pending</h4>
                <p class="dashboard-empty-desc" style="max-width: 480px; margin: 0 auto;">
                    TOPSIS calculation has not been performed for the selected evaluation batch.
                    Complete score entry and verify AHP criteria consistency to generate supplier rankings and comparison charts.
                </p>
                @if (Model.SelectedBatchId.HasValue && canAccessTopsis)
                {
                    <div style="margin-top: 16px;">
                        <a asp-controller="TOPSIS" asp-action="Index" asp-route-batchId="@Model.SelectedBatchId.Value" class="btn-primary">
                            <i class="bi bi-calculator"></i>
                            <span>Open TOPSIS Calculation</span>
                        </a>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Panel 3: Evaluation Workflow Progress -->
    <div class="panel-card">
        <div class="panel-header">
            <div>
                <h3 class="panel-title">Evaluation Workflow Progress</h3>
                <p class="panel-subtitle">5-stage decision support lifecycle</p>
            </div>
        </div>

        <!-- 5-Step Stepper -->
        <div class="workflow-stepper">
            <div class="workflow-step-node @(Model.WorkflowProgress.Step1DataInputDone ? "is-done" : (Model.WorkflowProgress.CurrentStepNumber == 1 ? "is-active" : ""))">
                <div class="workflow-step-dot">
                    @(Model.WorkflowProgress.Step1DataInputDone ? "✓" : "1")
                </div>
                <span class="workflow-step-label">Scoring</span>
            </div>

            <div class="workflow-step-node @(Model.WorkflowProgress.Step2AhpDone ? "is-done" : (Model.WorkflowProgress.CurrentStepNumber == 2 ? "is-active" : ""))">
                <div class="workflow-step-dot">
                    @(Model.WorkflowProgress.Step2AhpDone ? "✓" : "2")
                </div>
                <span class="workflow-step-label">AHP</span>
            </div>

            <div class="workflow-step-node @(Model.WorkflowProgress.Step3TopsisDone ? "is-done" : (Model.WorkflowProgress.CurrentStepNumber == 3 ? "is-active" : ""))">
                <div class="workflow-step-dot">
                    @(Model.WorkflowProgress.Step3TopsisDone ? "✓" : "3")
                </div>
                <span class="workflow-step-label">TOPSIS</span>
            </div>

            <div class="workflow-step-node @(Model.WorkflowProgress.Step4ComparisonDone ? "is-done" : (Model.WorkflowProgress.CurrentStepNumber == 4 ? "is-active" : ""))">
                <div class="workflow-step-dot">
                    @(Model.WorkflowProgress.Step4ComparisonDone ? "✓" : "4")
                </div>
                <span class="workflow-step-label">Review</span>
            </div>

            <div class="workflow-step-node @(Model.WorkflowProgress.Step5ApprovalDone ? "is-done" : (Model.WorkflowProgress.CurrentStepNumber == 5 ? "is-active" : ""))">
                <div class="workflow-step-dot">
                    @(Model.WorkflowProgress.Step5ApprovalDone ? "✓" : "5")
                </div>
                <span class="workflow-step-label">Approval</span>
            </div>
        </div>

        <!-- Stage Card -->
        <div class="workflow-stage-card">
            <div class="workflow-circular-stage">
                @Model.WorkflowProgress.OverallPercent%
            </div>
            <div class="workflow-stage-content">
                <div class="workflow-stage-title">Current Stage: @Model.WorkflowProgress.CurrentStepName</div>
                <div class="workflow-stage-desc">@Model.WorkflowProgress.CurrentStepDescription</div>
                @if (Model.SelectedBatchId.HasValue)
                {
                    var batchId = Model.SelectedBatchId.Value;
                    string currentStepUrl = Model.WorkflowProgress.CurrentStepNumber switch
                    {
                        1 => canAccessEvaluation ? Url.Action("Index", "Evaluation", new { batchId }) ?? "" : Url.Action("Details", "EvaluationBatch", new { id = batchId }) ?? "",
                        2 => canAccessAhp ? Url.Action("Index", "AHP", new { batchId }) ?? "" : Url.Action("Details", "EvaluationBatch", new { id = batchId }) ?? "",
                        3 => canAccessTopsis ? Url.Action("Index", "TOPSIS", new { batchId }) ?? "" : Url.Action("Details", "EvaluationBatch", new { id = batchId }) ?? "",
                        4 => Url.Action("Index", "DecisionResult", new { batchId }) ?? "",
                        5 => canAccessApproval ? Url.Action("Index", "DecisionResult", new { batchId }) ?? "" : Url.Action("Details", "EvaluationBatch", new { id = batchId }) ?? "",
                        _ => Url.Action("Details", "EvaluationBatch", new { id = batchId }) ?? ""
                    };

                    <a href="@currentStepUrl" class="workflow-stage-link">
                        <span>View Details</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- =========================================================
     6. ROW 3: AHP WEIGHTS, RADAR, SYSTEM INFO, APPROVAL (4 PANELS)
     ========================================================= -->
<div class="dashboard-row3-grid">
    <!-- Panel 1: AHP Criteria Weights -->
    <div class="panel-card">
        <div class="panel-header">
            <div>
                <h3 class="panel-title">AHP Criteria Weights</h3>
                <p class="panel-subtitle">Normalized weight distribution from pairwise comparisons</p>
            </div>
            @if (Model.SelectedBatchId.HasValue && canAccessAhp)
            {
                <a asp-controller="AHP" asp-action="Index" asp-route-batchId="@Model.SelectedBatchId.Value" class="btn-banner-action dashboard-btn-sm">
                    AHP Details
                </a>
            }
        </div>

        @if (Model.AhpCriteriaWeights.Any())
        {
            var rankIndex = 1;
            <div class="ahp-weights-list">
                @foreach (var w in Model.AhpCriteriaWeights)
                {
                    <div class="ahp-weight-item">
                        <div class="ahp-bar-header">
                            <div class="ahp-weight-title-group">
                                <span class="ahp-weight-rank">#@rankIndex</span>
                                <span class="ahp-weight-name" title="@w.CriteriaName">@w.CriteriaName</span>
                                <span class="ahp-type-pill @(w.CriteriaType == "Cost" ? "is-cost" : "is-benefit")">
                                    @(w.CriteriaType == "Cost" ? "Cost" : "Benefit")
                                </span>
                            </div>
                            <span class="ahp-weight-percent">@w.Percentage%</span>
                        </div>
                        <div class="ahp-weight-bar-bg">
                            <div class="ahp-weight-bar-fill rank-@rankIndex" style="width: @w.Percentage%;"></div>
                        </div>
                    </div>
                    rankIndex++;
                }
            </div>
        }
        else
        {
            <div class="empty-state dashboard-empty-state">
                <i class="bi bi-pie-chart dashboard-empty-icon"></i>
                <h4 class="dashboard-empty-title">AHP Weights Not Calculated</h4>
                <p class="dashboard-empty-desc">Pairwise comparison matrix must be completed and consistent to compute criteria weights.</p>
            </div>
        }
    </div>

    <!-- Panel 2: Top 3 Supplier Comparison (Radar) -->
    <div class="panel-card">
        <div class="panel-header">
            <div>
                <h3 class="panel-title">Top 3 Supplier Comparison</h3>
                <p class="panel-subtitle">Multi-criteria normalized scale (0 - 100)</p>
            </div>
            @if (Model.SelectedBatchId.HasValue)
            {
                <a asp-controller="DecisionResult" asp-action="Index" asp-route-batchId="@Model.SelectedBatchId.Value" class="btn-banner-action dashboard-btn-sm">
                    Full Comparison
                </a>
            }
        </div>

        @if (Model.RadarComparison.Datasets.Any())
        {
            <div class="radar-chart-container">
                <canvas id="radarComparisonCanvas" role="img" aria-label="Radar multi-criteria comparison chart for top suppliers"></canvas>
            </div>
            <div class="sr-only">
                <table>
                    <caption>Multi-criteria comparison for top 3 suppliers</caption>
                    <thead>
                        <tr>
                            <th scope="col">Criteria</th>
                            @foreach (var ds in Model.RadarComparison.Datasets)
                            {
                                <th scope="col">@ds.SupplierName</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.RadarComparison.CriteriaLabels.Count; i++)
                        {
                            <tr>
                                <td>@Model.RadarComparison.CriteriaLabels[i]</td>
                                @foreach (var ds in Model.RadarComparison.Datasets)
                                {
                                    <td>@(i < ds.Scores.Count ? ds.Scores[i].ToString("0.#") : "—")</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state dashboard-empty-state">
                <i class="bi bi-compass dashboard-empty-icon"></i>
                <h4 class="dashboard-empty-title">Insufficient Comparison Data</h4>
                <p class="dashboard-empty-desc">At least 2 suppliers with evaluation scores are required for radar comparison.</p>
            </div>
        }
    </div>

    <!-- Panel 3: System Information -->
    <div class="panel-card">
        <div class="panel-header">
            <div>
                <h3 class="panel-title">System Information</h3>
                <p class="panel-subtitle">Environment and operational metrics</p>
            </div>
        </div>

        <div class="system-info-list">
            <div class="system-info-item">
                <div class="system-info-label"><i class="bi bi-people"></i> Total Users</div>
                <div class="system-info-val">@Model.SystemInfo.UserCount</div>
            </div>
            <div class="system-info-item">
                <div class="system-info-label"><i class="bi bi-shield-lock"></i> Role-based Access</div>
                <div class="system-info-val">@Model.SystemInfo.RoleCount Roles</div>
            </div>
            <div class="system-info-item">
                <div class="system-info-label"><i class="bi bi-cpu"></i> Application Version</div>
                <div class="system-info-val">@Model.SystemInfo.AppVersion</div>
            </div>
            <div class="system-info-item">
                <div class="system-info-label"><i class="bi bi-database"></i> Database Engine</div>
                <div class="system-info-val">@Model.SystemInfo.DatabaseType</div>
            </div>
            <div class="system-info-item">
                <div class="system-info-label"><i class="bi bi-activity"></i> Status</div>
                <div class="system-info-val text-success">@Model.SystemInfo.SystemStatus</div>
            </div>
        </div>
    </div>

    <!-- Panel 4: Approval Decision -->
    <div class="panel-card">
        <div class="panel-header">
            <div>
                <h3 class="panel-title">Approval Decision</h3>
                <p class="panel-subtitle">Official supplier selection record</p>
            </div>
        </div>

        <div class="approval-card-content">
            @if (Model.ApprovalInfo != null)
            {
                var appStatusClass = Model.ApprovalInfo.Status switch
                {
                    "Approved" => "is-approved",
                    "PendingReevaluation" => "is-pending",
                    "Rejected" => "is-rejected",
                    _ => "is-none"
                };

                <div class="approval-status-banner @appStatusClass">
                    <span>
                        <i class="bi @(Model.ApprovalInfo.Status == "Approved" ? "bi-check-circle" : "bi-exclamation-circle")"></i>
                        @Model.ApprovalInfo.Status
                    </span>
                    <span class="cell-date-sm">@Model.ApprovalInfo.ApprovalDate.ToString("MMM dd, yyyy")</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ApprovalInfo.SelectedSupplierName))
                {
                    <div class="approval-detail-row">
                        <span class="sub-label">Selected Supplier</span>
                        <div class="sub-val">@Model.ApprovalInfo.SelectedSupplierName</div>
                    </div>
                }

                <div class="approval-detail-row">
                    <span class="sub-label">Approved By</span>
                    <div class="sub-val">@Model.ApprovalInfo.ApproverName</div>
                </div>

                <div class="card-action-bar-end">
                    @if (Model.SelectedBatchId.HasValue)
                    {
                        <a asp-controller="Report" asp-action="Index" asp-route-batchId="@Model.SelectedBatchId.Value" class="btn-primary btn-flex-1">
                            <i class="bi bi-file-earmark-pdf"></i>
                            <span>View Report</span>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="approval-status-banner is-none">
                    <span><i class="bi bi-clock"></i> Pending Submission</span>
                </div>
                <p class="approval-help-desc">
                    The current evaluation batch does not have a finalized approval decision.
                </p>
                @if (Model.SelectedBatchId.HasValue && User.IsInRole("Manager"))
                {
                    <a asp-controller="DecisionResult" asp-action="Index" asp-route-batchId="@Model.SelectedBatchId.Value" class="btn-outline btn-mt-auto">
                        <span>Submit for Approval</span>
                    </a>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- Offline Local Chart.js 4.4.7 UMD -->
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>

    <!-- Embedded Dashboard Data Payloads -->
    <script>
        window.dashboardBatchData = {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BatchStatusDistribution.Labels)),
            values: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BatchStatusDistribution.Values)),
            colors: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BatchStatusDistribution.Colors))
        };

        window.dashboardSupplierData = {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SupplierStatusDistribution.Labels)),
            values: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SupplierStatusDistribution.Values)),
            colors: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SupplierStatusDistribution.Colors))
        };

        window.dashboardTrendData = {
            months: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EvaluationTrend.MonthLabels)),
            batches: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EvaluationTrend.BatchCounts)),
            suppliers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EvaluationTrend.SupplierCounts))
        };

        window.dashboardTopsisBarData = {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopTopsisRankings.Select(r => r.SupplierName))),
            values: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopTopsisRankings.Select(r => (double)r.ClosenessCoefficient)))
        };

        window.dashboardRadarData = {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RadarComparison.CriteriaLabels)),
            types: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RadarComparison.CriteriaTypes)),
            units: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RadarComparison.CriteriaUnits)),
            datasets: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RadarComparison.Datasets))
        };
    </script>

    <!-- Dashboard Interaction Script -->
    <script src="~/js/pages/dashboard.js" asp-append-version="true"></script>
}
