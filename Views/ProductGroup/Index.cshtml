@model SupplierSelectionDSS.Models.ProductGroupIndexViewModel

@{
    ViewData["Title"] = "Product Groups";

    var activePercent = Model.TotalGroups > 0 
        ? (Model.ActiveGroups * 100.0 / Model.TotalGroups).ToString("0.#") 
        : "0";
    var inactivePercent = Model.TotalGroups > 0 
        ? (Model.InactiveGroups * 100.0 / Model.TotalGroups).ToString("0.#") 
        : "0";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/product-group.css" asp-append-version="true" />
}

<!-- =========================================================
     PAGE HEADER
     ========================================================= -->
<div class="page-header">
    <div>
        <h1 class="page-title">Product Groups</h1>
        <p class="page-description">
            Manage product categories, procurement classifications, and supplier associations.
        </p>
    </div>

    <a asp-action="Create" class="btn-primary">
        <i class="bi bi-plus-lg"></i>
        <span>New Product Group</span>
    </a>
</div>

<!-- =========================================================
     KPI SUMMARY GRID (100% GENUINE DATABASE METRICS)
     ========================================================= -->
<div class="group-kpi-grid">
    <!-- Card 1: Total Groups -->
    <div class="group-kpi-card">
        <div class="group-kpi-content">
            <span class="group-kpi-label">Total Groups</span>
            <span class="group-kpi-value">@Model.TotalGroups.ToString("N0")</span>
            <div class="group-kpi-meta">
                <span class="kpi-meta-pill pill-blue">
                    <i class="bi bi-boxes"></i> System categories
                </span>
            </div>
        </div>
        <div class="group-kpi-icon icon-blue" aria-hidden="true">
            <i class="bi bi-boxes"></i>
        </div>
    </div>

    <!-- Card 2: Active Groups -->
    <div class="group-kpi-card">
        <div class="group-kpi-content">
            <span class="group-kpi-label">Active</span>
            <span class="group-kpi-value">@Model.ActiveGroups.ToString("N0")</span>
            <div class="group-kpi-meta">
                <span class="kpi-meta-pill pill-green">
                    <i class="bi bi-check2"></i> @activePercent% of total
                </span>
            </div>
        </div>
        <div class="group-kpi-icon icon-green" aria-hidden="true">
            <i class="bi bi-check-circle"></i>
        </div>
    </div>

    <!-- Card 3: Inactive Groups -->
    <div class="group-kpi-card">
        <div class="group-kpi-content">
            <span class="group-kpi-label">Inactive</span>
            <span class="group-kpi-value">@Model.InactiveGroups.ToString("N0")</span>
            <div class="group-kpi-meta">
                <span class="kpi-meta-pill pill-muted">
                    <i class="bi bi-pause"></i> @inactivePercent% of total
                </span>
            </div>
        </div>
        <div class="group-kpi-icon icon-slate" aria-hidden="true">
            <i class="bi bi-slash-circle"></i>
        </div>
    </div>

    <!-- Card 4: Linked Suppliers -->
    <div class="group-kpi-card">
        <div class="group-kpi-content">
            <span class="group-kpi-label">Linked Suppliers</span>
            <span class="group-kpi-value">@Model.TotalLinkedSuppliers.ToString("N0")</span>
            <div class="group-kpi-meta">
                <span class="kpi-meta-pill pill-indigo">
                    <i class="bi bi-building-check"></i> Group assignments
                </span>
            </div>
        </div>
        <div class="group-kpi-icon icon-indigo" aria-hidden="true">
            <i class="bi bi-building-check"></i>
        </div>
    </div>
</div>

<!-- =========================================================
     SEARCH & FILTER CARD
     ========================================================= -->
<div class="filter-card">
    <form asp-action="Index" method="get" class="group-filter">
        <input type="hidden" name="page" value="1" />

        <!-- 1. Keyword Search -->
        <div class="filter-field">
            <label for="keyword">Search</label>
            <input id="keyword"
                   name="keyword"
                   value="@Model.Keyword"
                   class="form-control"
                   placeholder="Group code, name, description..." />
        </div>

        <!-- 2. Status Dropdown -->
        <div class="filter-field">
            <label for="status">Status</label>
            <select id="status" name="status" class="form-control">
                <option value="All" selected="@(string.IsNullOrEmpty(Model.Status) || Model.Status == "All")">
                    All Statuses
                </option>
                <option value="Active" selected="@(Model.Status == "Active")">
                    Active
                </option>
                <option value="Inactive" selected="@(Model.Status == "Inactive")">
                    Inactive
                </option>
            </select>
        </div>

        <!-- 3. Filter Action Buttons (Same height 42px) -->
        <div class="filter-actions">
            <button type="submit" class="btn-primary" title="Search">
                Search
            </button>

            <a asp-action="Index" class="btn-outline" title="Reset filter">
                Reset
            </a>
        </div>
    </form>
</div>

<!-- =========================================================
     CENTRAL DATA TABLE CARD
     ========================================================= -->
<div class="table-card">
    @if (Model.ProductGroups.Any())
    {
        <div class="data-table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 140px;">Code</th>
                        <th style="min-width: 220px;">Product Group Name</th>
                        <th style="min-width: 260px;">Description</th>
                        <th style="width: 160px;">Suppliers</th>
                        <th style="width: 150px;">Status</th>
                        <th style="width: 70px; text-align: center;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var group in Model.ProductGroups)
                    {
                        var supplierCount = group.Suppliers?.Count ?? 0;
                        <tr>
                            <!-- Group Code -->
                            <td>
                                <span class="group-code-badge">@group.GroupCode</span>
                            </td>

                            <!-- Group Name -->
                            <td>
                                <div class="group-name-cell">
                                    <a asp-action="Edit" asp-route-id="@group.GroupId" class="group-name-link">
                                        @group.GroupName
                                    </a>
                                </div>
                            </td>

                            <!-- Description -->
                            <td>
                                @if (!string.IsNullOrWhiteSpace(group.Description))
                                {
                                    <span class="group-description-cell" title="@group.Description">
                                        @group.Description
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <!-- Linked Suppliers -->
                            <td>
                                <a asp-action="Suppliers" asp-route-id="@group.GroupId" 
                                   class="group-suppliers-pill @(supplierCount == 0 ? "is-empty" : "")"
                                   title="View and manage suppliers assigned to this group">
                                    <i class="bi bi-building"></i>
                                    <span>@supplierCount @(supplierCount == 1 ? "Supplier" : "Suppliers")</span>
                                </a>
                            </td>

                            <!-- Status -->
                            <td>
                                @if (group.Status == "Active")
                                {
                                    <span class="status-pill status-active">Active</span>
                                }
                                else
                                {
                                    <span class="status-pill status-inactive">Inactive</span>
                                }
                            </td>

                            <!-- Actions dropdown [ ⋯ ] -->
                            <td style="text-align: center;">
                                <div class="group-actions-dropdown">
                                    <button type="button"
                                            class="btn-action-dots"
                                            aria-label="Actions for @group.GroupName"
                                            aria-haspopup="true"
                                            aria-expanded="false"
                                            title="Actions">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>

                                    <div class="group-actions-menu">
                                        <a asp-action="Edit"
                                           asp-route-id="@group.GroupId"
                                           class="group-action-item">
                                            <i class="bi bi-pencil"></i>
                                            <span>Edit</span>
                                        </a>

                                        <a asp-action="Suppliers"
                                           asp-route-id="@group.GroupId"
                                           class="group-action-item">
                                            <i class="bi bi-building-check"></i>
                                            <span>Assign Suppliers</span>
                                        </a>

                                        <div class="group-action-divider"></div>

                                        <form asp-action="ToggleStatus"
                                              method="post"
                                              class="m-0 p-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden"
                                                   name="id"
                                                   value="@group.GroupId" />
                                            <button type="submit"
                                                    class="group-action-item @(group.Status == "Active" ? "text-danger" : "text-success")"
                                                    data-dss-confirm="@(group.Status == "Active" ? $"Are you sure you want to deactivate product group \"{group.GroupName}\"?" : $"Are you sure you want to reactivate product group \"{group.GroupName}\"?")"
                                                    data-dss-title="@(group.Status == "Active" ? "Confirm Deactivation" : "Confirm Activation")"
                                                    data-dss-btn-text="@(group.Status == "Active" ? "Deactivate" : "Activate")">
                                                @if (group.Status == "Active")
                                                {
                                                    <i class="bi bi-slash-circle"></i>
                                                    <span>Deactivate</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-check-circle"></i>
                                                    <span>Activate</span>
                                                }
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="Model" />
    }
    else
    {
        <div class="empty-state">
            <div style="font-size: 40px; color: var(--muted); margin-bottom: 12px;">
                <i class="bi bi-search"></i>
            </div>
            <h3>No product groups found</h3>
            <p>
                No product groups match the current search criteria.
                Please try again with different keywords or filters.
            </p>
            <div style="display: flex; gap: 10px; justify-content: center; margin-top: 16px;">
                <a asp-action="Index" class="btn-outline">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Reset filter</span>
                </a>
                <a asp-action="Create" class="btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    <span>Add New Product Group</span>
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Dropdown menu toggle
            document.addEventListener("click", function (e) {
                const trigger = e.target.closest(".btn-action-dots");
                const openDropdown = document.querySelector(".group-actions-dropdown.is-open");

                if (trigger) {
                    e.stopPropagation();
                    const parent = trigger.closest(".group-actions-dropdown");
                    if (openDropdown && openDropdown !== parent) {
                        openDropdown.classList.remove("is-open");
                        const prevBtn = openDropdown.querySelector(".btn-action-dots");
                        if (prevBtn) prevBtn.setAttribute("aria-expanded", "false");
                    }
                    if (parent) {
                        const isOpen = parent.classList.toggle("is-open");
                        trigger.setAttribute("aria-expanded", isOpen ? "true" : "false");
                    }
                } else if (openDropdown && !e.target.closest(".group-actions-menu")) {
                    openDropdown.classList.remove("is-open");
                    const prevBtn = openDropdown.querySelector(".btn-action-dots");
                    if (prevBtn) prevBtn.setAttribute("aria-expanded", "false");
                }
            });

            // Close on Escape key and return focus
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") {
                    const openDropdown = document.querySelector(".group-actions-dropdown.is-open");
                    if (openDropdown) {
                        openDropdown.classList.remove("is-open");
                        const trigger = openDropdown.querySelector(".btn-action-dots");
                        if (trigger) {
                            trigger.setAttribute("aria-expanded", "false");
                            trigger.focus();
                        }
                    }
                }
            });
        });
    </script>
}
