@model SupplierSelectionDSS.Models.ProductGroupSuppliersViewModel

@{
    ViewData["Title"] = "Gán nhà cung cấp - " + Model.GroupName;
}

<div class="page-header">

    <div>

        <div class="page-eyebrow">
            NHÓM HÀNG
        </div>

        <h1 class="page-title">
            Gán nhà cung cấp: @Model.GroupName
        </h1>

        <p class="page-description">
            Chọn các nhà cung cấp có khả năng cung ứng cho nhóm hàng này trong hệ thống.
        </p>

    </div>


    <a asp-action="Index"
       class="btn-outline">
        <i class="bi bi-arrow-left"></i>
        <span>Quay lại</span>
    </a>

</div>


<div class="form-card">

    <form asp-action="Suppliers"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="id"
               value="@Model.GroupId" />


        <div class="assignment-header">

            <div>

                <span class="card-label">
                    Mã nhóm: @Model.GroupCode
                </span>

                <h2 class="card-title">
                    Danh sách nhà cung cấp khả dụng
                </h2>

            </div>

        </div>


        <div class="supplier-selection-grid">

            @foreach (var supplier in Model.Suppliers)
            {
                <label class="supplier-selection-item">

                    <input type="checkbox"
                           name="supplierIds"
                           value="@supplier.SupplierId"
                           checked="@supplier.Selected" />

                    <span class="supplier-selection-content">

                        <span class="supplier-selection-code">
                            @supplier.SupplierCode
                        </span>

                        <span class="supplier-selection-name">
                            @supplier.SupplierName
                        </span>

                    </span>

                </label>
            }

        </div>


        @if (!Model.Suppliers.Any())
        {
            <div class="empty-state">

                <h3>
                    Không có nhà cung cấp nào đang hoạt động.
                </h3>

                <p>
                    Hãy tạo hoặc kích hoạt nhà cung cấp trước khi thực hiện gán.
                </p>

            </div>
        }


        <div class="form-actions">

            <a asp-action="Index"
               class="btn-outline">
                Hủy bỏ
            </a>

            <button type="submit"
                    class="btn-primary">
                Lưu phân bổ
            </button>

        </div>

    </form>

</div>