@model SupplierSelectionDSS.Models.ProductGroupFormViewModel

@{
    ViewData["Title"] = "Add Product Group";
}

<div class="page-header">

    <div>

        <h1 class="page-title">
            Add Product Group
        </h1>

        <p class="page-description">
            Add a new product group or service category to the system.
        </p>

    </div>

</div>


<div class="form-card">

    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>


        <div class="form-grid">

            <!-- 1. Group Identity -->
            <div class="form-section">
                <div class="form-section-title">Product Group Information</div>
                <div class="form-section-desc">Identifier code and name for the product group</div>
            </div>

            <div class="form-group">
                <label asp-for="GroupCode" class="required-field">
                    Product Group Code
                </label>
                <input asp-for="GroupCode"
                       class="form-control"
                       maxlength="20"
                       placeholder="e.g. PG-001 or ELEC"
                       autocomplete="off" />
                <span asp-validation-for="GroupCode" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="GroupName" class="required-field">
                    Product Group Name
                </label>
                <input asp-for="GroupName"
                       class="form-control"
                       maxlength="150"
                       placeholder="Category name of supplied products or services" />
                <span asp-validation-for="GroupName" class="text-danger"></span>
            </div>

            <!-- 2. Detailed Description -->
            <div class="form-section">
                <div class="form-section-title">Description & Notes</div>
                <div class="form-section-desc">Detailed information regarding scope and characteristics</div>
            </div>

            <div class="form-group form-group-full">
                <label asp-for="Description">
                    Description
                </label>
                <textarea asp-for="Description"
                          class="form-control"
                          maxlength="500"
                          placeholder="Describe scope of application, technical standards, or relevant notes..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

        </div>


        <div class="form-actions">

            <a asp-action="Index"
               class="btn-outline">
                Cancel
            </a>

            <button type="submit"
                    class="btn-primary">
                Save Product Group
            </button>

        </div>

    </form>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
