@model SupplierSelectionDSS.Models.ProductGroupFormViewModel

@{
    ViewData["Title"] = "Add Product Group";
}

<div class="page-header">

    <div>

        <div class="page-eyebrow">
            PRODUCT GROUPS
        </div>

        <h1 class="page-title">
            Add group
        </h1>

        <p class="page-description">
            Tạo một nhóm hàng hóa hoặc dịch vụ mới.
        </p>

    </div>

</div>


<div class="form-card">

    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>


        <div class="form-grid">

            <div class="form-group">

                <label asp-for="GroupCode">
                    Group code
                </label>

                <input asp-for="GroupCode"
                       class="form-control"
                       maxlength="20" />

                <span asp-validation-for="GroupCode"
                      class="text-danger">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="GroupName">
                    Group name
                </label>

                <input asp-for="GroupName"
                       class="form-control"
                       maxlength="150" />

                <span asp-validation-for="GroupName"
                      class="text-danger">
                </span>

            </div>


            <div class="form-group form-group-full">

                <label asp-for="Description">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          maxlength="500"></textarea>

            </div>

        </div>


        <div class="form-actions">

            <a asp-action="Index"
               class="btn-outline">
                Cancel
            </a>

            <button type="submit"
                    class="btn-primary">
                Save group
            </button>

        </div>

    </form>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}