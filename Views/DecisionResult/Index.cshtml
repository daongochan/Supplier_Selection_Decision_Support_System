@model SupplierSelectionDSS.Models.DecisionResultViewModel

@{
    ViewData["Title"] = "Final Decision & Approval";

    var canApprove =
        User.IsInRole("Administrator") ||
        User.IsInRole("Manager");

    var canReport =
        User.IsInRole("Administrator") ||
        User.IsInRole("Manager");
}


<!-- =========================================================
     PAGE HEADER
     ========================================================= -->

<div class="page-header decision-page-header">

    <div>

        <div class="page-eyebrow">
            FINAL DECISION · ROUND @Model.CurrentRoundNumber
        </div>

        <h1 class="page-title">
            Supplier ranking &amp; decision
        </h1>

        <p class="page-description">
            @Model.BatchCode
            ·
            @Model.BatchName
        </p>

    </div>


    <div class="decision-header-actions">

        <span class="status-pill
            status-@Model.BatchStatus.ToLowerInvariant()">

            @Model.BatchStatus

        </span>


        <a asp-controller="EvaluationBatch"
           asp-action="Details"
           asp-route-id="@Model.BatchId"
           class="btn-outline">

            Back to Batch

        </a>

    </div>

</div>


<!-- =========================================================
     WORKFLOW
     ========================================================= -->

<div class="decision-workflow">

    <div class="decision-workflow-step complete">

        <span class="decision-workflow-number">
            01
        </span>

        <div class="decision-workflow-copy">

            <strong>
                Evaluation
            </strong>

            <small>
                Scores
            </small>

        </div>

    </div>


    <div class="decision-workflow-line"></div>


    <div class="decision-workflow-step complete">

        <span class="decision-workflow-number">
            02
        </span>

        <div class="decision-workflow-copy">

            <strong>
                AHP
            </strong>

            <small>
                Weights
            </small>

        </div>

    </div>


    <div class="decision-workflow-line"></div>


    <div class="decision-workflow-step complete">

        <span class="decision-workflow-number">
            03
        </span>

        <div class="decision-workflow-copy">

            <strong>
                TOPSIS
            </strong>

            <small>
                Ranking
            </small>

        </div>

    </div>


    <div class="decision-workflow-line"></div>


    <div class="decision-workflow-step current">

        <span class="decision-workflow-number">
            04
        </span>

        <div class="decision-workflow-copy">

            <strong>
                Decision
            </strong>

            <small>
                Approval
            </small>

        </div>

    </div>

</div>

@if (Model.IsFrozenFromSnapshot)
{
    <div class="alert alert-info mb-3" style="border-radius: var(--radius-md); padding: 14px 18px; border: 1px solid rgba(59, 130, 246, 0.35); background: rgba(59, 130, 246, 0.08);">
        <i class="bi bi-lock-fill me-2 text-primary"></i>
        <strong>Reproducible Evidence Snapshot:</strong> This completed decision is rendered from the immutable Round @Model.CurrentRoundNumber snapshot (@(Model.SnapshotMethodVersion ?? "AHP+TOPSIS")) recorded at final approval. Subsequent changes to master supplier or criteria names do not alter this historical record.
    </div>
}


@if (!Model.Ranking.Any())
{
    <!-- =====================================================
         EMPTY
         ===================================================== -->

    <div class="empty-state">

        <h2>
            No TOPSIS result
        </h2>

        <p>
            TOPSIS ranking has not been calculated for the current round of this evaluation batch.
        </p>


        <a asp-controller="TOPSIS"
           asp-action="Index"
           asp-route-batchId="@Model.BatchId"
           class="btn-primary">

            Back to TOPSIS

        </a>

    </div>
}
else
{
    <!-- =====================================================
         RECOMMENDED SUPPLIER
         ===================================================== -->
    @if (Model.RecommendedSupplier != null)
    {
        <div class="decision-recommendation">

            <div>

                <div class="page-eyebrow">
                    RECOMMENDATION
                </div>

                <h2>
                    @Model.RecommendedSupplier.SupplierCode
                    ·
                    @Model.RecommendedSupplier.SupplierName
                </h2>

                <p>
                    Top-ranked supplier by TOPSIS with
                    Closeness Coefficient =
                    <strong>
                        @Model.RecommendedSupplier.ClosenessCoefficient.ToString("0.000000")
                    </strong>
                </p>

            </div>


            <div class="decision-winner-badge">

                #1

            </div>

        </div>
    }


    <!-- =====================================================
         RANKING
         ===================================================== -->

    <div class="table-card decision-ranking-card">

        <div class="decision-card-header">

            <div>

                <div class="page-eyebrow">
                    TOPSIS RESULT
                </div>

                <h2 class="section-title">
                    Final ranking
                </h2>

            </div>

        </div>


        <div class="table-wrapper">

            <table class="data-table decision-ranking-table">

                <thead>

                    <tr>

                        <th>
                            Rank
                        </th>

                        <th>
                            Supplier
                        </th>

                        <th>
                            Distance to PIS
                        </th>

                        <th>
                            Distance to NIS
                        </th>

                        <th>
                            Closeness
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (
                        var item
                        in Model.Ranking
                            .OrderBy(
                                x =>
                                    x.RankNo))
                    {
                        <tr class="
                            @(item.RankNo == 1
                                ? "decision-winner-row"
                                : "")">

                            <td>

                                <span class="decision-rank">
                                    @item.RankNo
                                </span>

                            </td>


                            <td>

                                <strong>
                                    @item.SupplierCode
                                </strong>

                                <span class="table-muted">
                                    @item.SupplierName
                                </span>

                            </td>


                            <td>
                                @item.DistanceToPIS.ToString("0.000000")
                            </td>


                            <td>
                                @item.DistanceToNIS.ToString("0.000000")
                            </td>


                            <td>

                                <strong>
                                    @item.ClosenessCoefficient.ToString("0.000000")
                                </strong>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- =====================================================
         SENSITIVITY ANALYSIS
         ===================================================== -->
    @if (Model.SensitivityAnalysis != null && Model.SensitivityAnalysis.Scenarios.Any())
    {
        <div class="table-card decision-ranking-card" style="margin-top: 24px;">
            <div class="decision-card-header" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px;">
                <div>
                    <div class="page-eyebrow">
                        ROBUSTNESS CHECK · SENSITIVITY ANALYSIS
                    </div>
                    <h2 class="section-title">
                        Decision Stability (Weight Perturbation ±10%, ±20%)
                    </h2>
                    <p class="table-muted" style="margin-top: 6px; font-size: 14px; max-width: 780px;">
                        @Model.SensitivityAnalysis.SummaryMessage
                    </p>
                </div>
                <div>
                    @if (Model.SensitivityAnalysis.IsOverallRobust)
                    {
                        <span class="badge" style="background: var(--sage-soft); color: var(--sage-dark); font-weight: 600; padding: 6px 12px; border-radius: 999px; font-size: 13px;">
                            ✓ 100% Robust (Rank #1 Unchanged)
                        </span>
                    }
                    else
                    {
                        <span class="badge" style="background: var(--danger-soft); color: var(--danger-dark); font-weight: 600; padding: 6px 12px; border-radius: 999px; font-size: 13px;">
                            ⚠️ Robustness: @Model.SensitivityAnalysis.RobustnessPercentage%
                        </span>
                    }
                </div>
            </div>
        </div>
    }

    <!-- =====================================================
         APPROVAL
         ===================================================== -->

    @if (
            Model.HasApproval &&
            string.Equals(
                Model.ApprovalStatus,
                "Approved",
                StringComparison.OrdinalIgnoreCase))
    {
        <!-- =================================================
             FINAL APPROVED
             ================================================= -->

        <div class="decision-approval-card decision-approval-approved" id="final-approval">

            <div class="decision-approval-header">
                <div>
                    <div class="page-eyebrow">
                        FINAL APPROVAL
                    </div>

                    <h2 class="decision-approval-title">
                        <i class="bi bi-check-circle-fill"></i>
                        Approved
                    </h2>
                </div>

                <div class="decision-approved-badge">
                    <i class="bi bi-shield-check"></i>
                    Final Decision
                </div>
            </div>

            <div class="decision-approval-summary">

                <div class="decision-summary-supplier">
                    <span>Approved Supplier</span>
                    <div class="decision-supplier-highlight">
                        @if (!string.IsNullOrWhiteSpace(Model.SelectedSupplierCode))
                        {
                            <span class="decision-supplier-code-tag">@Model.SelectedSupplierCode</span>
                        }
                        <strong>@(Model.SelectedSupplierName ?? "—")</strong>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ApprovedByName))
                {
                    <div>
                        <span>Approved by</span>
                        <strong>@Model.ApprovedByName</strong>
                    </div>
                }

                @if (Model.ApprovalDate.HasValue)
                {
                    <div>
                        <span>Date</span>
                        <strong>@Model.ApprovalDate.Value.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                }

            </div>


            @if (!string.IsNullOrWhiteSpace(Model.ApprovalNotes))
            {
                <div class="decision-approval-notes-box">
                    <span class="decision-notes-label">
                        <i class="bi bi-sticky"></i> Notes:
                    </span>
                    <span class="decision-notes-content">
                        @Model.ApprovalNotes
                    </span>
                </div>
            }


            <div class="decision-approval-toolbar">
                <div class="decision-toolbar-secondary">
                    <a asp-controller="EvaluationBatch"
                       asp-action="Details"
                       asp-route-id="@Model.BatchId"
                       class="btn-outline">
                        Batch Details
                    </a>
                </div>

                <div class="decision-toolbar-primary">
                    @if (canReport)
                    {
                        <a asp-controller="Report"
                           asp-action="Index"
                           asp-route-batchId="@Model.BatchId"
                           class="btn-primary">
                            <i class="bi bi-file-earmark-bar-graph"></i>
                            Reports
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                </div>
            </div>

        </div>
    }
    else if (
        Model.HasApproval &&
        string.Equals(
            Model.ApprovalStatus,
            "Rejected",
            StringComparison.OrdinalIgnoreCase))
    {
        <!-- =================================================
             REJECTED
             ================================================= -->

        <div class="
            decision-approval-card
            decision-approval-rejected">

            <div class="page-eyebrow">
                DECISION REVIEW
            </div>

            <h2>
                Decision rejected
            </h2>

            <p>
                The current supplier ranking proposal was rejected.
                A manager or administrator can request a re-evaluation round to revise scores and criteria weights.
            </p>


            @if (
                !string.IsNullOrWhiteSpace(
                    Model.ApprovalNotes))
            {
                <p class="decision-approval-notes">

                    <strong>
                        Reason:
                    </strong>

                    @Model.ApprovalNotes

                </p>
            }


            @if (canApprove)
            {
                <form method="post"
                      action="@Url.Action(
                                  "Reevaluate",
                                  "DecisionResult",
                                  new
                                  {
                                      batchId = Model.BatchId
                                  })">

                    @Html.AntiForgeryToken()
                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />

                    <button type="submit"
                            class="btn-primary"
                            data-dss-confirm="Requesting re-evaluation will snapshot the current round and clear active Evaluation, AHP, and TOPSIS results for a new round. Do you want to proceed?"
                            data-dss-title="Request Re-evaluation"
                            data-dss-btn-text="Re-evaluate">

                        Re-evaluate

                        <i class="bi bi-arrow-repeat"></i>

                    </button>

                </form>
            }

        </div>
    }
    else if (
        Model.HasApproval &&
        string.Equals(
            Model.ApprovalStatus,
            "PendingReevaluation",
            StringComparison.OrdinalIgnoreCase))
    {
        <!-- =================================================
             PENDING RE-EVALUATION
             ================================================= -->

        <div class="
            decision-approval-card
            decision-approval-pending">

            <div class="page-eyebrow">
                RE-EVALUATION
            </div>

            <h2>
                Re-evaluation requested
            </h2>

            <p>
                A new evaluation round has been initiated.
                Previous round inputs and rankings have been archived in the round snapshot history.
            </p>


            @if (
                User.IsInRole("Administrator") ||
                User.IsInRole("PurchasingStaff") ||
                User.IsInRole("Expert"))
            {
                <a asp-controller="Evaluation"
                   asp-action="Index"
                   asp-route-batchId="@Model.BatchId"
                   class="btn-primary">

                    Continue to Evaluation

                    <i class="bi bi-arrow-right"></i>

                </a>
            }

        </div>
    }
    else if (
        canApprove &&
        Model.RecommendedSupplier != null &&
        Model.BatchStatus != "Completed" &&
        Model.BatchStatus != "Cancelled")
    {
        <!-- =================================================
             SELECT FINAL SUPPLIER
             ================================================= -->

        <div class="decision-approval-card">

            <div class="page-eyebrow">
                APPROVAL
            </div>

            <h2>
                Select final supplier
            </h2>

            <p class="decision-approval-description">
                TOPSIS recommends
                <strong>
                    @Model.RecommendedSupplier.SupplierCode
                </strong>
                at Rank #1. Managers may select any ranked supplier below; selecting a non-Rank-1 supplier requires a documented justification.
            </p>


            <!-- =============================================
                 SECONDARY ACTION FORMS (HTML5 Form Association)
                 ============================================= -->
            <form method="post"
                  action="@Url.Action("Reject", "DecisionResult", new { batchId = Model.BatchId })"
                  id="rejectForm"
                  style="display:none;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                <input type="hidden" name="notes" id="rejectNotesHidden" value="" />
            </form>

            <form method="post"
                  action="@Url.Action("Reevaluate", "DecisionResult", new { batchId = Model.BatchId })"
                  id="reevaluateForm"
                  style="display:none;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                <input type="hidden" name="notes" id="reevaluateNotesHidden" value="" />
            </form>

            <!-- =============================================
                 SUPPLIER SELECTION & UNIFIED APPROVAL TOOLBAR
                 ============================================= -->
            <form method="post"
                  action="@Url.Action("Approve", "DecisionResult", new { batchId = Model.BatchId })"
                  id="approvalForm">

                @Html.AntiForgeryToken()
                <input type="hidden" name="rowVersion" value="@Model.RowVersion" />

                <div class="decision-supplier-selection">
                    @foreach (var item in Model.Ranking.OrderBy(x => x.RankNo))
                    {
                        <label class="decision-supplier-option @(item.RankNo == 1 ? "recommended is-selected" : "")">
                            <input type="radio"
                                   name="supplierId"
                                   value="@item.SupplierId"
                                   @(item.RankNo == 1 ? "checked" : null)
                                   class="decision-supplier-radio" />

                            <span class="decision-supplier-radio-mark"></span>

                            <span class="decision-supplier-rank">
                                #@item.RankNo
                            </span>

                            <span class="decision-supplier-main">
                                <strong>@item.SupplierCode</strong>
                                <span>@item.SupplierName</span>
                            </span>

                            <span class="decision-supplier-score">
                                <small>TOPSIS CC</small>
                                <strong>@item.ClosenessCoefficient.ToString("0.000000")</strong>
                            </span>
                        </label>
                    }
                </div>

                <div class="decision-approval-notes-field" style="margin-top: 16px; margin-bottom: 20px;">
                    <label for="approvalNotesInput" class="form-label" style="font-weight: 600; display: flex; align-items: center; gap: 8px;">
                        <span>Decision Notes / Justification</span>
                        <span id="rankWarningBadge" style="display: none; color: #dc2626; font-size: 12px; font-weight: normal; background: #fee2e2; padding: 2px 8px; border-radius: 4px;">
                            <i class="bi bi-exclamation-triangle"></i> Justification is required when selecting a non-Rank-1 supplier
                        </span>
                    </label>
                    <textarea id="approvalNotesInput"
                              name="notes"
                              class="form-control"
                              rows="2"
                              placeholder="Enter approval rationale, rejection reason, or re-evaluation notes (mandatory if overriding Rank #1)..."
                              style="width: 100%; border: 1px solid #cbd5e1; border-radius: 6px; padding: 8px 12px; font-family: inherit; font-size: 14px;"></textarea>
                </div>

                <div class="decision-approval-toolbar">
                    <div class="decision-toolbar-secondary">
                        <button type="submit"
                                form="rejectForm"
                                class="btn-outline btn-outline-danger"
                                data-dss-confirm="Are you sure you want to reject the current evaluation decision?"
                                data-dss-title="Reject Decision"
                                data-dss-btn-text="Reject">
                            <i class="bi bi-x-circle"></i>
                            Reject
                        </button>

                        <button type="submit"
                                form="reevaluateForm"
                                class="btn-outline btn-outline-warning"
                                data-dss-confirm="Requesting re-evaluation will snapshot the current round and clear active Evaluation, AHP, and TOPSIS results for a new round. Do you want to proceed?"
                                data-dss-title="Request Re-evaluation"
                                data-dss-btn-text="Re-evaluate">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            Re-evaluate
                        </button>
                    </div>

                    <div class="decision-toolbar-primary">
                        <button type="submit"
                                class="btn-primary"
                                data-dss-confirm="Are you sure you want to approve the selected supplier as the official decision for this evaluation batch?"
                                data-dss-title="Confirm Final Approval"
                                data-dss-btn-text="Approve">
                            Approve selected supplier
                            <i class="bi bi-check2"></i>
                        </button>
                    </div>
                </div>
            </form>

        </div>
    }
}

<!-- =========================================================
     APPEND-ONLY DECISION HISTORY (F05)
     ========================================================= -->
@if (Model.DecisionHistory.Any())
{
    <div class="table-card decision-ranking-card" style="margin-top: 28px;" id="decision-history">
        <div class="decision-card-header">
            <div>
                <div class="page-eyebrow">
                    GOVERNANCE LOG · APPEND-ONLY TIMELINE
                </div>
                <h2 class="section-title">
                    Decision &amp; approval history
                </h2>
            </div>
        </div>

        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Round</th>
                        <th>Action / Status</th>
                        <th>Selected Supplier</th>
                        <th>Actor</th>
                        <th>Timestamp</th>
                        <th>Notes / Justification</th>
                        <th>State</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model.DecisionHistory)
                    {
                        <tr>
                            <td>
                                <strong>Round #@ev.RoundNumber</strong>
                            </td>
                            <td>
                                <span class="status-pill status-@ev.Status.ToLowerInvariant()">
                                    @ev.Status
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(ev.SelectedSupplierCode) || !string.IsNullOrWhiteSpace(ev.SelectedSupplierName))
                                {
                                    <strong>@(ev.SelectedSupplierCode ?? "—")</strong>
                                    <span class="table-muted">@ev.SelectedSupplierName</span>
                                }
                                else
                                {
                                    <span class="table-muted">—</span>
                                }
                            </td>
                            <td>@(ev.ApprovedByName ?? "—")</td>
                            <td>@ev.ApprovalDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(string.IsNullOrWhiteSpace(ev.Notes) ? "—" : ev.Notes)</td>
                            <td>
                                @if (ev.IsFinal)
                                {
                                    <span class="badge" style="background: var(--sage-soft); color: var(--sage-dark); font-weight: 600; padding: 4px 10px; border-radius: 999px;">
                                        Final
                                    </span>
                                }
                                else if (ev.IsSuperseded)
                                {
                                    <span class="badge" style="background: var(--surface-muted); color: var(--muted); font-weight: 600; padding: 4px 10px; border-radius: 999px;">
                                        Superseded
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background: var(--amber-soft); color: var(--amber-dark); font-weight: 600; padding: 4px 10px; border-radius: 999px;">
                                        Active Round
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- =========================================================
     ROUND EVIDENCE SNAPSHOTS (F06)
     ========================================================= -->
@if (Model.RoundSnapshots.Any())
{
    <div class="table-card decision-ranking-card" style="margin-top: 28px;" id="round-snapshots">
        <div class="decision-card-header">
            <div>
                <div class="page-eyebrow">
                    HISTORICAL ARCHIVE · FROZEN EVIDENCE
                </div>
                <h2 class="section-title">
                    Evaluation round snapshots
                </h2>
            </div>
        </div>

        <div class="table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Round</th>
                        <th>Snapshot Type</th>
                        <th>Rank #1 Supplier (Frozen)</th>
                        <th>Selected Supplier</th>
                        <th>AHP CR</th>
                        <th>Recorded By</th>
                        <th>Timestamp</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var snap in Model.RoundSnapshots)
                    {
                        <tr>
                            <td><strong>Round #@snap.RoundNumber</strong></td>
                            <td>
                                <span class="status-pill status-@snap.SnapshotType.ToLowerInvariant()">
                                    @snap.SnapshotType
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(snap.TopSupplierCode))
                                {
                                    <strong>@snap.TopSupplierCode</strong>
                                    <span class="table-muted">@snap.TopSupplierName (CC: @(snap.TopClosenessCoefficient?.ToString("0.000000") ?? "—"))</span>
                                }
                                else
                                {
                                    <span class="table-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(snap.SelectedSupplierCode) || !string.IsNullOrWhiteSpace(snap.SelectedSupplierName))
                                {
                                    <strong>@(snap.SelectedSupplierCode ?? "—")</strong>
                                    <span class="table-muted">@snap.SelectedSupplierName</span>
                                }
                                else
                                {
                                    <span class="table-muted">—</span>
                                }
                            </td>
                            <td>@(snap.AhpCrValue?.ToString("0.0000") ?? "—")</td>
                            <td>@(snap.ActorName ?? "—")</td>
                            <td>@snap.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(string.IsNullOrWhiteSpace(snap.Notes) ? "—" : snap.Notes)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/decision-result.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var radios = document.querySelectorAll('input[name="supplierId"]');
            var notesBadge = document.getElementById('rankWarningBadge');
            var notesInput = document.getElementById('approvalNotesInput');
            var form = document.getElementById('approvalForm');
            var rejectForm = document.getElementById('rejectForm');
            var reevaluateForm = document.getElementById('reevaluateForm');
            var rejectNotesHidden = document.getElementById('rejectNotesHidden');
            var reevaluateNotesHidden = document.getElementById('reevaluateNotesHidden');

            function syncSecondaryNotes() {
                var val = notesInput ? notesInput.value : '';
                if (rejectNotesHidden) rejectNotesHidden.value = val;
                if (reevaluateNotesHidden) reevaluateNotesHidden.value = val;
            }

            if (notesInput) {
                notesInput.addEventListener('input', syncSecondaryNotes);
            }
            if (rejectForm) {
                rejectForm.addEventListener('submit', syncSecondaryNotes);
            }
            if (reevaluateForm) {
                reevaluateForm.addEventListener('submit', syncSecondaryNotes);
            }

            function updateNotesRequirement() {
                var selectedRadio = document.querySelector('input[name="supplierId"]:checked');
                if (!selectedRadio) return;
                var label = selectedRadio.closest('.decision-supplier-option');
                var isRank1 = label && label.querySelector('.decision-supplier-rank') && label.querySelector('.decision-supplier-rank').textContent.includes('#1');
                if (isRank1) {
                    if (notesBadge) notesBadge.style.display = 'none';
                    if (notesInput) {
                        notesInput.removeAttribute('required');
                        notesInput.setCustomValidity('');
                    }
                } else {
                    if (notesBadge) notesBadge.style.display = 'inline-flex';
                    if (notesInput) {
                        notesInput.setAttribute('required', 'required');
                        if (!notesInput.value.trim()) {
                            notesInput.setCustomValidity('Justification is required when selecting a non-Rank-1 supplier.');
                        } else {
                            notesInput.setCustomValidity('');
                        }
                    }
                }
            }

            radios.forEach(function (r) {
                r.addEventListener('change', updateNotesRequirement);
            });
            if (notesInput) {
                notesInput.addEventListener('input', updateNotesRequirement);
            }
            updateNotesRequirement();

            if (form) {
                form.addEventListener('submit', function (e) {
                    updateNotesRequirement();
                    var selectedRadio = document.querySelector('input[name="supplierId"]:checked');
                    if (!selectedRadio) return;
                    var label = selectedRadio.closest('.decision-supplier-option');
                    var isRank1 = label && label.querySelector('.decision-supplier-rank') && label.querySelector('.decision-supplier-rank').textContent.includes('#1');
                    if (!isRank1 && (!notesInput || !notesInput.value.trim())) {
                        e.preventDefault();
                        if (notesInput) {
                            notesInput.reportValidity();
                            notesInput.focus();
                        }
                    }
                });
            }
        });
    </script>
}
