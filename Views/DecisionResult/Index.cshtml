@model SupplierSelectionDSS.Models.DecisionResultViewModel

@{
    ViewData["Title"] = "Final Result";

    var canApprove =
        User.IsInRole("Administrator") ||
        User.IsInRole("Manager");

    var canReport =
        User.IsInRole("Administrator") ||
        User.IsInRole("Manager");
}


<!-- =========================================================
     PAGE HEADER
     ========================================================= -->

<div class="page-header decision-page-header">

    <div>

        <div class="page-eyebrow">
            FINAL DECISION
        </div>

        <h1 class="page-title">
            Supplier ranking
        </h1>

        <p class="page-description">
            @Model.BatchCode
            ·
            @Model.BatchName
        </p>

    </div>


    <div class="decision-header-actions">

        <span class="status-pill
            status-@Model.BatchStatus.ToLowerInvariant()">

            @Model.BatchStatus

        </span>


        <a asp-controller="EvaluationBatch"
           asp-action="Details"
           asp-route-id="@Model.BatchId"
           class="btn-outline">

            Back to Batch

        </a>

    </div>

</div>




<!-- =========================================================
     WORKFLOW
     ========================================================= -->

<div class="decision-workflow">

    <div class="decision-workflow-step complete">

        <span class="decision-workflow-number">
            01
        </span>

        <div class="decision-workflow-copy">

            <strong>
                Evaluation
            </strong>

            <small>
                Scores
            </small>

        </div>

    </div>


    <div class="decision-workflow-line"></div>


    <div class="decision-workflow-step complete">

        <span class="decision-workflow-number">
            02
        </span>

        <div class="decision-workflow-copy">

            <strong>
                AHP
            </strong>

            <small>
                Weights
            </small>

        </div>

    </div>


    <div class="decision-workflow-line"></div>


    <div class="decision-workflow-step complete">

        <span class="decision-workflow-number">
            03
        </span>

        <div class="decision-workflow-copy">

            <strong>
                TOPSIS
            </strong>

            <small>
                Ranking
            </small>

        </div>

    </div>


    <div class="decision-workflow-line"></div>


    <div class="decision-workflow-step current">

        <span class="decision-workflow-number">
            04
        </span>

        <div class="decision-workflow-copy">

            <strong>
                Decision
            </strong>

            <small>
                Approval
            </small>

        </div>

    </div>

</div>


@if (!Model.Ranking.Any())
{
    <!-- =====================================================
         EMPTY
         ===================================================== -->

    <div class="empty-state">

        <h2>
            No TOPSIS result
        </h2>

        <p>
            Chưa có kết quả xếp hạng TOPSIS cho Batch này.
        </p>


        <a asp-controller="TOPSIS"
           asp-action="Index"
           asp-route-batchId="@Model.BatchId"
           class="btn-primary">

            Back to TOPSIS

        </a>

    </div>
}
else
{
    <!-- =====================================================
         RECOMMENDED SUPPLIER
         ===================================================== -->
    @if (Model.RecommendedSupplier != null)
    {
        <div class="decision-recommendation">

            <div>

                <div class="page-eyebrow">
                    RECOMMENDATION
                </div>

                <h2>
                    @Model.RecommendedSupplier.SupplierCode
                    ·
                    @Model.RecommendedSupplier.SupplierName
                </h2>

                <p>
                    Nhà cung cấp đứng đầu theo TOPSIS với
                    Closeness Coefficient =
                    <strong>
                        @Model.RecommendedSupplier.ClosenessCoefficient.ToString("0.000000")
                    </strong>
                </p>

            </div>


            <div class="decision-winner-badge">

                #1

            </div>

        </div>
    }


    <!-- =====================================================
         RANKING
         ===================================================== -->

    <div class="table-card decision-ranking-card">

        <div class="decision-card-header">

            <div>

                <div class="page-eyebrow">
                    TOPSIS RESULT
                </div>

                <h2 class="section-title">
                    Final ranking
                </h2>

            </div>

        </div>


        <div class="table-wrapper">

            <table class="data-table decision-ranking-table">

                <thead>

                    <tr>

                        <th>
                            Rank
                        </th>

                        <th>
                            Supplier
                        </th>

                        <th>
                            Distance to PIS
                        </th>

                        <th>
                            Distance to NIS
                        </th>

                        <th>
                            Closeness
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (
                        var item
                        in Model.Ranking
                            .OrderBy(
                                x =>
                                    x.RankNo))
                    {
                        <tr class="
                            @(item.RankNo == 1
                                ? "decision-winner-row"
                                : "")">

                            <td>

                                <span class="decision-rank">
                                    @item.RankNo
                                </span>

                            </td>


                            <td>

                                <strong>
                                    @item.SupplierCode
                                </strong>

                                <span class="table-muted">
                                    @item.SupplierName
                                </span>

                            </td>


                            <td>
                                @item.DistanceToPIS.ToString("0.000000")
                            </td>


                            <td>
                                @item.DistanceToNIS.ToString("0.000000")
                            </td>


                            <td>

                                <strong>
                                    @item.ClosenessCoefficient.ToString("0.000000")
                                </strong>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- =====================================================
         SENSITIVITY ANALYSIS
         ===================================================== -->
    @if (Model.SensitivityAnalysis != null && Model.SensitivityAnalysis.Scenarios.Any())
    {
        <div class="table-card decision-ranking-card" style="margin-top: 24px;">
            <div class="decision-card-header" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px;">
                <div>
                    <div class="page-eyebrow">
                        ACADEMIC ROBUSTNESS · PHÂN TÍCH ĐỘ NHẠY
                    </div>
                    <h2 class="section-title">
                        Tính ổn định của quyết định (Sensitivity Analysis ±10%, ±20%)
                    </h2>
                    <p class="table-muted" style="margin-top: 6px; font-size: 14px; max-width: 780px;">
                        @Model.SensitivityAnalysis.SummaryMessage
                    </p>
                </div>
                <div>
                    @if (Model.SensitivityAnalysis.IsOverallRobust)
                    {
                        <span class="badge" style="background: var(--sage-soft); color: var(--sage-dark); font-weight: 600; padding: 6px 12px; border-radius: 999px; font-size: 13px;">
                            ✓ Vững bền 100% (Không đổi #1)
                        </span>
                    }
                    else
                    {
                        <span class="badge" style="background: var(--danger-soft); color: var(--danger-dark); font-weight: 600; padding: 6px 12px; border-radius: 999px; font-size: 13px;">
                            ⚠️ Độ vững bền: @Model.SensitivityAnalysis.RobustnessPercentage%
                        </span>
                    }
                </div>
            </div>
        </div>
    }

    <!-- =====================================================
         APPROVAL
         ===================================================== -->

    @if (
            Model.HasApproval &&
            string.Equals(
                Model.ApprovalStatus,
                "Approved",
                StringComparison.OrdinalIgnoreCase))
    {
        <!-- =================================================
             FINAL APPROVED
             ================================================= -->

        <div class="decision-approval-card decision-approval-approved" id="final-approval">

            <div class="decision-approval-header">
                <div>
                    <div class="page-eyebrow">
                        FINAL APPROVAL
                    </div>

                    <h2 class="decision-approval-title">
                        <i class="bi bi-check-circle-fill"></i>
                        Approved
                    </h2>
                </div>

                <div class="decision-approved-badge">
                    <i class="bi bi-shield-check"></i>
                    Final Decision
                </div>
            </div>

            <div class="decision-approval-summary">

                <div class="decision-summary-supplier">
                    <span>Approved Supplier</span>
                    <div class="decision-supplier-highlight">
                        @if (!string.IsNullOrWhiteSpace(Model.SelectedSupplierCode))
                        {
                            <span class="decision-supplier-code-tag">@Model.SelectedSupplierCode</span>
                        }
                        <strong>@(Model.SelectedSupplierName ?? "—")</strong>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ApprovedByName))
                {
                    <div>
                        <span>Approved by</span>
                        <strong>@Model.ApprovedByName</strong>
                    </div>
                }

                @if (Model.ApprovalDate.HasValue)
                {
                    <div>
                        <span>Date</span>
                        <strong>@Model.ApprovalDate.Value.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                }

            </div>


            @if (!string.IsNullOrWhiteSpace(Model.ApprovalNotes))
            {
                <div class="decision-approval-notes-box">
                    <span class="decision-notes-label">
                        <i class="bi bi-sticky"></i> Notes:
                    </span>
                    <span class="decision-notes-content">
                        @Model.ApprovalNotes
                    </span>
                </div>
            }


            <div class="decision-approval-toolbar">
                <div class="decision-toolbar-secondary">
                    <a asp-controller="EvaluationBatch"
                       asp-action="Details"
                       asp-route-id="@Model.BatchId"
                       class="btn-outline">
                        Batch Details
                    </a>
                </div>

                <div class="decision-toolbar-primary">
                    @if (canReport)
                    {
                        <a asp-controller="Report"
                           asp-action="Index"
                           asp-route-batchId="@Model.BatchId"
                           class="btn-primary">
                            <i class="bi bi-file-earmark-bar-graph"></i>
                            Reports
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                </div>
            </div>

        </div>
    }
    else if (
        Model.HasApproval &&
        string.Equals(
            Model.ApprovalStatus,
            "Rejected",
            StringComparison.OrdinalIgnoreCase))
    {
        <!-- =================================================
             REJECTED
             ================================================= -->

        <div class="
            decision-approval-card
            decision-approval-rejected">

            <div class="page-eyebrow">
                DECISION REVIEW
            </div>

            <h2>
                Decision rejected
            </h2>

            <p>
                Kết quả lựa chọn hiện tại đã bị từ chối.
                Người quản lý có thể yêu cầu đánh giá lại
                trước khi đưa ra quyết định mới.
            </p>


            @if (
                !string.IsNullOrWhiteSpace(
                    Model.ApprovalNotes))
            {
                <p class="decision-approval-notes">

                    <strong>
                        Reason:
                    </strong>

                    @Model.ApprovalNotes

                </p>
            }


            @if (canApprove)
            {
                <form method="post"
                      action="@Url.Action(
                                                                  "Reevaluate",
                                                                  "DecisionResult",
                                                                  new
                                                                  {
                                                                      batchId = Model.BatchId
                                                                  })">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn-primary"
                            data-dss-confirm="Yêu cầu đánh giá lại sẽ vô hiệu hóa toàn bộ kết quả Evaluation, AHP và TOPSIS của đợt này. Bạn có chắc chắn muốn thực hiện?"
                            data-dss-title="Yêu cầu đánh giá lại"
                            data-dss-btn-text="Đánh giá lại">

                        Re-evaluate

                        <i class="bi bi-arrow-repeat"></i>

                    </button>

                </form>
            }

        </div>
    }
    else if (
        Model.HasApproval &&
        string.Equals(
            Model.ApprovalStatus,
            "PendingReevaluation",
            StringComparison.OrdinalIgnoreCase))
    {
        <!-- =================================================
             PENDING RE-EVALUATION
             ================================================= -->

        <div class="
            decision-approval-card
            decision-approval-pending">

            <div class="page-eyebrow">
                RE-EVALUATION
            </div>

            <h2>
                Re-evaluation requested
            </h2>

            <p>
                Batch đã được yêu cầu đánh giá lại.
                Dữ liệu Evaluation, AHP và TOPSIS cũ
                đã được vô hiệu hóa.
            </p>


            @if (
                User.IsInRole("Administrator") ||
                User.IsInRole("PurchasingStaff") ||
                User.IsInRole("Expert"))
            {
                <a asp-controller="Evaluation"
                   asp-action="Index"
                   asp-route-batchId="@Model.BatchId"
                   class="btn-primary">

                    Continue to Evaluation

                    <i class="bi bi-arrow-right"></i>

                </a>
            }

        </div>
    }
    else if (
        canApprove &&
        Model.RecommendedSupplier != null &&
        Model.BatchStatus != "Completed" &&
        Model.BatchStatus != "Cancelled")
    {
        <!-- =================================================
             SELECT FINAL SUPPLIER
             ================================================= -->

        <div class="decision-approval-card">

            <div class="page-eyebrow">
                APPROVAL
            </div>

            <h2>
                Select final supplier
            </h2>

            <p class="decision-approval-description">
                TOPSIS đề xuất
                <strong>
                    @Model.RecommendedSupplier.SupplierCode
                </strong>
                ở vị trí #1. Tuy nhiên, người quản lý
                có thể lựa chọn bất kỳ Supplier nào trong
                bảng xếp hạng trước khi phê duyệt.
            </p>


            <!-- =============================================
                 SECONDARY ACTION FORMS (HTML5 Form Association)
                 ============================================= -->
            <form method="post"
                  action="@Url.Action("Reject", "DecisionResult", new { batchId = Model.BatchId })"
                  id="rejectForm"
                  style="display:none;">
                @Html.AntiForgeryToken()
            </form>

            <form method="post"
                  action="@Url.Action("Reevaluate", "DecisionResult", new { batchId = Model.BatchId })"
                  id="reevaluateForm"
                  style="display:none;">
                @Html.AntiForgeryToken()
            </form>

            <!-- =============================================
                 SUPPLIER SELECTION & UNIFIED APPROVAL TOOLBAR
                 ============================================= -->
            <form method="post"
                  action="@Url.Action("Approve", "DecisionResult", new { batchId = Model.BatchId })"
                  id="approvalForm">

                @Html.AntiForgeryToken()

                <div class="decision-supplier-selection">
                    @foreach (var item in Model.Ranking.OrderBy(x => x.RankNo))
                    {
                        <label class="decision-supplier-option @(item.RankNo == 1 ? "recommended is-selected" : "")">
                            <input type="radio"
                                   name="supplierId"
                                   value="@item.SupplierId"
                                   @(item.RankNo == 1 ? "checked" : null)
                                   class="decision-supplier-radio" />

                            <span class="decision-supplier-radio-mark"></span>

                            <span class="decision-supplier-rank">
                                #@item.RankNo
                            </span>

                            <span class="decision-supplier-main">
                                <strong>@item.SupplierCode</strong>
                                <span>@item.SupplierName</span>
                            </span>

                            <span class="decision-supplier-score">
                                <small>TOPSIS CC</small>
                                <strong>@item.ClosenessCoefficient.ToString("0.000000")</strong>
                            </span>
                        </label>
                    }
                </div>

                <div class="decision-approval-notes-field" style="margin-top: 16px; margin-bottom: 20px;">
                    <label for="approvalNotesInput" class="form-label" style="font-weight: 600; display: flex; align-items: center; gap: 8px;">
                        <span>Lý do / Ghi chú phê duyệt</span>
                        <span id="rankWarningBadge" style="display: none; color: #dc2626; font-size: 12px; font-weight: normal; background: #fee2e2; padding: 2px 8px; border-radius: 4px;">
                            <i class="bi bi-exclamation-triangle"></i> Bắt buộc nhập lý do khi chọn nhà cung cấp không phải Hạng 1
                        </span>
                    </label>
                    <textarea id="approvalNotesInput"
                              name="notes"
                              class="form-control"
                              rows="2"
                              placeholder="Nhập lý do hoặc căn cứ phê duyệt (bắt buộc nếu không chọn Hạng 1)..."
                              style="width: 100%; border: 1px solid #cbd5e1; border-radius: 6px; padding: 8px 12px; font-family: inherit; font-size: 14px;"></textarea>
                </div>

                <div class="decision-approval-toolbar">
                    <div class="decision-toolbar-secondary">
                        <button type="submit"
                                form="rejectForm"
                                class="btn-outline btn-outline-danger"
                                data-dss-confirm="Bạn có chắc chắn muốn từ chối kết quả đánh giá hiện tại không?"
                                data-dss-title="Từ chối quyết định"
                                data-dss-btn-text="Từ chối">
                            <i class="bi bi-x-circle"></i>
                            Reject
                        </button>

                        <button type="submit"
                                form="reevaluateForm"
                                class="btn-outline btn-outline-warning"
                                data-dss-confirm="Yêu cầu đánh giá lại sẽ vô hiệu hóa toàn bộ kết quả Evaluation, AHP và TOPSIS của đợt này. Bạn có chắc chắn muốn thực hiện?"
                                data-dss-title="Yêu cầu đánh giá lại"
                                data-dss-btn-text="Đánh giá lại">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            Re-evaluate
                        </button>
                    </div>

                    <div class="decision-toolbar-primary">
                        <button type="submit"
                                class="btn-primary"
                                data-dss-confirm="Bạn có chắc chắn muốn phê duyệt nhà cung cấp này làm quyết định chính thức cho đợt đánh giá?"
                                data-dss-title="Xác nhận phê duyệt"
                                data-dss-btn-text="Phê duyệt">
                            Approve selected supplier
                            <i class="bi bi-check2"></i>
                        </button>
                    </div>
                </div>
            </form>

        </div>
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/decision-result.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var radios = document.querySelectorAll('input[name="supplierId"]');
            var notesBadge = document.getElementById('rankWarningBadge');
            var notesInput = document.getElementById('approvalNotesInput');
            var form = document.getElementById('approvalForm');

            function updateNotesRequirement() {
                var selectedRadio = document.querySelector('input[name="supplierId"]:checked');
                if (!selectedRadio) return;
                var label = selectedRadio.closest('.decision-supplier-option');
                var isRank1 = label && label.querySelector('.decision-supplier-rank') && label.querySelector('.decision-supplier-rank').textContent.includes('#1');
                if (isRank1) {
                    if (notesBadge) notesBadge.style.display = 'none';
                    if (notesInput) notesInput.removeAttribute('required');
                } else {
                    if (notesBadge) notesBadge.style.display = 'inline-flex';
                    if (notesInput) notesInput.setAttribute('required', 'required');
                }
            }

            radios.forEach(function (r) {
                r.addEventListener('change', updateNotesRequirement);
            });
            updateNotesRequirement();

            if (form) {
                form.addEventListener('submit', function (e) {
                    var selectedRadio = document.querySelector('input[name="supplierId"]:checked');
                    if (!selectedRadio) return;
                    var label = selectedRadio.closest('.decision-supplier-option');
                    var isRank1 = label && label.querySelector('.decision-supplier-rank') && label.querySelector('.decision-supplier-rank').textContent.includes('#1');
                    if (!isRank1 && (!notesInput || !notesInput.value.trim())) {
                        e.preventDefault();
                        alert('Bạn đang chọn nhà cung cấp không phải Hạng 1. Bắt buộc phải nhập lý do giải trình phê duyệt.');
                        if (notesInput) notesInput.focus();
                    }
                });
            }
        });
    </script>
}