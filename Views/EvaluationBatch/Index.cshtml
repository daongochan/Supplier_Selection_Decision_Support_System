@model SupplierSelectionDSS.Models.EvaluationBatchIndexViewModel

@{
    ViewData["Title"] = "Đợt đánh giá";

    var evalPercent = Model.TotalBatches > 0 
        ? (Model.EvaluatingBatches * 100.0 / Model.TotalBatches).ToString("0.#") 
        : "0";
    var compPercent = Model.TotalBatches > 0 
        ? (Model.CompletedBatches * 100.0 / Model.TotalBatches).ToString("0.#") 
        : "0";
    var draftPercent = Model.TotalBatches > 0 
        ? (Model.DraftBatches * 100.0 / Model.TotalBatches).ToString("0.#") 
        : "0";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/evaluation-batch.css" asp-append-version="true" />
}

<!-- =========================================================
     PAGE HEADER
     ========================================================= -->
<div class="page-header">
    <div>
        <h1 class="page-title">Đợt đánh giá</h1>
        <p class="page-description">
            Quản lý các đợt đánh giá nhà cung cấp theo từng nhóm hàng hóa, theo dõi tiến độ và quy trình ra quyết định.
        </p>
    </div>

    @if (User.IsInRole("Administrator") || User.IsInRole("PurchasingStaff"))
    {
        <a asp-action="Create" class="btn-primary">
            <i class="bi bi-plus-lg"></i>
            <span>Tạo đợt đánh giá</span>
        </a>
    }
</div>

<!-- =========================================================
     KPI SUMMARY GRID (100% GENUINE DATABASE METRICS)
     ========================================================= -->
<div class="batch-kpi-grid">
    <!-- Card 1: Tổng đợt đánh giá -->
    <div class="batch-kpi-card">
        <div class="batch-kpi-content">
            <span class="batch-kpi-label">Tổng đợt đánh giá</span>
            <span class="batch-kpi-value">@Model.TotalBatches.ToString("N0")</span>
            <div class="batch-kpi-meta">
                <span class="kpi-meta-pill pill-blue">
                    <i class="bi bi-collection"></i> Hồ sơ đánh giá DSS
                </span>
            </div>
        </div>
        <div class="batch-kpi-icon icon-blue" aria-hidden="true">
            <i class="bi bi-collection"></i>
        </div>
    </div>

    <!-- Card 2: Đang đánh giá -->
    <div class="batch-kpi-card">
        <div class="batch-kpi-content">
            <span class="batch-kpi-label">Đang đánh giá</span>
            <span class="batch-kpi-value">@Model.EvaluatingBatches.ToString("N0")</span>
            <div class="batch-kpi-meta">
                <span class="kpi-meta-pill pill-indigo">
                    <i class="bi bi-play-circle"></i> @evalPercent% tổng số
                </span>
            </div>
        </div>
        <div class="batch-kpi-icon icon-indigo" aria-hidden="true">
            <i class="bi bi-play-circle"></i>
        </div>
    </div>

    <!-- Card 3: Đã hoàn thành -->
    <div class="batch-kpi-card">
        <div class="batch-kpi-content">
            <span class="batch-kpi-label">Đã hoàn thành</span>
            <span class="batch-kpi-value">@Model.CompletedBatches.ToString("N0")</span>
            <div class="batch-kpi-meta">
                <span class="kpi-meta-pill pill-green">
                    <i class="bi bi-check2"></i> @compPercent% tổng số
                </span>
            </div>
        </div>
        <div class="batch-kpi-icon icon-green" aria-hidden="true">
            <i class="bi bi-check-circle"></i>
        </div>
    </div>

    <!-- Card 4: Bản nháp -->
    <div class="batch-kpi-card">
        <div class="batch-kpi-content">
            <span class="batch-kpi-label">Bản nháp / Khởi tạo</span>
            <span class="batch-kpi-value">@Model.DraftBatches.ToString("N0")</span>
            <div class="batch-kpi-meta">
                <span class="kpi-meta-pill pill-muted">
                    <i class="bi bi-pencil-square"></i> @draftPercent% tổng số
                </span>
            </div>
        </div>
        <div class="batch-kpi-icon icon-slate" aria-hidden="true">
            <i class="bi bi-pencil-square"></i>
        </div>
    </div>
</div>

<!-- =========================================================
     SEARCH & FILTER CARD
     ========================================================= -->
<div class="filter-card">
    <form asp-action="Index" method="get" class="batch-filter">
        <input type="hidden" name="page" value="1" />

        <!-- 1. Keyword Search -->
        <div class="filter-field">
            <label for="keyword">Tìm kiếm</label>
            <input id="keyword"
                   name="keyword"
                   value="@Model.Keyword"
                   class="form-control"
                   placeholder="Mã đợt, tên đợt đánh giá..." />
        </div>

        <!-- 2. Status Dropdown -->
        <div class="filter-field">
            <label for="status">Trạng thái</label>
            <select id="status" name="status" class="form-control">
                <option value="All" selected="@(string.IsNullOrEmpty(Model.Status) || Model.Status == "All")">
                    Tất cả trạng thái
                </option>
                <option value="Draft" selected="@(Model.Status == "Draft")">
                    Bản nháp
                </option>
                <option value="Evaluating" selected="@(Model.Status == "Evaluating")">
                    Đang đánh giá
                </option>
                <option value="Completed" selected="@(Model.Status == "Completed")">
                    Đã hoàn thành
                </option>
                <option value="Cancelled" selected="@(Model.Status == "Cancelled")">
                    Đã hủy
                </option>
            </select>
        </div>

        <!-- 3. Product Group Dropdown -->
        <div class="filter-field">
            <label for="groupId">Nhóm hàng</label>
            <select id="groupId" name="groupId" class="form-control">
                <option value="" selected="@(!Model.GroupId.HasValue)">
                    Tất cả nhóm hàng
                </option>
                @if (Model.Groups != null)
                {
                    @foreach (var g in Model.Groups)
                    {
                        <option value="@g.GroupId" selected="@(Model.GroupId == g.GroupId)">
                            @g.GroupName
                        </option>
                    }
                }
            </select>
        </div>

        <!-- 4. Filter Action Buttons (Same height 42px) -->
        <div class="filter-actions">
            <button type="submit" class="btn-primary" title="Tìm kiếm">
                Tìm kiếm
            </button>

            <a asp-action="Index" class="btn-outline" title="Đặt lại bộ lọc">
                Đặt lại
            </a>
        </div>
    </form>
</div>

<!-- =========================================================
     CENTRAL DATA TABLE CARD
     ========================================================= -->
<div class="table-card">
    @if (Model.Batches.Any())
    {
        <div class="data-table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 120px;">Mã đợt</th>
                        <th style="min-width: 240px;">Tên đợt đánh giá</th>
                        <th style="min-width: 180px;">Nhóm hàng</th>
                        <th style="min-width: 200px;">Quy mô đánh giá</th>
                        <th style="width: 130px;">Ngày tạo</th>
                        <th style="width: 150px;">Trạng thái</th>
                        <th style="width: 70px; text-align: center;">Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var batch in Model.Batches)
                    {
                        <tr>
                            <!-- Mã đợt -->
                            <td>
                                <span class="batch-code-badge">@batch.BatchCode</span>
                            </td>

                            <!-- Tên đợt đánh giá + Thời gian diễn ra -->
                            <td>
                                <div class="batch-name-cell">
                                    <a asp-action="Details" asp-route-id="@batch.BatchId" class="batch-name-link">
                                        @batch.BatchName
                                    </a>
                                    @if (batch.StartDate.HasValue || batch.EndDate.HasValue)
                                    {
                                        <span class="batch-period-tag">
                                            <i class="bi bi-calendar3"></i>
                                            @(batch.StartDate?.ToString("dd/MM/yyyy") ?? "...") – @(batch.EndDate?.ToString("dd/MM/yyyy") ?? "...")
                                        </span>
                                    }
                                </div>
                            </td>

                            <!-- Nhóm hàng -->
                            <td>
                                <div class="batch-group-cell">
                                    <span class="batch-group-pill" title="@batch.GroupName">
                                        <i class="bi bi-boxes"></i> @batch.GroupName
                                    </span>
                                </div>
                            </td>

                            <!-- Quy mô đánh giá (NCC + Tiêu chí) -->
                            <td>
                                <div class="batch-scope-cell">
                                    <span class="batch-scope-pill" title="Số nhà cung cấp tham gia">
                                        <i class="bi bi-building"></i> @batch.SupplierCount NCC
                                    </span>
                                    <span class="batch-scope-pill" title="Số tiêu chí đánh giá">
                                        <i class="bi bi-sliders"></i> @batch.CriteriaCount TC
                                    </span>
                                </div>
                            </td>

                            <!-- Ngày tạo -->
                            <td>
                                <span class="batch-date-cell">
                                    @batch.CreatedAt.ToString("dd/MM/yyyy")
                                </span>
                            </td>

                            <!-- Trạng thái -->
                            <td>
                                @switch (batch.Status)
                                {
                                    case "Evaluating":
                                        <span class="status-pill status-evaluating">Đang đánh giá</span>
                                        break;
                                    case "Completed":
                                        <span class="status-pill status-completed">Đã hoàn thành</span>
                                        break;
                                    case "Cancelled":
                                        <span class="status-pill status-cancelled">Đã hủy</span>
                                        break;
                                    default:
                                        <span class="status-pill status-draft">Bản nháp</span>
                                        break;
                                }
                            </td>

                            <!-- Thao tác dropdown [ ⋯ ] -->
                            <td style="text-align: center;">
                                <div class="batch-actions-dropdown">
                                    <button type="button"
                                            class="btn-action-dots"
                                            aria-label="Thao tác cho @batch.BatchName"
                                            title="Thao tác">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>

                                    <div class="batch-actions-menu">
                                        <a asp-action="Details"
                                           asp-route-id="@batch.BatchId"
                                           class="batch-action-item">
                                            <i class="bi bi-eye"></i>
                                            <span>Xem chi tiết</span>
                                        </a>

                                        @if (batch.Status == "Evaluating")
                                        {
                                            <a asp-controller="Evaluation"
                                               asp-action="Index"
                                               asp-route-batchId="@batch.BatchId"
                                               class="batch-action-item">
                                                <i class="bi bi-pencil-square"></i>
                                                <span>Chấm điểm đánh giá</span>
                                            </a>

                                            <a asp-controller="TOPSIS"
                                               asp-action="Index"
                                               asp-route-batchId="@batch.BatchId"
                                               class="batch-action-item">
                                                <i class="bi bi-calculator"></i>
                                                <span>Tính toán TOPSIS</span>
                                            </a>
                                        }

                                        @if (batch.Status == "Completed")
                                        {
                                            <a asp-controller="DecisionResult"
                                               asp-action="Index"
                                               asp-route-batchId="@batch.BatchId"
                                               class="batch-action-item">
                                                <i class="bi bi-award"></i>
                                                <span>Kết quả phê duyệt</span>
                                            </a>
                                        }

                                        @if (batch.Status == "Draft" && (User.IsInRole("Administrator") || User.IsInRole("PurchasingStaff")))
                                        {
                                            <div class="batch-action-divider"></div>
                                            <form asp-action="Start"
                                                  asp-route-id="@batch.BatchId"
                                                  method="post"
                                                  class="m-0 p-0">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="batch-action-item text-primary"
                                                        data-dss-confirm="Bạn có chắc chắn muốn bắt đầu tiến trình đánh giá cho đợt '@batch.BatchName'?"
                                                        data-dss-title="Bắt đầu đánh giá"
                                                        data-dss-btn-text="Bắt đầu ngay">
                                                    <i class="bi bi-play-circle"></i>
                                                    <span>Bắt đầu đánh giá</span>
                                                </button>
                                            </form>
                                        }

                                        @if ((batch.Status == "Draft" || batch.Status == "Evaluating") && (User.IsInRole("Administrator") || User.IsInRole("Manager")))
                                        {
                                            <div class="batch-action-divider"></div>
                                            <form asp-action="Cancel"
                                                  asp-route-id="@batch.BatchId"
                                                  method="post"
                                                  class="m-0 p-0">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="batch-action-item text-danger"
                                                        data-dss-confirm="Bạn có chắc chắn muốn hủy đợt đánh giá '@batch.BatchName'? Thao tác này không thể hoàn tác."
                                                        data-dss-title="Xác nhận hủy đợt"
                                                        data-dss-btn-text="Hủy đợt đánh giá">
                                                    <i class="bi bi-x-circle"></i>
                                                    <span>Hủy đợt đánh giá</span>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="Model" />
    }
    else
    {
        <div class="empty-state">
            <div style="font-size: 40px; color: var(--muted); margin-bottom: 12px;">
                <i class="bi bi-search"></i>
            </div>
            <h3>Không tìm thấy đợt đánh giá nào</h3>
            <p>
                Không có đợt đánh giá nào phù hợp với điều kiện tìm kiếm hoặc bộ lọc hiện tại.
                Vui lòng thử lại với từ khóa hoặc bộ lọc khác.
            </p>
            <div style="display: flex; gap: 10px; justify-content: center; margin-top: 16px;">
                <a asp-action="Index" class="btn-outline">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Xóa bộ lọc</span>
                </a>
                @if (User.IsInRole("Administrator") || User.IsInRole("PurchasingStaff"))
                {
                    <a asp-action="Create" class="btn-primary">
                        <i class="bi bi-plus-lg"></i>
                        <span>Tạo đợt đánh giá mới</span>
                    </a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Dropdown menu toggle
            document.addEventListener("click", function (e) {
                const trigger = e.target.closest(".btn-action-dots");
                const openDropdown = document.querySelector(".batch-actions-dropdown.is-open");

                if (trigger) {
                    e.stopPropagation();
                    const parent = trigger.closest(".batch-actions-dropdown");
                    if (openDropdown && openDropdown !== parent) {
                        openDropdown.classList.remove("is-open");
                    }
                    if (parent) {
                        parent.classList.toggle("is-open");
                    }
                } else if (openDropdown && !e.target.closest(".batch-actions-menu")) {
                    openDropdown.classList.remove("is-open");
                }
            });

            // Close on Escape key
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") {
                    const openDropdown = document.querySelector(".batch-actions-dropdown.is-open");
                    if (openDropdown) {
                        openDropdown.classList.remove("is-open");
                    }
                }
            });
        });
    </script>
}