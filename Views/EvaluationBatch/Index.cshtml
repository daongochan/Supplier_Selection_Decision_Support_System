@model SupplierSelectionDSS.Models.EvaluationBatchIndexViewModel

@{
    ViewData["Title"] = "Evaluation Batches";

    var evalPercent = Model.TotalBatches > 0 
        ? (Model.EvaluatingBatches * 100.0 / Model.TotalBatches).ToString("0.#") 
        : "0";
    var compPercent = Model.TotalBatches > 0 
        ? (Model.CompletedBatches * 100.0 / Model.TotalBatches).ToString("0.#") 
        : "0";
    var draftPercent = Model.TotalBatches > 0 
        ? (Model.DraftBatches * 100.0 / Model.TotalBatches).ToString("0.#") 
        : "0";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/evaluation-batch.css" asp-append-version="true" />
}

<!-- =========================================================
     PAGE HEADER
     ========================================================= -->
<div class="page-header">
    <div>
        <h1 class="page-title">Evaluation Batches</h1>
        <p class="page-description">
            Manage supplier evaluation batches by product group, track progress, and review decision workflows.
        </p>
    </div>

    @if (User.IsInRole("Administrator") || User.IsInRole("PurchasingStaff"))
    {
        <a asp-action="Create" class="btn-primary">
            <i class="bi bi-plus-lg"></i>
            <span>Create Evaluation Batch</span>
        </a>
    }
</div>

<!-- =========================================================
     KPI SUMMARY GRID (100% GENUINE DATABASE METRICS)
     ========================================================= -->
<div class="batch-kpi-grid">
    <!-- Card 1: Total Batches -->
    <div class="batch-kpi-card">
        <div class="batch-kpi-content">
            <span class="batch-kpi-label">Total Batches</span>
            <span class="batch-kpi-value">@Model.TotalBatches.ToString("N0")</span>
            <div class="batch-kpi-meta">
                <span class="kpi-meta-pill pill-blue">
                    <i class="bi bi-collection"></i> DSS evaluation batches
                </span>
            </div>
        </div>
        <div class="batch-kpi-icon icon-blue" aria-hidden="true">
            <i class="bi bi-collection"></i>
        </div>
    </div>

    <!-- Card 2: Evaluating -->
    <div class="batch-kpi-card">
        <div class="batch-kpi-content">
            <span class="batch-kpi-label">Evaluating</span>
            <span class="batch-kpi-value">@Model.EvaluatingBatches.ToString("N0")</span>
            <div class="batch-kpi-meta">
                <span class="kpi-meta-pill pill-indigo">
                    <i class="bi bi-play-circle"></i> @evalPercent% of total
                </span>
            </div>
        </div>
        <div class="batch-kpi-icon icon-indigo" aria-hidden="true">
            <i class="bi bi-play-circle"></i>
        </div>
    </div>

    <!-- Card 3: Completed -->
    <div class="batch-kpi-card">
        <div class="batch-kpi-content">
            <span class="batch-kpi-label">Completed</span>
            <span class="batch-kpi-value">@Model.CompletedBatches.ToString("N0")</span>
            <div class="batch-kpi-meta">
                <span class="kpi-meta-pill pill-green">
                    <i class="bi bi-check2"></i> @compPercent% of total
                </span>
            </div>
        </div>
        <div class="batch-kpi-icon icon-green" aria-hidden="true">
            <i class="bi bi-check2-circle"></i>
        </div>
    </div>

    <!-- Card 4: Draft -->
    <div class="batch-kpi-card">
        <div class="batch-kpi-content">
            <span class="batch-kpi-label">Draft</span>
            <span class="batch-kpi-value">@Model.DraftBatches.ToString("N0")</span>
            <div class="batch-kpi-meta">
                <span class="kpi-meta-pill pill-amber">
                    <i class="bi bi-pencil-square"></i> @draftPercent% of total
                </span>
            </div>
        </div>
        <div class="batch-kpi-icon icon-amber" aria-hidden="true">
            <i class="bi bi-pencil-square"></i>
        </div>
    </div>
</div>

<!-- =========================================================
     SEARCH & FILTER CARD
     ========================================================= -->
<div class="filter-card">
    <form asp-action="Index" method="get" class="batch-filter">
        <input type="hidden" name="page" value="1" />

        <!-- 1. Keyword Search -->
        <div class="filter-field">
            <label for="keyword">Search</label>
            <input id="keyword"
                   name="keyword"
                   value="@Model.Keyword"
                   class="form-control"
                   placeholder="Batch code, batch name..." />
        </div>

        <!-- 2. Status Dropdown -->
        <div class="filter-field">
            <label for="status">Status</label>
            <select id="status" name="status" class="form-control">
                <option value="All" selected="@(string.IsNullOrEmpty(Model.Status) || Model.Status == "All")">
                    All Statuses
                </option>
                <option value="Draft" selected="@(Model.Status == "Draft")">
                    Draft
                </option>
                <option value="Evaluating" selected="@(Model.Status == "Evaluating")">
                    Evaluating
                </option>
                <option value="Completed" selected="@(Model.Status == "Completed")">
                    Completed
                </option>
                <option value="Cancelled" selected="@(Model.Status == "Cancelled")">
                    Cancelled
                </option>
            </select>
        </div>

        <!-- 3. Group Dropdown -->
        <div class="filter-field">
            <label for="groupId">Product Group</label>
            <select id="groupId" name="groupId" class="form-control">
                <option value="">All Product Groups</option>
                @if (ViewBag.Groups is List<SupplierSelectionDSS.Data.Entities.ProductGroup> groups)
                {
                    foreach (var g in groups)
                    {
                        <option value="@g.GroupId" selected="@(Model.GroupId == g.GroupId)">
                            @g.GroupName
                        </option>
                    }
                }
            </select>
        </div>

        <!-- 4. Filter Action Buttons (Same height 42px) -->
        <div class="filter-actions">
            <button type="submit" class="btn-primary" title="Search">
                Search
            </button>

            <a asp-action="Index" class="btn-outline" title="Reset filters">
                Reset
            </a>
        </div>
    </form>
</div>

<!-- =========================================================
     CENTRAL DATA TABLE CARD
     ========================================================= -->
<div class="table-card">
    @if (Model.Batches.Any())
    {
        <div class="data-table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 120px;">Batch Code</th>
                        <th style="min-width: 240px;">Batch Name</th>
                        <th style="min-width: 180px;">Product Group</th>
                        <th style="min-width: 200px;">Evaluation Scope</th>
                        <th style="width: 130px;">Created Date</th>
                        <th style="width: 150px;">Status</th>
                        <th style="width: 70px; text-align: center;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var batch in Model.Batches)
                    {
                        <tr>
                            <!-- Batch Code -->
                            <td>
                                <span class="batch-code-badge">@batch.BatchCode</span>
                            </td>

                            <!-- Batch Name + Date Range -->
                            <td>
                                <div class="batch-name-cell">
                                    <a asp-action="Details" asp-route-id="@batch.BatchId" class="batch-name-link">
                                        @batch.BatchName
                                    </a>
                                    @if (batch.StartDate.HasValue || batch.EndDate.HasValue)
                                    {
                                        <span class="batch-period-tag">
                                            <i class="bi bi-calendar3"></i>
                                            @(batch.StartDate?.ToString("dd/MM/yyyy") ?? "...") – @(batch.EndDate?.ToString("dd/MM/yyyy") ?? "...")
                                        </span>
                                    }
                                </div>
                            </td>

                            <!-- Product Group -->
                            <td>
                                <div class="batch-group-cell">
                                    <span class="batch-group-pill" title="@batch.GroupName">
                                        <i class="bi bi-boxes"></i> @batch.GroupName
                                    </span>
                                </div>
                            </td>

                            <!-- Evaluation Scope (Suppliers + Criteria) -->
                            <td>
                                <div class="batch-scope-cell">
                                    <span class="batch-scope-pill" title="Participating suppliers">
                                        <i class="bi bi-building"></i> @batch.SupplierCount Suppliers
                                    </span>
                                    <span class="batch-scope-pill" title="Evaluation criteria">
                                        <i class="bi bi-sliders"></i> @batch.CriteriaCount Criteria
                                    </span>
                                </div>
                            </td>

                            <!-- Created Date -->
                            <td>
                                <span class="batch-date-cell">
                                    @batch.CreatedAt.ToString("dd/MM/yyyy")
                                </span>
                            </td>

                            <!-- Status -->
                            <td>
                                @switch (batch.Status)
                                {
                                    case "Evaluating":
                                        <span class="status-pill status-evaluating">Evaluating</span>
                                        break;
                                    case "Completed":
                                        <span class="status-pill status-completed">Completed</span>
                                        break;
                                    case "Cancelled":
                                        <span class="status-pill status-cancelled">Cancelled</span>
                                        break;
                                    default:
                                        <span class="status-pill status-draft">Draft</span>
                                        break;
                                }
                            </td>

                            <!-- Actions dropdown [ ⋯ ] -->
                            <td style="text-align: center;">
                                <div class="batch-actions-dropdown">
                                    <button type="button"
                                            class="btn-action-dots"
                                            aria-label="Actions for @batch.BatchName"
                                            title="Actions">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>

                                    <div class="batch-actions-menu">
                                        <a asp-action="Details"
                                           asp-route-id="@batch.BatchId"
                                           class="batch-action-item">
                                            <i class="bi bi-eye"></i>
                                            <span>View Details</span>
                                        </a>

                                        @if (batch.Status == "Evaluating")
                                        {
                                            <a asp-controller="Evaluation"
                                               asp-action="Index"
                                               asp-route-batchId="@batch.BatchId"
                                               class="batch-action-item">
                                                <i class="bi bi-pencil-square"></i>
                                                <span>Enter Scores</span>
                                            </a>

                                            <a asp-controller="TOPSIS"
                                               asp-action="Index"
                                               asp-route-batchId="@batch.BatchId"
                                               class="batch-action-item">
                                                <i class="bi bi-calculator"></i>
                                                <span>TOPSIS Calculation</span>
                                            </a>
                                        }

                                        @if (batch.Status == "Completed")
                                        {
                                            <a asp-controller="DecisionResult"
                                               asp-action="Index"
                                               asp-route-batchId="@batch.BatchId"
                                               class="batch-action-item">
                                                <i class="bi bi-award"></i>
                                                <span>Decision & Approval</span>
                                            </a>
                                        }

                                        @if (batch.Status == "Draft" && (User.IsInRole("Administrator") || User.IsInRole("PurchasingStaff")))
                                        {
                                            <div class="batch-action-divider"></div>
                                            <form asp-action="Start"
                                                  asp-route-id="@batch.BatchId"
                                                  method="post"
                                                  class="m-0 p-0">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="batch-action-item text-primary"
                                                        data-dss-confirm="Are you sure you want to start the evaluation process for batch '@batch.BatchName'?"
                                                        data-dss-title="Start Evaluation"
                                                        data-dss-btn-text="Start Now">
                                                    <i class="bi bi-play-circle"></i>
                                                    <span>Start Evaluation</span>
                                                </button>
                                            </form>
                                        }

                                        @if ((batch.Status == "Draft" || batch.Status == "Evaluating") && (User.IsInRole("Administrator") || User.IsInRole("Manager")))
                                        {
                                            <div class="batch-action-divider"></div>
                                            <form asp-action="Cancel"
                                                  asp-route-id="@batch.BatchId"
                                                  method="post"
                                                  class="m-0 p-0">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="batch-action-item text-danger"
                                                        data-dss-confirm="Are you sure you want to cancel evaluation batch '@batch.BatchName'? This action cannot be undone."
                                                        data-dss-title="Confirm Batch Cancellation"
                                                        data-dss-btn-text="Cancel Batch">
                                                    <i class="bi bi-x-circle"></i>
                                                    <span>Cancel Batch</span>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="Model" />
    }
    else
    {
        <div class="empty-state">
            <div style="font-size: 40px; color: var(--muted); margin-bottom: 12px;">
                <i class="bi bi-search"></i>
            </div>
            <h3>No evaluation batches found</h3>
            <p>
                No evaluation batches match the current search criteria or filters.
                Please try again with different keywords or filters.
            </p>
            <div style="display: flex; gap: 10px; justify-content: center; margin-top: 16px;">
                <a asp-action="Index" class="btn-outline">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Reset Filters</span>
                </a>
                @if (User.IsInRole("Administrator") || User.IsInRole("PurchasingStaff"))
                {
                    <a asp-action="Create" class="btn-primary">
                        <i class="bi bi-plus-lg"></i>
                        <span>Create Evaluation Batch</span>
                    </a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Dropdown menu toggle
            document.addEventListener("click", function (e) {
                const trigger = e.target.closest(".btn-action-dots");
                const openDropdown = document.querySelector(".batch-actions-dropdown.is-open");

                if (trigger) {
                    e.stopPropagation();
                    const parent = trigger.closest(".batch-actions-dropdown");
                    if (openDropdown && openDropdown !== parent) {
                        openDropdown.classList.remove("is-open");
                    }
                    if (parent) {
                        parent.classList.toggle("is-open");
                    }
                } else if (openDropdown && !e.target.closest(".batch-actions-menu")) {
                    openDropdown.classList.remove("is-open");
                }
            });

            // Close on Escape key
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") {
                    const openDropdown = document.querySelector(".batch-actions-dropdown.is-open");
                    if (openDropdown) {
                        openDropdown.classList.remove("is-open");
                    }
                }
            });
        });
    </script>
}
