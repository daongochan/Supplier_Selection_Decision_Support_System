@model SupplierSelectionDSS.Models.SupplierIndexViewModel

@{
    ViewData["Title"] = "Suppliers";

    var activePercent = Model.TotalSuppliers > 0 
        ? (Model.ActiveSuppliers * 100.0 / Model.TotalSuppliers).ToString("0.#") 
        : "0";
    var inactivePercent = Model.TotalSuppliers > 0 
        ? (Model.InactiveSuppliers * 100.0 / Model.TotalSuppliers).ToString("0.#") 
        : "0";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/supplier.css" asp-append-version="true" />
}

<!-- =========================================================
     PAGE HEADER
     ========================================================= -->
<div class="page-header">
    <div>
        <h1 class="page-title">Suppliers</h1>
        <p class="page-description">
            Manage supplier profiles, contact details, and evaluation statuses in the decision system.
        </p>
    </div>

    <a asp-action="Create" class="btn-primary">
        <i class="bi bi-plus-lg"></i>
        <span>New Supplier</span>
    </a>
</div>

<!-- =========================================================
     KPI SUMMARY GRID (100% GENUINE DATABASE METRICS)
     ========================================================= -->
<div class="supplier-kpi-grid">
    <!-- Card 1: Total Suppliers -->
    <div class="supplier-kpi-card">
        <div class="supplier-kpi-content">
            <span class="supplier-kpi-label">Total Suppliers</span>
            <span class="supplier-kpi-value">@Model.TotalSuppliers.ToString("N0")</span>
            <div class="supplier-kpi-meta">
                <span class="kpi-meta-pill pill-blue">
                    <i class="bi bi-database"></i> System records
                </span>
            </div>
        </div>
        <div class="supplier-kpi-icon icon-blue" aria-hidden="true">
            <i class="bi bi-building"></i>
        </div>
    </div>

    <!-- Card 2: Active Suppliers -->
    <div class="supplier-kpi-card">
        <div class="supplier-kpi-content">
            <span class="supplier-kpi-label">Active</span>
            <span class="supplier-kpi-value">@Model.ActiveSuppliers.ToString("N0")</span>
            <div class="supplier-kpi-meta">
                <span class="kpi-meta-pill pill-green">
                    <i class="bi bi-check2"></i> @activePercent% of total
                </span>
            </div>
        </div>
        <div class="supplier-kpi-icon icon-green" aria-hidden="true">
            <i class="bi bi-check-circle"></i>
        </div>
    </div>

    <!-- Card 3: Inactive Suppliers -->
    <div class="supplier-kpi-card">
        <div class="supplier-kpi-content">
            <span class="supplier-kpi-label">Inactive</span>
            <span class="supplier-kpi-value">@Model.InactiveSuppliers.ToString("N0")</span>
            <div class="supplier-kpi-meta">
                <span class="kpi-meta-pill pill-muted">
                    <i class="bi bi-pause"></i> @inactivePercent% of total
                </span>
            </div>
        </div>
        <div class="supplier-kpi-icon icon-slate" aria-hidden="true">
            <i class="bi bi-slash-circle"></i>
        </div>
    </div>

    <!-- Card 4: Product Groups -->
    <div class="supplier-kpi-card">
        <div class="supplier-kpi-content">
            <span class="supplier-kpi-label">Product Groups</span>
            <span class="supplier-kpi-value">@Model.TotalGroups.ToString("N0")</span>
            <div class="supplier-kpi-meta">
                <span class="kpi-meta-pill pill-indigo">
                    <i class="bi bi-tags"></i> Active categories
                </span>
            </div>
        </div>
        <div class="supplier-kpi-icon icon-indigo" aria-hidden="true">
            <i class="bi bi-boxes"></i>
        </div>
    </div>
</div>

<!-- =========================================================
     SEARCH & FILTER CARD
     ========================================================= -->
<div class="filter-card">
    <form asp-action="Index" method="get" class="supplier-filter">
        <input type="hidden" name="page" value="1" />

        <!-- 1. Keyword Search -->
        <div class="filter-field">
            <label for="keyword">Search</label>
            <input id="keyword"
                   name="keyword"
                   value="@Model.Keyword"
                   class="form-control"
                   placeholder="Code, name, contact, phone, email..." />
        </div>

        <!-- 2. Status Dropdown -->
        <div class="filter-field">
            <label for="status">Status</label>
            <select id="status" name="status" class="form-control">
                <option value="All" selected="@(string.IsNullOrEmpty(Model.Status) || Model.Status == "All")">
                    All Statuses
                </option>
                <option value="Active" selected="@(Model.Status == "Active")">
                    Active
                </option>
                <option value="Inactive" selected="@(Model.Status == "Inactive")">
                    Inactive
                </option>
            </select>
        </div>

        <!-- 3. Product Group Dropdown -->
        <div class="filter-field">
            <label for="groupId">Product Group</label>
            <select id="groupId" name="groupId" class="form-control">
                <option value="" selected="@(!Model.GroupId.HasValue)">
                    All Product Groups
                </option>
                @if (Model.Groups != null)
                {
                    @foreach (var g in Model.Groups)
                    {
                        <option value="@g.GroupId" selected="@(Model.GroupId == g.GroupId)">
                            @g.GroupName
                        </option>
                    }
                }
            </select>
        </div>

        <!-- 4. Filter Action Buttons (Same height 42px) -->
        <div class="filter-actions">
            <button type="submit" class="btn-primary" title="Search">
                Search
            </button>

            <a asp-action="Index" class="btn-outline" title="Reset filter">
                Reset
            </a>
        </div>
    </form>
</div>

<!-- =========================================================
     CENTRAL DATA TABLE CARD
     ========================================================= -->
<div class="table-card">
    @if (Model.Suppliers.Any())
    {
        <div class="data-table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 110px;">Code</th>
                        <th style="min-width: 220px;">Supplier Name</th>
                        <th style="min-width: 180px;">Product Groups</th>
                        <th style="min-width: 190px;">Contact</th>
                        <th style="min-width: 200px;">Address</th>
                        <th style="width: 140px;">Status</th>
                        <th style="width: 70px; text-align: center;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var supplier in Model.Suppliers)
                    {
                        <tr>
                            <!-- Supplier Code -->
                            <td>
                                <span class="supplier-code-badge">@supplier.SupplierCode</span>
                            </td>

                            <!-- Supplier Name + Business Field -->
                            <td>
                                <div class="supplier-name-cell">
                                    <a asp-action="Edit" asp-route-id="@supplier.SupplierId" class="supplier-name-link">
                                        @supplier.SupplierName
                                    </a>
                                    @if (!string.IsNullOrWhiteSpace(supplier.BusinessField))
                                    {
                                        <span class="supplier-field-tag">
                                            <i class="bi bi-briefcase"></i> @supplier.BusinessField
                                        </span>
                                    }
                                </div>
                            </td>

                            <!-- Product Groups -->
                            <td>
                                <div class="supplier-groups-cell">
                                    @if (supplier.Groups != null && supplier.Groups.Any())
                                    {
                                        @foreach (var g in supplier.Groups.Take(2))
                                        {
                                            <span class="supplier-group-pill" title="@g.GroupName">
                                                @g.GroupName
                                            </span>
                                        }
                                        @if (supplier.Groups.Count > 2)
                                        {
                                            <span class="supplier-group-pill-more" title="@string.Join(", ", supplier.Groups.Skip(2).Select(x => x.GroupName))">
                                                +@(supplier.Groups.Count - 2)
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </div>
                            </td>

                            <!-- Contact Person + Phone + Email -->
                            <td>
                                <div class="supplier-contact-cell">
                                    @if (!string.IsNullOrWhiteSpace(supplier.ContactPerson))
                                    {
                                        <span class="supplier-contact-person">
                                            <i class="bi bi-person"></i> @supplier.ContactPerson
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(supplier.Phone))
                                    {
                                        <span class="supplier-contact-info">
                                            <i class="bi bi-telephone"></i>
                                            <a href="tel:@supplier.Phone">@supplier.Phone</a>
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(supplier.Email))
                                    {
                                        <span class="supplier-contact-info">
                                            <i class="bi bi-envelope"></i>
                                            <a href="mailto:@supplier.Email">@supplier.Email</a>
                                        </span>
                                    }
                                    @if (string.IsNullOrWhiteSpace(supplier.ContactPerson) && string.IsNullOrWhiteSpace(supplier.Phone) && string.IsNullOrWhiteSpace(supplier.Email))
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </div>
                            </td>

                            <!-- Address -->
                            <td>
                                @if (!string.IsNullOrWhiteSpace(supplier.Address))
                                {
                                    <span class="supplier-address-cell" title="@supplier.Address">
                                        @supplier.Address
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <!-- Status -->
                            <td>
                                @if (supplier.Status == "Active")
                                {
                                    <span class="status-pill status-active">Active</span>
                                }
                                else
                                {
                                    <span class="status-pill status-inactive">Inactive</span>
                                }
                            </td>

                            <!-- Actions dropdown [ ⋯ ] -->
                            <td style="text-align: center;">
                                <div class="supplier-actions-dropdown">
                                    <button type="button"
                                            class="btn-action-dots"
                                            aria-label="Actions for @supplier.SupplierName"
                                            aria-haspopup="true"
                                            aria-expanded="false"
                                            title="Actions">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>

                                    <div class="supplier-actions-menu">
                                        <a asp-action="Edit"
                                           asp-route-id="@supplier.SupplierId"
                                           class="supplier-action-item">
                                            <i class="bi bi-pencil"></i>
                                            <span>Edit</span>
                                        </a>

                                        <a asp-controller="ProductGroup"
                                           asp-action="Index"
                                           class="supplier-action-item">
                                            <i class="bi bi-diagram-3"></i>
                                            <span>Manage Product Groups</span>
                                        </a>

                                        <div class="supplier-action-divider"></div>

                                        <form asp-action="ToggleStatus"
                                              method="post"
                                              class="m-0 p-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden"
                                                   name="id"
                                                   value="@supplier.SupplierId" />
                                            <button type="submit"
                                                    class="supplier-action-item @(supplier.Status == "Active" ? "text-danger" : "text-success")"
                                                    data-dss-confirm="@(supplier.Status == "Active" ? $"Are you sure you want to deactivate supplier \"{supplier.SupplierName}\"?" : $"Are you sure you want to reactivate supplier \"{supplier.SupplierName}\"?")"
                                                    data-dss-title="@(supplier.Status == "Active" ? "Confirm Deactivation" : "Confirm Activation")"
                                                    data-dss-btn-text="@(supplier.Status == "Active" ? "Deactivate" : "Activate")">
                                                @if (supplier.Status == "Active")
                                                {
                                                    <i class="bi bi-slash-circle"></i>
                                                    <span>Deactivate</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-check-circle"></i>
                                                    <span>Activate</span>
                                                }
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="Model" />
    }
    else
    {
        <div class="empty-state">
            <div style="font-size: 40px; color: var(--muted); margin-bottom: 12px;">
                <i class="bi bi-search"></i>
            </div>
            <h3>No suppliers found</h3>
            <p>
                No suppliers match the current search criteria.
                Please try again with different keywords or filters.
            </p>
            <div style="display: flex; gap: 10px; justify-content: center; margin-top: 16px;">
                <a asp-action="Index" class="btn-outline">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Reset filter</span>
                </a>
                <a asp-action="Create" class="btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    <span>Add New Supplier</span>
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Dropdown menu toggle
            document.addEventListener("click", function (e) {
                const trigger = e.target.closest(".btn-action-dots");
                const openDropdown = document.querySelector(".supplier-actions-dropdown.is-open");

                if (trigger) {
                    e.stopPropagation();
                    const parent = trigger.closest(".supplier-actions-dropdown");
                    if (openDropdown && openDropdown !== parent) {
                        openDropdown.classList.remove("is-open");
                        const prevBtn = openDropdown.querySelector(".btn-action-dots");
                        if (prevBtn) prevBtn.setAttribute("aria-expanded", "false");
                    }
                    if (parent) {
                        const isOpen = parent.classList.toggle("is-open");
                        trigger.setAttribute("aria-expanded", isOpen ? "true" : "false");
                    }
                } else if (openDropdown && !e.target.closest(".supplier-actions-menu")) {
                    openDropdown.classList.remove("is-open");
                    const prevBtn = openDropdown.querySelector(".btn-action-dots");
                    if (prevBtn) prevBtn.setAttribute("aria-expanded", "false");
                }
            });

            // Close on Escape key and return focus
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") {
                    const openDropdown = document.querySelector(".supplier-actions-dropdown.is-open");
                    if (openDropdown) {
                        openDropdown.classList.remove("is-open");
                        const trigger = openDropdown.querySelector(".btn-action-dots");
                        if (trigger) {
                            trigger.setAttribute("aria-expanded", "false");
                            trigger.focus();
                        }
                    }
                }
            });
        });
    </script>
}
