@model SupplierSelectionDSS.Models.SupplierFormViewModel

@{
    ViewData["Title"] = "Add Supplier";
}

<div class="page-header">

    <div>

        <div class="page-eyebrow">
            SUPPLIERS
        </div>

        <h1 class="page-title">
            Add supplier
        </h1>

        <p class="page-description">
            Thêm một nhà cung cấp mới vào hệ thống.
        </p>

    </div>

</div>


<div class="form-card">

    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()


        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>


        <div class="form-grid">


            <!-- Identity -->

            <div class="form-group">

                <label asp-for="SupplierCode">
                    Supplier code
                </label>

                <input asp-for="SupplierCode"
                       class="form-control"
                       maxlength="20"
                       autocomplete="off" />

                <span asp-validation-for="SupplierCode"
                      class="text-danger">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="SupplierName">
                    Supplier name
                </label>

                <input asp-for="SupplierName"
                       class="form-control"
                       maxlength="200" />

                <span asp-validation-for="SupplierName"
                      class="text-danger">
                </span>

            </div>


            <!-- Contact -->

            <div class="form-group">

                <label asp-for="ContactPerson">
                    Contact person
                </label>

                <input asp-for="ContactPerson"
                       class="form-control"
                       maxlength="100" />

            </div>


            <div class="form-group">

                <label asp-for="Email">
                    Email
                </label>

                <input asp-for="Email"
                       class="form-control"
                       type="email"
                       maxlength="100" />

            </div>


            <div class="form-group">

                <label asp-for="Phone">
                    Phone
                </label>

                <input asp-for="Phone"
                       class="form-control"
                       maxlength="20" />

            </div>


            <div class="form-group">

                <label asp-for="TaxCode">
                    Tax code
                </label>

                <input asp-for="TaxCode"
                       class="form-control"
                       maxlength="20" />

            </div>


            <!-- Business -->

            <div class="form-group">

                <label asp-for="BusinessField">
                    Business field
                </label>

                <input asp-for="BusinessField"
                       class="form-control"
                       maxlength="150" />

            </div>


            <div class="form-group">

                <label asp-for="Website">
                    Website
                </label>

                <input asp-for="Website"
                       class="form-control"
                       maxlength="255" />

            </div>


            <div class="form-group form-group-full">

                <label asp-for="Address">
                    Address
                </label>

                <input asp-for="Address"
                       class="form-control"
                       maxlength="255" />

            </div>


            <div class="form-group form-group-full">

                <label asp-for="PaymentTerms">
                    Payment terms
                </label>

                <textarea asp-for="PaymentTerms"
                          class="form-control"
                          maxlength="255"></textarea>

            </div>

        </div>


        <div class="form-actions">

            <a asp-action="Index"
               class="btn-outline">

                Cancel

            </a>


            <button type="submit"
                    class="btn-primary">

                Save supplier

            </button>

        </div>

    </form>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}