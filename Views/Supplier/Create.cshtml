@model SupplierSelectionDSS.Models.SupplierFormViewModel

@{
    ViewData["Title"] = "Thêm nhà cung cấp";
}

<div class="page-header">

    <div>

        <h1 class="page-title">
            Thêm nhà cung cấp
        </h1>

        <p class="page-description">
            Thêm một nhà cung cấp mới vào hệ thống.
        </p>

    </div>

</div>


<div class="form-card">

    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()


        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>


        <div class="form-grid">

            <!-- 1. Enterprise Identity -->
            <div class="form-section">
                <div class="form-section-title">Thông tin doanh nghiệp</div>
                <div class="form-section-desc">Mã định danh và tên pháp lý của nhà cung cấp</div>
            </div>

            <div class="form-group">
                <label asp-for="SupplierCode" class="required-field">
                    Mã nhà cung cấp
                </label>
                <input asp-for="SupplierCode"
                       class="form-control"
                       maxlength="20"
                       placeholder="VD: NCC-001"
                       autocomplete="off" />
                <span asp-validation-for="SupplierCode" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SupplierName" class="required-field">
                    Tên nhà cung cấp
                </label>
                <input asp-for="SupplierName"
                       class="form-control"
                       maxlength="200"
                       placeholder="Tên đầy đủ theo đăng ký kinh doanh" />
                <span asp-validation-for="SupplierName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TaxCode">
                    Mã số thuế
                </label>
                <input asp-for="TaxCode"
                       class="form-control"
                       maxlength="20"
                       placeholder="Mã số thuế doanh nghiệp" />
            </div>

            <div class="form-group">
                <label asp-for="BusinessField">
                    Lĩnh vực kinh doanh
                </label>
                <input asp-for="BusinessField"
                       class="form-control"
                       maxlength="150"
                       placeholder="VD: Thiết bị văn phòng, Linh kiện điện tử" />
            </div>

            <!-- 2. Contact Information -->
            <div class="form-section">
                <div class="form-section-title">Thông tin liên hệ</div>
                <div class="form-section-desc">Đầu mối làm việc và các kênh liên lạc trực tiếp</div>
            </div>

            <div class="form-group">
                <label asp-for="ContactPerson">
                    Người liên hệ
                </label>
                <input asp-for="ContactPerson"
                       class="form-control"
                       maxlength="100"
                       placeholder="Họ và tên người đại diện" />
            </div>

            <div class="form-group">
                <label asp-for="Email">
                    Email
                </label>
                <input asp-for="Email"
                       class="form-control"
                       type="email"
                       maxlength="100"
                       placeholder="email@domain.com" />
            </div>

            <div class="form-group">
                <label asp-for="Phone">
                    Số điện thoại
                </label>
                <input asp-for="Phone"
                       class="form-control"
                       maxlength="20"
                       placeholder="Số điện thoại liên hệ" />
            </div>

            <div class="form-group">
                <label asp-for="Website">
                    Website
                </label>
                <input asp-for="Website"
                       class="form-control"
                       maxlength="255"
                       placeholder="https://company.com" />
            </div>

            <!-- 3. Address & Terms -->
            <div class="form-section">
                <div class="form-section-title">Địa chỉ & Điều khoản</div>
                <div class="form-section-desc">Địa chỉ trụ sở và các điều khoản giao dịch mặc định</div>
            </div>

            <div class="form-group form-group-full">
                <label asp-for="Address">
                    Địa chỉ
                </label>
                <input asp-for="Address"
                       class="form-control"
                       maxlength="255"
                       placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố" />
            </div>

            <div class="form-group form-group-full">
                <label asp-for="PaymentTerms">
                    Điều khoản thanh toán
                </label>
                <textarea asp-for="PaymentTerms"
                          class="form-control"
                          maxlength="255"
                          placeholder="VD: Thanh toán 30 ngày sau khi nhận hàng, chuyển khoản ngân hàng..."></textarea>
            </div>

        </div>


        <div class="form-actions">

            <a asp-action="Index"
               class="btn-outline">
                Hủy bỏ
            </a>

            <button type="submit"
                    class="btn-primary">
                Lưu nhà cung cấp
            </button>

        </div>

    </form>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}