@model SupplierSelectionDSS.Models.SupplierFormViewModel

@{
    ViewData["Title"] = "Add Supplier";
}

<div class="page-header">

    <div>

        <h1 class="page-title">
            Add Supplier
        </h1>

        <p class="page-description">
            Add a new supplier to the system.
        </p>

    </div>

</div>


<div class="form-card">

    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()


        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>


        <div class="form-grid">

            <!-- 1. Enterprise Identity -->
            <div class="form-section">
                <div class="form-section-title">Enterprise Information</div>
                <div class="form-section-desc">Identification code and legal name of the supplier</div>
            </div>

            <div class="form-group">
                <label asp-for="SupplierCode" class="required-field">
                    Supplier Code
                </label>
                <input asp-for="SupplierCode"
                       class="form-control"
                       maxlength="20"
                       placeholder="e.g. SUP-001"
                       autocomplete="off" />
                <span asp-validation-for="SupplierCode" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SupplierName" class="required-field">
                    Supplier Name
                </label>
                <input asp-for="SupplierName"
                       class="form-control"
                       maxlength="200"
                       placeholder="Full legal business name" />
                <span asp-validation-for="SupplierName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TaxCode">
                    Tax Code
                </label>
                <input asp-for="TaxCode"
                       class="form-control"
                       maxlength="20"
                       placeholder="Enterprise tax identification number" />
            </div>

            <div class="form-group">
                <label asp-for="BusinessField">
                    Business Field
                </label>
                <input asp-for="BusinessField"
                       class="form-control"
                       maxlength="150"
                       placeholder="e.g. Office Equipment, Electronic Components" />
            </div>

            <!-- 2. Contact Information -->
            <div class="form-section">
                <div class="form-section-title">Contact Information</div>
                <div class="form-section-desc">Key contact person and direct communication channels</div>
            </div>

            <div class="form-group">
                <label asp-for="ContactPerson">
                    Contact Person
                </label>
                <input asp-for="ContactPerson"
                       class="form-control"
                       maxlength="100"
                       placeholder="Full name of representative" />
            </div>

            <div class="form-group">
                <label asp-for="Email">
                    Email
                </label>
                <input asp-for="Email"
                       class="form-control"
                       type="email"
                       maxlength="100"
                       placeholder="email@domain.com" />
            </div>

            <div class="form-group">
                <label asp-for="Phone">
                    Phone
                </label>
                <input asp-for="Phone"
                       class="form-control"
                       maxlength="20"
                       placeholder="Direct contact phone number" />
            </div>

            <div class="form-group">
                <label asp-for="Website">
                    Website
                </label>
                <input asp-for="Website"
                       class="form-control"
                       maxlength="255"
                       placeholder="https://company.com" />
            </div>

            <!-- 3. Address & Terms -->
            <div class="form-section">
                <div class="form-section-title">Address & Terms</div>
                <div class="form-section-desc">Headquarters address and default transaction terms</div>
            </div>

            <div class="form-group form-group-full">
                <label asp-for="Address">
                    Address
                </label>
                <input asp-for="Address"
                       class="form-control"
                       maxlength="255"
                       placeholder="Headquarters address or representative office" />
            </div>

            <div class="form-group form-group-full">
                <label asp-for="PaymentTerms">
                    Payment Terms
                </label>
                <textarea asp-for="PaymentTerms"
                          class="form-control"
                          maxlength="255"
                          placeholder="e.g. Net 30 days, bank transfer, LC, T/T..."></textarea>
            </div>

        </div>


        <div class="form-actions">

            <a asp-action="Index"
               class="btn-outline">
                Cancel
            </a>

            <button type="submit"
                    class="btn-primary">
                Save Supplier
            </button>

        </div>

    </form>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
