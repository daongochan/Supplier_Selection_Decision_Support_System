<!-- =========================================================
     ENTERPRISE DSS CONFIRMATION MODAL
     Unified split-screen layout with visual asset: duck.jpg
     ========================================================= -->
<div id="dssConfirmModal"
     class="dss-modal-overlay"
     aria-hidden="true"
     role="dialog"
     aria-modal="true"
     aria-labelledby="dssConfirmTitle"
     aria-describedby="dssConfirmMessage"
     style="display:none;"
     onclick="if (event.target === this) DSS.handleBackdropClick();">

    <div class="dss-modal-box">

        <!-- LEFT VISUAL PANEL (duck.jpg) -->
        <div class="dss-modal-visual" aria-hidden="true">
            <img src="/images/duck.jpg"
                 alt=""
                 class="dss-modal-img"
                 aria-hidden="true" />
        </div>

        <!-- RIGHT CONFIRMATION CONTENT -->
        <div class="dss-modal-content">

            <!-- Close Button [X] positioned absolute top-right -->
            <button type="button"
                    class="dss-modal-close"
                    id="dssConfirmCloseBtn"
                    onclick="DSS.closeConfirmModal()"
                    aria-label="Đóng">
                <i class="bi bi-x-lg"></i>
            </button>

            <!-- Top Row: Icon Badge + Title (Ample space, no orphan line wrap) -->
            <div class="dss-modal-top-row">
                <div class="dss-modal-header-group">
                    <span class="dss-modal-icon-badge badge-primary" id="dssConfirmIconBadge">
                        <i id="dssConfirmIcon" class="bi bi-question-circle-fill"></i>
                    </span>
                    <h3 id="dssConfirmTitle" class="dss-modal-title">Xác nhận thao tác</h3>
                </div>
            </div>

            <!-- Body Message -->
            <div class="dss-modal-body-wrap">
                <p id="dssConfirmMessage" class="dss-modal-message">Bạn có chắc chắn muốn thực hiện thao tác này?</p>

                <!-- Optional Consequence Callout (Only visible when text is provided) -->
                <div id="dssConfirmConsequence" class="dss-modal-consequence">
                    <i class="bi bi-exclamation-circle-fill me-1"></i>
                    <span id="dssConfirmConsequenceText"></span>
                </div>

                <!-- Optional Input for Reason / Notes -->
                <div id="dssConfirmInputGroup" class="dss-modal-input-group" style="display:none;">
                    <label id="dssConfirmInputLabel" class="form-label" for="dssConfirmInput">Ghi chú / Lý do:</label>
                    <textarea id="dssConfirmInput" class="form-textarea" rows="3" placeholder="Nhập lý do hoặc ý kiến..."></textarea>
                </div>
            </div>

            <!-- Action Buttons Footer -->
            <div class="dss-modal-actions">
                <button type="button"
                        id="dssConfirmCancelBtn"
                        class="dss-modal-btn dss-modal-btn-cancel"
                        onclick="DSS.closeConfirmModal()">Hủy bỏ</button>
                <button type="button"
                        id="dssConfirmSubmitBtn"
                        class="dss-modal-btn dss-modal-btn-confirm btn-primary">
                    <span id="dssConfirmSubmitSpinner" class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true" style="display:none;"></span>
                    <span id="dssConfirmSubmitText">Xác nhận</span>
                </button>
            </div>

        </div>

    </div>

</div>

<style>
