<!-- =========================================================
     ENTERPRISE DSS CONFIRMATION MODAL
     ========================================================= -->
<div id="dssConfirmModal"
     class="dss-modal-overlay"
     aria-hidden="true"
     role="dialog"
     aria-modal="true"
     style="display:none;"
     onclick="if (event.target === this) DSS.closeConfirmModal();">

    <div class="dss-modal-box">

        <div class="dss-modal-header">
            <div class="dss-modal-title-group">
                <i id="dssConfirmIcon" class="bi bi-question-circle-fill text-warning"></i>
                <h3 id="dssConfirmTitle" class="dss-modal-title">Xác nhận thao tác</h3>
            </div>
            <button type="button" class="dss-modal-close" onclick="DSS.closeConfirmModal()" aria-label="Close">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="dss-modal-body">
            <p id="dssConfirmMessage" class="dss-modal-text">Bạn có chắc chắn muốn thực hiện thao tác này?</p>
            <div id="dssConfirmInputGroup" style="display:none; margin-top: 14px;">
                <label id="dssConfirmInputLabel" class="form-label" for="dssConfirmInput">Ghi chú / Lý do:</label>
                <textarea id="dssConfirmInput" class="form-textarea" rows="3" placeholder="Nhập lý do hoặc ý kiến..."></textarea>
            </div>
        </div>

        <div class="dss-modal-footer">
            <button type="button" class="btn-outline" onclick="DSS.closeConfirmModal()">Hủy bỏ</button>
            <button type="button" id="dssConfirmSubmitBtn" class="btn-primary">Xác nhận</button>
        </div>

    </div>

</div>

