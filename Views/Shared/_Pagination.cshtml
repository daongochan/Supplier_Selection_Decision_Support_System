@{
    var currentPage = (int)(ViewData["PageNumber"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 0);
    var totalCount = (int)(ViewData["TotalCount"] ?? 0);
    var startItem = (int)(ViewData["StartItemNumber"] ?? 0);
    var endItem = (int)(ViewData["EndItemNumber"] ?? 0);
    var hasPrev = (bool)(ViewData["HasPreviousPage"] ?? false);
    var hasNext = (bool)(ViewData["HasNextPage"] ?? false);
    var keyword = ViewData["Keyword"] as string;
    var status = ViewData["Status"] as string;
    var pageSize = (int)(ViewData["PageSize"] ?? 10);
    var action = (ViewData["Action"] as string) ?? "Index";

    const int pageWindow = 2;
    var startPage = Math.Max(1, currentPage - pageWindow);
    var endPage = totalPages == 0 ? 1 : Math.Min(totalPages, currentPage + pageWindow);
}

@if (totalCount > 0)
{
    <div class="pagination-footer">

        <div class="pagination-summary">
            Showing
            <strong>@startItem</strong>
            –
            <strong>@endItem</strong>
            of
            <strong>@totalCount</strong>
        </div>

        @if (totalPages > 1)
        {
            <nav class="pagination" aria-label="Pagination">

                @if (hasPrev)
                {
                    <a asp-action="@action"
                       asp-route-keyword="@keyword"
                       asp-route-status="@status"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-pageSize="@pageSize"
                       class="page-link"
                       aria-label="Previous">‹</a>
                }
                else
                {
                    <span class="page-link page-link-disabled">‹</span>
                }

                @if (startPage > 1)
                {
                    <a asp-action="@action"
                       asp-route-keyword="@keyword"
                       asp-route-status="@status"
                       asp-route-page="1"
                       asp-route-pageSize="@pageSize"
                       class="page-link">1</a>

                    @if (startPage > 2)
                    {
                        <span class="page-ellipsis">…</span>
                    }
                }

                @for (var p = startPage; p <= endPage; p++)
                {
                    if (p == currentPage)
                    {
                        <span class="page-link page-link-active">@p</span>
                    }
                    else
                    {
                        <a asp-action="@action"
                           asp-route-keyword="@keyword"
                           asp-route-status="@status"
                           asp-route-page="@p"
                           asp-route-pageSize="@pageSize"
                           class="page-link">@p</a>
                    }
                }

                @if (totalPages > 0 && endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <span class="page-ellipsis">…</span>
                    }

                    <a asp-action="@action"
                       asp-route-keyword="@keyword"
                       asp-route-status="@status"
                       asp-route-page="@totalPages"
                       asp-route-pageSize="@pageSize"
                       class="page-link">@totalPages</a>
                }

                @if (hasNext)
                {
                    <a asp-action="@action"
                       asp-route-keyword="@keyword"
                       asp-route-status="@status"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-pageSize="@pageSize"
                       class="page-link"
                       aria-label="Next">›</a>
                }
                else
                {
                    <span class="page-link page-link-disabled">›</span>
                }

            </nav>
        }

    </div>
}