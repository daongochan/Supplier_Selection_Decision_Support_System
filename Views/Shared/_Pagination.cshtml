@model SupplierSelectionDSS.Models.IPagedResult

@{
    var currentPage = Model?.PageNumber ?? (int)(ViewData["PageNumber"] ?? 1);
    var totalPages = Model?.TotalPages ?? (int)(ViewData["TotalPages"] ?? 0);
    var totalCount = Model?.TotalCount ?? (int)(ViewData["TotalCount"] ?? 0);
    var startItem = Model?.StartItemNumber ?? (int)(ViewData["StartItemNumber"] ?? 0);
    var endItem = Model?.EndItemNumber ?? (int)(ViewData["EndItemNumber"] ?? 0);
    var hasPrev = Model?.HasPreviousPage ?? (bool)(ViewData["HasPreviousPage"] ?? false);
    var hasNext = Model?.HasNextPage ?? (bool)(ViewData["HasNextPage"] ?? false);
    var pageSize = Model?.PageSize ?? (int)(ViewData["PageSize"] ?? 10);
    var action = (ViewData["Action"] as string) ?? ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

    const int pageWindow = 2;
    var startPage = Math.Max(1, currentPage - pageWindow);
    var endPage = totalPages == 0 ? 1 : Math.Min(totalPages, currentPage + pageWindow);

    var baseRouteData = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    foreach (var q in Context.Request.Query)
    {
        if (!string.Equals(q.Key, "page", StringComparison.OrdinalIgnoreCase))
        {
            baseRouteData[q.Key] = q.Value.ToString();
        }
    }

    Dictionary<string, string> GetRouteData(int p)
    {
        var dict = new Dictionary<string, string>(baseRouteData, StringComparer.OrdinalIgnoreCase);
        dict["page"] = p.ToString();
        dict["pageSize"] = pageSize.ToString();
        return dict;
    }
}

@if (totalCount > 0)
{
    <div class="pagination-footer">

        <div class="pagination-summary">
            Hiển thị
            <strong>@startItem</strong>
            –
            <strong>@endItem</strong>
            trên tổng số
            <strong>@totalCount</strong>
            kết quả
        </div>

        @if (totalPages > 1)
        {
            <nav class="pagination" aria-label="Pagination">

                @if (hasPrev)
                {
                    <a asp-action="@action"
                       asp-all-route-data="GetRouteData(currentPage - 1)"
                       class="page-link"
                       aria-label="Previous">‹</a>
                }
                else
                {
                    <span class="page-link page-link-disabled">‹</span>
                }

                @if (startPage > 1)
                {
                    <a asp-action="@action"
                       asp-all-route-data="GetRouteData(1)"
                       class="page-link">1</a>

                    @if (startPage > 2)
                    {
                        <span class="page-ellipsis">…</span>
                    }
                }

                @for (var p = startPage; p <= endPage; p++)
                {
                    if (p == currentPage)
                    {
                        <span class="page-link page-link-active">@p</span>
                    }
                    else
                    {
                        <a asp-action="@action"
                           asp-all-route-data="GetRouteData(p)"
                           class="page-link">@p</a>
                    }
                }

                @if (totalPages > 0 && endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <span class="page-ellipsis">…</span>
                    }

                    <a asp-action="@action"
                       asp-all-route-data="GetRouteData(totalPages)"
                       class="page-link">@totalPages</a>
                }

                @if (hasNext)
                {
                    <a asp-action="@action"
                       asp-all-route-data="GetRouteData(currentPage + 1)"
                       class="page-link"
                       aria-label="Next">›</a>
                }
                else
                {
                    <span class="page-link page-link-disabled">›</span>
                }

            </nav>
        }

    </div>
}