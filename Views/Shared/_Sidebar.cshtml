@using System.Security.Claims
@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();
}

<aside id="appSidebar" class="app-sidebar" aria-label="Main Navigation">

    <!-- =====================================================
         BRAND & COLLAPSE TOGGLE
         ===================================================== -->

    <div class="sidebar-brand-header">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="sidebar-brand-link"
           title="Supplier Selection DSS - Dashboard"
           aria-label="Supplier Selection DSS Dashboard">

            <img src="~/images/app-logo.png"
                 asp-append-version="true"
                 alt="Supplier Selection DSS"
                 class="sidebar-logo" />

            <div class="sidebar-brand-text">
                <span class="sidebar-brand-title">SUPPLIER SELECTION</span>
                <span class="sidebar-brand-subtitle">Decision Support System</span>
            </div>

        </a>

        <button type="button"
                id="desktopSidebarToggle"
                class="sidebar-collapse-btn"
                aria-controls="appSidebar"
                aria-expanded="true"
                aria-label="Collapse sidebar"
                title="Collapse sidebar">
            <i class="bi bi-chevron-left" id="desktopSidebarToggleIcon" aria-hidden="true"></i>
        </button>

    </div>


    <!-- =====================================================
         NAVIGATION
         ===================================================== -->

    <nav class="sidebar-nav">

        <!-- Dashboard -->
        <a asp-controller="Dashboard"
           asp-action="Index"
           class="sidebar-link @(currentController == "Dashboard" ? "active" : "")"
           title="Dashboard"
           aria-label="Dashboard">
            <i class="bi bi-grid-1x2" aria-hidden="true"></i>
            <span class="sidebar-link-text">Dashboard</span>
        </a>

        <!-- Suppliers -->
        @if (User.IsInRole("Administrator") ||
             User.IsInRole("PurchasingStaff"))
        {
            <a asp-controller="Supplier"
               asp-action="Index"
               class="sidebar-link @(currentController == "Supplier" ? "active" : "")"
               title="Suppliers"
               aria-label="Suppliers">
                <i class="bi bi-building" aria-hidden="true"></i>
                <span class="sidebar-link-text">Suppliers</span>
            </a>
        }

        <!-- Product Groups -->
        @if (User.IsInRole("Administrator") ||
             User.IsInRole("PurchasingStaff"))
        {
            <a asp-controller="ProductGroup"
               asp-action="Index"
               class="sidebar-link @(currentController == "ProductGroup" ? "active" : "")"
               title="Product Groups"
               aria-label="Product Groups">
                <i class="bi bi-box-seam" aria-hidden="true"></i>
                <span class="sidebar-link-text">Product Groups</span>
            </a>
        }

        <!-- Criteria -->
        @if (User.IsInRole("Administrator") ||
             User.IsInRole("PurchasingStaff"))
        {
            <a asp-controller="Criteria"
               asp-action="Index"
               class="sidebar-link @(currentController == "Criteria" ? "active" : "")"
               title="Evaluation Criteria"
               aria-label="Evaluation Criteria">
                <i class="bi bi-sliders" aria-hidden="true"></i>
                <span class="sidebar-link-text">Evaluation Criteria</span>
            </a>
        }

        <!-- Evaluation Batches -->
        @if (User.IsInRole("Administrator") ||
             User.IsInRole("PurchasingStaff") ||
             User.IsInRole("Expert") ||
             User.IsInRole("Manager"))
        {
            <a asp-controller="EvaluationBatch"
               asp-action="Index"
               class="sidebar-link @(currentController == "EvaluationBatch" ||
                                     currentController == "Evaluation" ||
                                     currentController == "AHP" ||
                                     currentController == "TOPSIS" ||
                                     currentController == "DecisionResult" ||
                                     currentController == "Report"
                                     ? "active" : "")"
               title="Evaluation Batches"
               aria-label="Evaluation Batches">
                <i class="bi bi-collection" aria-hidden="true"></i>
                <span class="sidebar-link-text">Evaluation Batches</span>
            </a>
        }

        <!-- Users -->
        @if (User.IsInRole("Administrator"))
        {
            <a asp-controller="User"
               asp-action="Index"
               class="sidebar-link @(currentController == "User" ? "active" : "")"
               title="Users"
               aria-label="Users">
                <i class="bi bi-people" aria-hidden="true"></i>
                <span class="sidebar-link-text">Users</span>
            </a>
        }

        <!-- Audit Logs -->
        @if (User.IsInRole("Administrator"))
        {
            <a asp-controller="AuditLog"
               asp-action="Index"
               class="sidebar-link @(currentController == "AuditLog" ? "active" : "")"
               title="Audit Logs"
               aria-label="Audit Logs">
                <i class="bi bi-clock-history" aria-hidden="true"></i>
                <span class="sidebar-link-text">Audit Logs</span>
            </a>
        }

    </nav>


    <!-- =====================================================
         USER ACCOUNT & LOGOUT (SIDEBAR FOOTER)
         ===================================================== -->

    @if (User.Identity?.IsAuthenticated == true)
    {
        var fullName =
            User.FindFirst(ClaimTypes.GivenName)?.Value
            ?? User.Identity?.Name
            ?? "User";

        var role =
            User.FindFirst(ClaimTypes.Role)?.Value
            ?? "User";

        <div class="sidebar-footer">

            <div class="sidebar-user-card" title="@fullName (@role)">
                <div class="user-avatar" title="@fullName" aria-hidden="true">
                    @fullName.FirstOrDefault()
                </div>
                <div class="sidebar-user-info">
                    <span class="sidebar-user-name" title="@fullName">
                        @fullName
                    </span>
                    <span class="sidebar-user-role">
                        @role
                    </span>
                </div>
            </div>

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="sidebar-logout-form">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn-logout sidebar-btn-logout"
                        title="Sign Out"
                        aria-label="Sign Out">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                    <span class="sidebar-logout-text">Sign Out</span>
                </button>
            </form>

        </div>
    }

</aside>
