@{
    ViewData["Title"] = "Access Denied";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/access-denied.css" asp-append-version="true" />
}

<div class="access-denied-scene">
    <div class="access-denied-content">
        <!-- Duck with Shield & Lock Illustration -->
        <div class="access-denied-illustration-wrap">
            <picture>
                <source srcset="~/images/access-denied-duck.webp" type="image/webp" />
                <img src="~/images/access-denied-duck.png"
                     alt="Access Denied"
                     class="access-denied-duck-img" />
            </picture>
        </div>

        <!-- Headline -->
        <h1 class="access-denied-heading">Access Denied</h1>

        <!-- Friendly Subtitle -->
        <p class="access-denied-message">
            You do not have permission to access this page. Please contact<br />
            your system administrator to request appropriate permissions.
        </p>

        <!-- Primary Pill Action Button -->
        <a asp-controller="Dashboard" asp-action="Index" class="btn-access-home">
            <i class="bi bi-arrow-left"></i>
            <span>Back to Dashboard</span>
        </a>
    </div>
</div>