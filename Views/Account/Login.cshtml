@model SupplierSelectionDSS.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-page">

    <!-- =========================================================
         TOP-LEFT LOGO & HEADER AREA (Reference Images 1 & 3)
         ========================================================= -->
    <header class="login-header">

        <a asp-controller="Account"
           asp-action="Login"
           class="login-brand"
           title="Supplier Selection DSS">

            <img src="~/images/app-logo.png"
                 alt="Supplier Selection DSS Logo"
                 class="login-brand-logo" />

            <div class="login-brand-info">
                <span class="login-brand-title">Supplier Selection DSS</span>
                <span class="login-brand-subtitle">Decision Support System</span>
            </div>

        </a>

        <div class="login-header-right">
            <span class="login-header-badge">
                <i class="bi bi-shield-check"></i>
                <span>Enterprise Portal</span>
            </span>
        </div>

    </header>


    <!-- =========================================================
         CENTERED FROSTED-GLASS LOGIN CARD (Reference Image 1)
         ========================================================= -->
    <div class="login-container">

        <div class="login-card">

            <!-- Card Header -->
            <div class="login-card-header">
                <h1 class="login-card-title">Login</h1>
                <p class="login-card-subtitle">
                    Enter your credentials to access the workspace
                </p>
            </div>

            <!-- Server validation error alert -->
            @{
                var modelErrors = ViewData.ModelState
                    .SelectMany(x => x.Value?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
                    .Select(e => e.ErrorMessage)
                    .Where(m => !string.IsNullOrWhiteSpace(m))
                    .ToList();
            }

            @if (modelErrors.Any())
            {
                <div class="login-alert" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <ul>
                        @foreach (var err in modelErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }

            <!-- Form -->
            <form asp-action="Login"
                  method="post"
                  id="loginForm"
                  autocomplete="on"
                  novalidate>

                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <!-- Username -->
                <div class="login-field">
                    <label class="login-label" for="Username">
                        Username
                    </label>
                    <div class="login-input-wrap">
                        <i class="bi bi-person login-input-icon"></i>
                        <input asp-for="Username"
                               id="Username"
                               class="login-input @(ViewData.ModelState["Username"]?.Errors.Count > 0 ? "is-invalid" : "")"
                               type="text"
                               placeholder="Enter your username"
                               autocomplete="username"
                               spellcheck="false" />
                    </div>
                    <span asp-validation-for="Username" class="login-field-error"></span>
                </div>

                <!-- Password -->
                <div class="login-field">
                    <label class="login-label" for="Password">
                        Password
                    </label>
                    <div class="login-input-wrap">
                        <i class="bi bi-lock login-input-icon"></i>
                        <input asp-for="Password"
                               id="Password"
                               class="login-input @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "is-invalid" : "")"
                               type="password"
                               placeholder="Enter your password"
                               autocomplete="current-password" />
                        <button type="button"
                                class="login-pw-toggle"
                                id="pwToggle"
                                aria-label="Show/hide password"
                                aria-pressed="false"
                                title="Show/hide password">
                            <i class="bi bi-eye" id="pwToggleIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="login-field-error"></span>
                </div>

                <!-- Remember Me & Forgot Password Row -->
                <div class="login-options-row">
                    <label class="login-remember-label" for="RememberMe">
                        <input asp-for="RememberMe" id="RememberMe" type="checkbox" />
                        <span>Remember me</span>
                    </label>

                    <a href="#helpModal"
                       class="login-forgot-link"
                       id="btnForgotPw"
                       role="button">
                        Forgot Password?
                    </a>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="login-submit-btn" id="loginBtn">
                    <span id="loginBtnText">Login</span>
                </button>

                <!-- Help / Account footnote -->
                <div class="login-card-footer">
                    <span>Need system access?</span>
                    <a href="#helpModal" id="btnRequestAccess">Contact Administrator</a>
                </div>

            </form>

        </div>

    </div>


    <!-- =========================================================
         PAGE FOOTER
         ========================================================= -->
    <footer class="login-page-footer">
        <p>&copy; @DateTime.UtcNow.Year Supplier Selection DSS &middot; Multi-Criteria Decision Framework</p>
    </footer>

</div>


<!-- =========================================================
     ACCESSIBLE MODAL: HELP & CREDENTIAL ASSISTANCE
     ========================================================= -->
<div id="helpModal" class="login-modal-backdrop" role="dialog" aria-modal="true" aria-hidden="true">

    <div class="login-modal">

        <div class="login-modal-header">
            <div class="login-modal-title">
                <i class="bi bi-shield-lock-fill"></i>
                <span id="helpModalTitle">Account &amp; Password Assistance</span>
            </div>
            <button type="button" class="login-modal-close" id="btnHelpModalClose" aria-label="Close modal">
                &times;
            </button>
        </div>

        <div class="login-modal-body" id="helpModalBody">
            <p style="margin: 0 0 10px;">
                For security and compliance reasons, all user accounts, role permissions, and credential resets in Supplier Selection DSS are managed centrally by administrators.
            </p>
            <p style="margin: 0;">
                Please contact your designated system administrator or IT Helpdesk with your corporate username to request account creation or a password reset.
            </p>
        </div>

        <div class="login-modal-footer">
            <button type="button" class="btn-primary" id="btnHelpModalOk">
                Got it
            </button>
        </div>

    </div>

</div>


@section Scripts {

    <script>
        (function () {
            "use strict";

            // ── Show / Hide Password ──────────────────────────
            var pwInput  = document.getElementById('Password');
            var pwToggle = document.getElementById('pwToggle');
            var pwIcon   = document.getElementById('pwToggleIcon');

            if (pwToggle && pwInput) {
                pwToggle.addEventListener('click', function () {
                    var isPassword = pwInput.type === 'password';
                    pwInput.type   = isPassword ? 'text' : 'password';
                    pwIcon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
                    pwToggle.setAttribute('aria-pressed', isPassword ? 'true' : 'false');
                    pwInput.focus();
                });
            }

            // ── Loading State on Submit ───────────────────────
            var form     = document.getElementById('loginForm');
            var loginBtn = document.getElementById('loginBtn');
            var btnText  = document.getElementById('loginBtnText');

            if (form && loginBtn) {
                form.addEventListener('submit', function () {
                    // Brief delay so native HTML5 validation runs first
                    setTimeout(function () {
                        if (form.checkValidity && form.checkValidity()) {
                            loginBtn.disabled = true;
                            loginBtn.innerHTML =
                                '<span class="login-spinner" aria-hidden="true"></span>' +
                                '<span>Signing in...</span>';
                        }
                    }, 10);
                });
            }

            // ── Help Modal (Forgot Password / Request Access) ──
            var helpModal     = document.getElementById('helpModal');
            var btnForgotPw   = document.getElementById('btnForgotPw');
            var btnReqAccess  = document.getElementById('btnRequestAccess');
            var btnModalClose = document.getElementById('btnHelpModalClose');
            var btnModalOk    = document.getElementById('btnHelpModalOk');
            var modalTitle    = document.getElementById('helpModalTitle');

            function openHelpModal(titleText) {
                if (modalTitle && titleText) {
                    modalTitle.textContent = titleText;
                }
                if (helpModal) {
                    helpModal.classList.add('is-open');
                    helpModal.setAttribute('aria-hidden', 'false');
                    if (btnModalOk) btnModalOk.focus();
                }
            }

            function closeHelpModal() {
                if (helpModal) {
                    helpModal.classList.remove('is-open');
                    helpModal.setAttribute('aria-hidden', 'true');
                }
            }

            if (btnForgotPw) {
                btnForgotPw.addEventListener('click', function (e) {
                    e.preventDefault();
                    openHelpModal('Password Reset Assistance');
                });
            }

            if (btnReqAccess) {
                btnReqAccess.addEventListener('click', function (e) {
                    e.preventDefault();
                    openHelpModal('System Access Request');
                });
            }

            if (btnModalClose) btnModalClose.addEventListener('click', closeHelpModal);
            if (btnModalOk)    btnModalOk.addEventListener('click', closeHelpModal);

            if (helpModal) {
                helpModal.addEventListener('click', function (e) {
                    if (e.target === helpModal) {
                        closeHelpModal();
                    }
                });
            }

            window.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && helpModal && helpModal.classList.contains('is-open')) {
                    closeHelpModal();
                }
            });

        })();
    </script>
}
