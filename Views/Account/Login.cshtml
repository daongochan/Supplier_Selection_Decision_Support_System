@model SupplierSelectionDSS.Models.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
}

<div class="login-page">

    <div class="login-card">

        <!-- ================================================
             LEFT — Photo Panel
             ================================================ -->
        <div class="login-visual">
            <picture>
                <source srcset="~/images/login-left.webp" type="image/webp" />
                <img src="~/images/login-left.jpg"
                     alt=""
                     class="login-visual-img"
                     aria-hidden="true" />
            </picture>
        </div>



        <!-- ================================================
             RIGHT — Login Form Panel
             ================================================ -->

        <div class="login-form-panel">
            <div class="login-form-inner">

                <!-- Header -->
                <div class="login-form-header">
                    <h1 class="login-form-title">Sign In</h1>
                    <p class="login-form-subtitle">
                        Enter your credentials to access the Supplier Selection DSS workspace.
                    </p>
                </div>

                <!-- Server validation error alert -->
                @{
                    var modelErrors = ViewData.ModelState
                        .SelectMany(x => x.Value?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
                        .Select(e => e.ErrorMessage)
                        .Where(m => !string.IsNullOrWhiteSpace(m))
                        .ToList();
                }

                @if (modelErrors.Any())
                {
                    <div class="login-alert" role="alert">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <ul>
                            @foreach (var err in modelErrors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }

                <!-- Form -->
                <form asp-action="Login"
                      method="post"
                      id="loginForm"
                      autocomplete="on"
                      novalidate>

                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <!-- Username -->
                    <div class="login-field">
                        <label class="login-label"
                               for="Username">
                            Username
                        </label>
                        <div class="login-input-wrap">
                            <i class="bi bi-person login-input-icon"></i>
                            <input asp-for="Username"
                                   id="Username"
                                   class="login-input @(ViewData.ModelState["Username"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                   type="text"
                                   placeholder="Enter your username"
                                   autocomplete="username"
                                   spellcheck="false" />
                        </div>
                        <span asp-validation-for="Username"
                              class="login-field-error"></span>
                    </div>

                    <!-- Password -->
                    <div class="login-field">
                        <label class="login-label"
                               for="Password">
                            Password
                        </label>
                        <div class="login-input-wrap">
                            <i class="bi bi-lock login-input-icon"></i>
                            <input asp-for="Password"
                                   id="Password"
                                   class="login-input @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                   type="password"
                                   placeholder="Enter your password"
                                   autocomplete="current-password" />
                            <button type="button"
                                    class="login-pw-toggle"
                                    id="pwToggle"
                                    aria-label="Show/hide password"
                                    aria-pressed="false"
                                    title="Show/hide password">
                                <i class="bi bi-eye" id="pwToggleIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password"
                              class="login-field-error"></span>
                    </div>

                    <!-- Remember me -->
                    <div class="login-options">
                        <label class="login-remember-label" for="RememberMe">
                            <input asp-for="RememberMe"
                                   id="RememberMe"
                                   type="checkbox" />
                            Remember me
                        </label>
                    </div>

                    <!-- Submit -->
                    <button type="submit"
                            class="login-submit"
                            id="loginBtn">
                        <span id="loginBtnText">Sign In</span>
                    </button>

                </form>

            </div>
        </div>

    </div>

</div>


@section Scripts {

    <script>
        (function () {

            // ── Show / Hide Password ──────────────────────────
            var pwInput  = document.getElementById('Password');
            var pwToggle = document.getElementById('pwToggle');
            var pwIcon   = document.getElementById('pwToggleIcon');

            if (pwToggle && pwInput) {
                pwToggle.addEventListener('click', function () {
                    var isPassword = pwInput.type === 'password';
                    pwInput.type   = isPassword ? 'text' : 'password';
                    pwIcon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
                    pwToggle.setAttribute('aria-pressed', isPassword ? 'true' : 'false');
                    pwInput.focus();
                });
            }

            // ── Loading State on Submit ───────────────────────
            var form    = document.getElementById('loginForm');
            var loginBtn = document.getElementById('loginBtn');
            var btnText  = document.getElementById('loginBtnText');

            if (form && loginBtn) {
                form.addEventListener('submit', function () {
                    // Brief delay so native validation runs first
                    setTimeout(function () {
                        loginBtn.disabled = true;
                        loginBtn.innerHTML =
                            '<span class="login-spinner" aria-hidden="true"></span>' +
                            '<span>Signing in...</span>';
                    }, 10);
                });
            }

        })();
    </script>
}