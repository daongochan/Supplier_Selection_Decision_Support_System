@model SupplierSelectionDSS.Models.AHPComparisonViewModel
@using SupplierSelectionDSS.Constants

@{
    ViewData["Title"] = "AHP Pairwise Comparison";

    var criteriaCount =
        Model.Criteria.Count;

    var canCalculate =
        Model.Status != "Completed" &&
        Model.Status != "Cancelled";

    var hasResult =
        Model.Result?.HasResult == true;

    var isConsistent =
        hasResult &&
        Model.Result!.IsConsistent;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/ahp.css" asp-append-version="true" />
}


<!-- =========================================================
     PAGE HEADER
     ========================================================= -->

<div class="page-header">

    <div>

        <div class="page-eyebrow">
            AHP · ANALYTICAL HIERARCHY PROCESS
        </div>

        <h1 class="page-title">
            Pairwise comparison
        </h1>

        <p class="page-description">
            @Model.BatchCode
            ·
            @Model.BatchName
        </p>

    </div>


    <div class="page-header-actions">

        <span class="status-pill
            status-@Model.Status.ToLowerInvariant()">

            @Model.Status

        </span>


        <a asp-controller="EvaluationBatch"
           asp-action="Details"
           asp-route-id="@Model.BatchId"
           class="btn-outline">

            Back to Batch

        </a>

    </div>

</div>




<!-- =========================================================
     WORKFLOW
     ========================================================= -->

<div class="ahp-workflow">

    <div class="ahp-workflow-step ahp-workflow-complete">

        <span class="ahp-workflow-number">
            01
        </span>

        <div>

            <strong>
                Evaluation
            </strong>

            <small>
                Supplier scores
            </small>

        </div>

    </div>


    <div class="ahp-workflow-line"></div>


    <div class="ahp-workflow-step ahp-workflow-current">

        <span class="ahp-workflow-number">
            02
        </span>

        <div>

            <strong>
                AHP
            </strong>

            <small>
                Criteria weights
            </small>

        </div>

    </div>


    <div class="ahp-workflow-line"></div>


    <div class="ahp-workflow-step
        @(isConsistent
            ? "ahp-workflow-complete"
            : "ahp-workflow-disabled")">

        <span class="ahp-workflow-number">
            03
        </span>

        <div>

            <strong>
                TOPSIS
            </strong>

            <small>
                Supplier ranking
            </small>

        </div>

    </div>


    <div class="ahp-workflow-line"></div>


    <div class="ahp-workflow-step ahp-workflow-disabled">

        <span class="ahp-workflow-number">
            04
        </span>

        <div>

            <strong>
                Result
            </strong>

            <small>
                Decision
            </small>

        </div>

    </div>

</div>


<!-- =========================================================
     SAATY SCALE & SHARED MATRIX NOTICE
     ========================================================= -->

<div class="alert alert-info mb-3" style="border-radius: var(--radius-md); padding: 14px 18px; border: 1px solid rgba(59, 130, 246, 0.35); background: rgba(59, 130, 246, 0.08);">
    <i class="bi bi-people-fill me-2 text-primary"></i>
    <strong>Shared Batch Matrix:</strong> This batch uses a shared comparison matrix. Changes saved by other users may require you to reload.
</div>

<div class="ahp-scale-card">

    <div class="ahp-scale-intro">

        <div class="page-eyebrow">
            SAATY SCALE
        </div>

        <h2 class="section-title">
            Relative importance
        </h2>

        <p>
            Enter values in the upper triangle cells only.
            Reciprocal values for the lower triangle are generated automatically.
        </p>

    </div>


    <div class="ahp-scale-grid">

        <div>
            <strong>1</strong>
            <span>Equal</span>
        </div>

        <div>
            <strong>3</strong>
            <span>Moderate</span>
        </div>

        <div>
            <strong>5</strong>
            <span>Strong</span>
        </div>

        <div>
            <strong>7</strong>
            <span>Very strong</span>
        </div>

        <div>
            <strong>9</strong>
            <span>Extreme</span>
        </div>

    </div>

</div>


<!-- =========================================================
     PAIRWISE MATRIX
     ========================================================= -->

<div class="table-card ahp-matrix-card">

    <form method="post"
          action="@Url.Action(
                              "Save",
                              "AHP",
                              new
                              {
                                  batchId = Model.BatchId
                              })"
          id="ahpForm">

        @Html.AntiForgeryToken()


        <input type="hidden"
               name="BatchId"
               value="@Model.BatchId" />
        <input type="hidden"
               name="RowVersion"
               value="@Model.RowVersion" />


        <div class="ahp-table-wrapper">

            <table class="ahp-table">

                <thead>

                    <tr>

                        <th scope="col" class="ahp-corner">
                            Criteria
                        </th>


                        @foreach (
                            var criterion
                            in Model.Criteria)
                        {
                            <th scope="col">

                                <span>
                                    @criterion.CriteriaCode
                                </span>

                                <small>
                                    @criterion.CriteriaName
                                </small>

                            </th>
                        }

                    </tr>

                </thead>


                <tbody>

                    @{
                        var comparisonIndex = 0;
                    }


                    @for (
                        var rowIndex = 0;
                        rowIndex < Model.Criteria.Count;
                        rowIndex++)
                    {
                        var rowCriterion =
                            Model.Criteria[rowIndex];


                        <tr>

                            <th scope="row" class="ahp-row-header">

                                <strong>
                                    @rowCriterion.CriteriaCode
                                </strong>

                                <span>
                                    @rowCriterion.CriteriaName
                                </span>

                            </th>


                            @for (
                                var colIndex = 0;
                                colIndex < Model.Criteria.Count;
                                colIndex++)
                            {
                                var colCriterion =
                                    Model.Criteria[colIndex];


                                var key =
                                    $"{rowCriterion.CriteriaId}_{colCriterion.CriteriaId}";


                                var isDiagonal =
                                    rowIndex == colIndex;


                                var isUpperTriangle =
                                    rowIndex < colIndex;


                                <td>

                                    @if (isDiagonal)
                                    {
                                        <span class="ahp-diagonal" aria-label="Đường chéo chính bằng 1">
                                            1
                                        </span>
                                    }
                                    else if (isUpperTriangle)
                                    {
                                        var existingValue =
                                            Model.Values.TryGetValue(
                                                key,
                                                out var storedValue)
                                                ? storedValue
                                                : 0m;

                                        var currentCode = existingValue > 0m
                                            ? SaatyScale.FormatCanonicalFraction(existingValue)
                                            : "";

                                        <input type="hidden"
                                               name="Comparisons[@comparisonIndex].CriteriaRowId"
                                               value="@rowCriterion.CriteriaId" />

                                        <input type="hidden"
                                               name="Comparisons[@comparisonIndex].CriteriaColId"
                                               value="@colCriterion.CriteriaId" />

                                        <input type="hidden"
                                               name="Comparisons[@comparisonIndex].Value"
                                               value="@(existingValue == 0m ? "" : existingValue.ToString("0.####"))"
                                               class="ahp-hidden-decimal"
                                               data-row-id="@rowCriterion.CriteriaId"
                                               data-col-id="@colCriterion.CriteriaId" />

                                        <div class="ahp-select-wrap">
                                            <select name="Comparisons[@comparisonIndex].ScaleCode"
                                                    class="ahp-select form-control"
                                                    aria-label="Compare @rowCriterion.CriteriaName (@rowCriterion.CriteriaCode) with @colCriterion.CriteriaName (@colCriterion.CriteriaCode)"
                                                    data-row-id="@rowCriterion.CriteriaId"
                                                    data-col-id="@colCriterion.CriteriaId"
                                                    data-row-name="@rowCriterion.CriteriaName"
                                                    data-col-name="@colCriterion.CriteriaName">
                                                <option value="" selected="@(string.IsNullOrEmpty(currentCode))">Select...</option>
                                                @foreach (var entry in SaatyScale.Entries)
                                                {
                                                    <option value="@entry.Code" selected="@(currentCode == entry.Code)">@entry.Code</option>
                                                }
                                            </select>

                                            <div class="ahp-pair-explanation"
                                                 data-explanation-row="@rowCriterion.CriteriaId"
                                                 data-explanation-col="@colCriterion.CriteriaId">
                                                @(!string.IsNullOrEmpty(currentCode) ? SaatyScale.GetComparisonExplanation(rowCriterion.CriteriaName, colCriterion.CriteriaName, currentCode) : "")
                                            </div>
                                        </div>

                                        comparisonIndex++;
                                    }
                                    else
                                    {
                                        var inverseKey =
                                            $"{colCriterion.CriteriaId}_{rowCriterion.CriteriaId}";

                                        if (Model.Values.TryGetValue(inverseKey, out var upperValue) && upperValue > 0)
                                        {
                                            var reciprocalCode = SaatyScale.FormatCanonicalFraction(SaatyScale.GetReciprocalDecimal(upperValue));
                                            <span class="ahp-inverse-value"
                                                  aria-label="Reciprocal value of @colCriterion.CriteriaCode relative to @rowCriterion.CriteriaCode: @reciprocalCode"
                                                  data-source-row="@colCriterion.CriteriaId"
                                                  data-source-col="@rowCriterion.CriteriaId">
                                                @reciprocalCode
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="ahp-empty"
                                                  aria-label="No reciprocal value yet"
                                                  data-source-row="@colCriterion.CriteriaId"
                                                  data-source-col="@rowCriterion.CriteriaId">
                                                —
                                            </span>
                                        }
                                    }
                                </td>
                            }

                        </tr>
                    }

                </tbody>

            </table>

        </div>


<!-- =================================================
             SAVE FOOTER
             ================================================= -->

<div class="ahp-footer">

    <div class="ahp-note">

        <span class="ahp-note-dot"></span>

        <span>
            Save the pairwise comparison matrix before running AHP calculation.
        </span>

    </div>


    @if (canCalculate)
    {
        <button type="submit"
                class="btn-outline">

            Save comparisons

        </button>
    }

</div>

</form>

</div>


<!-- =========================================================
     CALCULATE AHP
     ========================================================= -->
@if (criteriaCount >= 2 &&
     canCalculate)
{
    <form method="post"
          action="@Url.Action(
                              "Calculate",
                              "AHP",
                              new
                              {
                                  batchId = Model.BatchId
                              })"
          class="ahp-calculate-form">

        @Html.AntiForgeryToken()
        <input type="hidden"
               name="rowVersion"
               value="@Model.RowVersion" />


        <div class="ahp-calculate-content">

            <div class="ahp-calculate-copy">

                <div class="page-eyebrow">
                    AHP CALCULATION
                </div>

                <h3>
                    Calculate criteria weights.
                </h3>

                <p>
                    Computes the priority vector (criteria weights), λmax, CI,
                    RI, and Consistency Ratio (CR) from the saved pairwise comparison matrix.
                </p>

            </div>


            <button type="submit"
                    class="btn-primary"
                    data-dss-confirm="Calculating AHP will recompute all criteria weights and require recalculating TOPSIS if rankings already exist. Do you want to proceed?"
                    data-dss-title="Calculate AHP"
                    data-dss-btn-text="Calculate AHP">

                <i class="bi bi-calculator"></i>

                Calculate AHP

            </button>

        </div>

    </form>
}


<!-- =========================================================
     AHP RESULT
     ========================================================= -->
@if (hasResult)
{
    <div class="ahp-result-section">


        <!-- =================================================
             RESULT SUMMARY
             ================================================= -->

        <div class="ahp-result-card">

            <div class="ahp-result-header">

                <div>

                    <div class="page-eyebrow">
                        AHP RESULT
                    </div>

                    <h2 class="section-title">
                        Consistency analysis
                    </h2>

                </div>


                @if (isConsistent)
                {
                    <span class="
                        ahp-consistency-badge
                        ahp-consistency-good">

                        <i class="bi bi-check-circle-fill"></i>

                        Consistent

                    </span>
                }
                else
                {
                    <span class="
                        ahp-consistency-badge
                        ahp-consistency-bad">

                        <i class="bi bi-exclamation-triangle-fill"></i>

                        Inconsistent

                    </span>
                }

            </div>


            <div class="ahp-metrics">

                <div class="ahp-metric">

                    <span>
                        λmax
                    </span>

                    <strong>
                        @Model.Result!.LambdaMax.ToString("0.0000")
                    </strong>

                </div>


                <div class="ahp-metric">

                    <span>
                        CI
                    </span>

                    <strong>
                        @Model.Result.CIValue.ToString("0.0000")
                    </strong>

                </div>


                <div class="ahp-metric">

                    <span>
                        RI
                    </span>

                    <strong>
                        @Model.Result.RIValue.ToString("0.0000")
                    </strong>

                </div>


                <div class="
                    ahp-metric
                    ahp-metric-highlight">

                    <span>
                        CR
                    </span>

                    <strong>
                        @Model.Result.CRValue.ToString("0.0000")
                    </strong>

                </div>

            </div>


            <div class="ahp-consistency-note">

                @if (isConsistent)
                {
                    <span>
                        The pairwise comparison matrix is consistent (CR ≤ 0.10).
                        These AHP criteria weights can now be used for TOPSIS ranking.
                    </span>
                }
                else
                {
                    <span>
                        The pairwise comparison matrix is inconsistent (CR &gt; 0.10).
                        Please revise the pairwise comparisons before proceeding to TOPSIS.
                    </span>
                }

            </div>

        </div>


        <!-- =================================================
             CRITERIA WEIGHTS
             ================================================= -->

        <div class="table-card ahp-weight-card">

            <div class="ahp-weight-header">

                <div>

                    <div class="page-eyebrow">
                        CRITERIA WEIGHTS
                    </div>

                    <h2 class="section-title">
                        Priority vector
                    </h2>

                </div>

            </div>


            <div class="data-table-wrapper">

                <table class="data-table ahp-weight-table">

                    <thead>

                        <tr>

                            <th>
                                Rank
                            </th>

                            <th>
                                Criteria
                            </th>

                            <th>
                                Weight
                            </th>

                            <th>
                                Percentage
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            var rank = 1;
                        }


                        @foreach (
                            var weight
                            in Model.Result!.Weights
                                .OrderByDescending(
                                    x =>
                                        x.WeightValue))
                        {
                            <tr>

                                <td>

                                    <span class="weight-rank">
                                        @rank
                                    </span>

                                </td>


                                <td>

                                    <strong>
                                        @weight.CriteriaCode
                                    </strong>

                                    <span class="table-muted">
                                        @weight.CriteriaName
                                    </span>

                                </td>


                                <td>

                                    <strong>
                                        @weight.WeightValue.ToString("0.000000")
                                    </strong>

                                </td>


                                <td>

                                    <div class="weight-progress">

                                        <div class="weight-progress-bar"
                                             style="
                                            width:@(
                                             Math.Clamp(
                                                 weight.Percentage,
                                                 0,
                                                 100)
                                                                                        )%;
                                            ">
                                        </div>

                                    </div>

                                    <span class="weight-percentage">

                                        @weight.Percentage.ToString("0.00")%

                                    </span>

                                </td>

                            </tr>


                            rank++;
                        }

                    </tbody>

                </table>

            </div>

        </div>


        <!-- =================================================
             NEXT STEP
             ================================================= -->
        @if (isConsistent)
        {
            <div class="ahp-next-step">

                <div>

                    <div class="page-eyebrow">
                        NEXT STEP
                    </div>

                    <h2>
                        Criteria weights are ready.
                    </h2>

                    <p>
                        The AHP matrix meets the consistency threshold.
                        Proceed to TOPSIS to rank the candidate suppliers.
                    </p>

                </div>


                <div class="ahp-next-step-actions">

                    <a asp-controller="EvaluationBatch"
                       asp-action="Details"
                       asp-route-id="@Model.BatchId"
                       class="btn-outline">

                        Batch Details

                    </a>


                    <a asp-controller="TOPSIS"
                       asp-action="Index"
                       asp-route-batchId="@Model.BatchId"
                       class="btn-primary">

                        Continue to TOPSIS

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>
        }
        else
        {
            <div class="
                ahp-next-step
                ahp-next-step-warning">

                <div>

                    <div class="page-eyebrow">
                        REVIEW REQUIRED
                    </div>

                    <h2>
                        Review the AHP matrix.
                    </h2>

                    <p>
                        CR exceeds 0.10.
                        Please adjust the pairwise comparisons before continuing to TOPSIS.
                    </p>

                </div>


                <a asp-controller="AHP"
                   asp-action="Index"
                   asp-route-batchId="@Model.BatchId"
                   class="btn-outline">

                    Adjust Matrix

                </a>

            </div>
        }

    </div>
}


@functions {
    public string FormatAHPValue(decimal value)
    {
        return SaatyScale.FormatCanonicalFraction(value);
    }
}

@section Scripts {
    <script src="~/js/pages/ahp.js" asp-append-version="true"></script>
}