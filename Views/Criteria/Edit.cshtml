@model SupplierSelectionDSS.Models.CriteriaFormViewModel

@{
    ViewData["Title"] = "Edit Criteria";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/criteria.css" asp-append-version="true" />
}

<div class="page-header">

    <div>

        <div class="page-eyebrow">
            CRITERIA MANAGEMENT
        </div>

        <h1 class="page-title">
            Edit Criterion
        </h1>

        <p class="page-description">
            Update evaluation criterion properties, measurement units, and impact direction.
        </p>

    </div>

    <a asp-action="Index" class="btn-outline">
        <i class="bi bi-arrow-left"></i>
        <span>Back to Criteria</span>
    </a>

</div>


<div class="form-card">

    <form asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="CriteriaId" />

        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>


        <div class="form-grid">

            <!-- 1. Criteria Identity -->
            <div class="form-section">
                <div class="form-section-title">Criterion Information</div>
                <div class="form-section-desc">Code identifier and display name used across evaluations</div>
            </div>

            <div class="form-group">
                <label asp-for="CriteriaCode" class="required-field">
                    Criteria Code
                </label>
                <input asp-for="CriteriaCode"
                       class="form-control"
                       maxlength="20"
                       autocomplete="off" />
                <span asp-validation-for="CriteriaCode" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CriteriaName" class="required-field">
                    Criteria Name
                </label>
                <input asp-for="CriteriaName"
                       class="form-control"
                       maxlength="150" />
                <span asp-validation-for="CriteriaName" class="text-danger"></span>
            </div>

            <!-- 2. Evaluation Attributes -->
            <div class="form-section">
                <div class="form-section-title">Classification & Unit</div>
                <div class="form-section-desc">Impact direction (Benefit / Cost) and measurement unit</div>
            </div>

            <div class="form-group">
                <label asp-for="CriteriaType" class="required-field">
                    Criteria Type
                </label>
                <select asp-for="CriteriaType" class="form-control">
                    <option value="Benefit">Benefit (Higher is better - Quality, Capacity, Service)</option>
                    <option value="Cost">Cost (Lower is better - Price, Lead Time, Defect Rate)</option>
                </select>
                <span asp-validation-for="CriteriaType" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Unit">
                    Measurement Unit
                </label>
                <input asp-for="Unit"
                       class="form-control"
                       maxlength="30" />
                <span asp-validation-for="Unit" class="text-danger"></span>
            </div>

            <!-- 3. Description & Notes -->
            <div class="form-section">
                <div class="form-section-title">Description & Guidelines</div>
                <div class="form-section-desc">Assessment guidance, scoring rules, and data verification notes</div>
            </div>

            <div class="form-group form-group-full">
                <label asp-for="Description">
                    Detailed Description
                </label>
                <textarea asp-for="Description"
                          class="form-control"
                          maxlength="500"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

        </div>


        <div class="form-actions">

            <a asp-action="Index"
               class="btn-outline">
                Cancel
            </a>

            <button type="submit"
                    class="btn-primary">
                Save Changes
            </button>

        </div>

    </form>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
