@model SupplierSelectionDSS.Models.CriteriaIndexViewModel

@{
    ViewData["Title"] = "Evaluation Criteria";

    var benefitPercent = Model.TotalCriteria > 0 
        ? (Model.BenefitCriteria * 100.0 / Model.TotalCriteria).ToString("0.#") 
        : "0";
    var costPercent = Model.TotalCriteria > 0 
        ? (Model.CostCriteria * 100.0 / Model.TotalCriteria).ToString("0.#") 
        : "0";
    var activePercent = Model.TotalCriteria > 0 
        ? (Model.ActiveCriteria * 100.0 / Model.TotalCriteria).ToString("0.#") 
        : "0";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/criteria.css" asp-append-version="true" />
}

<!-- =========================================================
     PAGE HEADER
     ========================================================= -->
<div class="page-header">
    <div>
        <h1 class="page-title">Evaluation Criteria</h1>
        <p class="page-description">
            Manage evaluation criteria, criteria types (Benefit / Cost), and measurement units in the DSS.
        </p>
    </div>

    <a asp-action="Create" class="btn-primary">
        <i class="bi bi-plus-lg"></i>
        <span>Add Criteria</span>
    </a>
</div>

<!-- =========================================================
     KPI SUMMARY GRID (100% GENUINE DATABASE METRICS)
     ========================================================= -->
<div class="criteria-kpi-grid">
    <!-- Card 1: Total Criteria -->
    <div class="criteria-kpi-card">
        <div class="criteria-kpi-content">
            <span class="criteria-kpi-label">Total Criteria</span>
            <span class="criteria-kpi-value">@Model.TotalCriteria.ToString("N0")</span>
            <div class="criteria-kpi-meta">
                <span class="kpi-meta-pill pill-blue">
                    <i class="bi bi-sliders"></i> Evaluation system
                </span>
            </div>
        </div>
        <div class="criteria-kpi-icon icon-blue" aria-hidden="true">
            <i class="bi bi-sliders"></i>
        </div>
    </div>

    <!-- Card 2: Benefit Criteria -->
    <div class="criteria-kpi-card">
        <div class="criteria-kpi-content">
            <span class="criteria-kpi-label">Benefit Criteria</span>
            <span class="criteria-kpi-value">@Model.BenefitCriteria.ToString("N0")</span>
            <div class="criteria-kpi-meta">
                <span class="kpi-meta-pill pill-green">
                    <i class="bi bi-graph-up-arrow"></i> @benefitPercent% of total
                </span>
            </div>
        </div>
        <div class="criteria-kpi-icon icon-green" aria-hidden="true">
            <i class="bi bi-graph-up-arrow"></i>
        </div>
    </div>

    <!-- Card 3: Cost Criteria -->
    <div class="criteria-kpi-card">
        <div class="criteria-kpi-content">
            <span class="criteria-kpi-label">Cost Criteria</span>
            <span class="criteria-kpi-value">@Model.CostCriteria.ToString("N0")</span>
            <div class="criteria-kpi-meta">
                <span class="kpi-meta-pill pill-amber">
                    <i class="bi bi-graph-down-arrow"></i> @costPercent% of total
                </span>
            </div>
        </div>
        <div class="criteria-kpi-icon icon-amber" aria-hidden="true">
            <i class="bi bi-graph-down-arrow"></i>
        </div>
    </div>

    <!-- Card 4: Active -->
    <div class="criteria-kpi-card">
        <div class="criteria-kpi-content">
            <span class="criteria-kpi-label">Active</span>
            <span class="criteria-kpi-value">@Model.ActiveCriteria.ToString("N0")</span>
            <div class="criteria-kpi-meta">
                <span class="kpi-meta-pill pill-indigo">
                    <i class="bi bi-check2-circle"></i> @activePercent% of total
                </span>
            </div>
        </div>
        <div class="criteria-kpi-icon icon-indigo" aria-hidden="true">
            <i class="bi bi-check2-circle"></i>
        </div>
    </div>
</div>

<!-- =========================================================
     SEARCH & FILTER CARD
     ========================================================= -->
<div class="filter-card">
    <form asp-action="Index" method="get" class="criteria-filter">
        <input type="hidden" name="page" value="1" />

        <!-- 1. Keyword Search -->
        <div class="filter-field">
            <label for="keyword">Search</label>
            <input id="keyword"
                   name="keyword"
                   value="@Model.Keyword"
                   class="form-control"
                   placeholder="Criteria code, name, description..." />
        </div>

        <!-- 2. Type Dropdown -->
        <div class="filter-field">
            <label for="type">Criteria Type</label>
            <select id="type" name="type" class="form-control">
                <option value="All" selected="@(string.IsNullOrEmpty(Model.Type) || Model.Type == "All")">
                    All Types
                </option>
                <option value="Benefit" selected="@(Model.Type == "Benefit")">
                    Benefit
                </option>
                <option value="Cost" selected="@(Model.Type == "Cost")">
                    Cost
                </option>
            </select>
        </div>

        <!-- 3. Status Dropdown -->
        <div class="filter-field">
            <label for="status">Status</label>
            <select id="status" name="status" class="form-control">
                <option value="All" selected="@(string.IsNullOrEmpty(Model.Status) || Model.Status == "All")">
                    All Statuses
                </option>
                <option value="Active" selected="@(Model.Status == "Active")">
                    Active
                </option>
                <option value="Inactive" selected="@(Model.Status == "Inactive")">
                    Inactive
                </option>
            </select>
        </div>

        <!-- 4. Filter Action Buttons (Same height 42px) -->
        <div class="filter-actions">
            <button type="submit" class="btn-primary" title="Search">
                Search
            </button>

            <a asp-action="Index" class="btn-outline" title="Reset filters">
                Reset
            </a>
        </div>
    </form>
</div>

<!-- =========================================================
     CENTRAL DATA TABLE CARD
     ========================================================= -->
<div class="table-card">
    @if (Model.Criteria.Any())
    {
        <div class="data-table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 140px;">Criteria Code</th>
                        <th style="min-width: 240px;">Criteria Name</th>
                        <th style="min-width: 260px;">Description</th>
                        <th style="width: 160px;">Criteria Type</th>
                        <th style="width: 130px;">Unit</th>
                        <th style="width: 150px;">Status</th>
                        <th style="width: 70px; text-align: center;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var criterion in Model.Criteria)
                    {
                        <tr>
                            <!-- Criteria Code -->
                            <td>
                                <span class="criteria-code-badge">@criterion.CriteriaCode</span>
                            </td>

                            <!-- Criteria Name -->
                            <td>
                                <div class="criteria-name-cell">
                                    <a asp-action="Edit" asp-route-id="@criterion.CriteriaId" class="criteria-name-link">
                                        @criterion.CriteriaName
                                    </a>
                                </div>
                            </td>

                            <!-- Description -->
                            <td>
                                @if (!string.IsNullOrWhiteSpace(criterion.Description))
                                {
                                    <span class="criteria-description-cell" title="@criterion.Description">
                                        @criterion.Description
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <!-- Criteria Type -->
                            <td>
                                @if (criterion.CriteriaType == "Benefit")
                                {
                                    <span class="criteria-type-badge type-benefit" title="Higher is better">
                                        <i class="bi bi-arrow-up-right"></i>
                                        <span>Benefit</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="criteria-type-badge type-cost" title="Lower is better">
                                        <i class="bi bi-arrow-down-right"></i>
                                        <span>Cost</span>
                                    </span>
                                }
                            </td>

                            <!-- Unit -->
                            <td>
                                @if (!string.IsNullOrWhiteSpace(criterion.Unit))
                                {
                                    <span class="criteria-unit-pill">@criterion.Unit</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <!-- Status -->
                            <td>
                                @if (criterion.Status == "Active")
                                {
                                    <span class="status-pill status-active">Active</span>
                                }
                                else
                                {
                                    <span class="status-pill status-inactive">Inactive</span>
                                }
                            </td>

                            <!-- Actions dropdown [ ⋯ ] -->
                            <td style="text-align: center;">
                                <div class="criteria-actions-dropdown">
                                    <button type="button"
                                            class="btn-action-dots"
                                            aria-label="Actions for @criterion.CriteriaName"
                                            title="Actions">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>

                                    <div class="criteria-actions-menu">
                                        <a asp-action="Edit"
                                           asp-route-id="@criterion.CriteriaId"
                                           class="criteria-action-item">
                                            <i class="bi bi-pencil"></i>
                                            <span>Edit</span>
                                        </a>

                                        <div class="criteria-action-divider"></div>

                                        <form asp-action="ToggleStatus"
                                              method="post"
                                              class="m-0 p-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden"
                                                   name="id"
                                                   value="@criterion.CriteriaId" />
                                            <button type="submit"
                                                    class="criteria-action-item @(criterion.Status == "Active" ? "text-danger" : "text-success")"
                                                    data-dss-confirm="@(criterion.Status == "Active" ? $"Are you sure you want to deactivate criterion \"{criterion.CriteriaName}\"?" : $"Are you sure you want to reactivate criterion \"{criterion.CriteriaName}\"?")"
                                                    data-dss-title="@(criterion.Status == "Active" ? "Confirm Deactivation" : "Confirm Activation")"
                                                    data-dss-btn-text="@(criterion.Status == "Active" ? "Deactivate" : "Activate")">
                                                @if (criterion.Status == "Active")
                                                {
                                                    <i class="bi bi-slash-circle"></i>
                                                    <span>Deactivate</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-check-circle"></i>
                                                    <span>Activate</span>
                                                }
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="Model" />
    }
    else
    {
        <div class="empty-state">
            <div style="font-size: 40px; color: var(--muted); margin-bottom: 12px;">
                <i class="bi bi-search"></i>
            </div>
            <h3>No criteria found</h3>
            <p>
                No criteria match the current search criteria or filters.
                Please try again with different keywords or filters.
            </p>
            <div style="display: flex; gap: 10px; justify-content: center; margin-top: 16px;">
                <a asp-action="Index" class="btn-outline">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Reset Filters</span>
                </a>
                <a asp-action="Create" class="btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    <span>Add New Criteria</span>
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Dropdown menu toggle
            document.addEventListener("click", function (e) {
                const trigger = e.target.closest(".btn-action-dots");
                const openDropdown = document.querySelector(".criteria-actions-dropdown.is-open");

                if (trigger) {
                    e.stopPropagation();
                    const parent = trigger.closest(".criteria-actions-dropdown");
                    if (openDropdown && openDropdown !== parent) {
                        openDropdown.classList.remove("is-open");
                    }
                    if (parent) {
                        parent.classList.toggle("is-open");
                    }
                } else if (openDropdown && !e.target.closest(".criteria-actions-menu")) {
                    openDropdown.classList.remove("is-open");
                }
            });

            // Close on Escape key
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") {
                    const openDropdown = document.querySelector(".criteria-actions-dropdown.is-open");
                    if (openDropdown) {
                        openDropdown.classList.remove("is-open");
                    }
                }
            });
        });
    </script>
}
