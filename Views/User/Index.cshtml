@model SupplierSelectionDSS.Models.UserIndexViewModel

@{
    ViewData["Title"] = "Users";

    var activePercent = Model.TotalUsers > 0 
        ? (Model.ActiveUsers * 100.0 / Model.TotalUsers).ToString("0.#") 
        : "0";
    var lockedPercent = Model.TotalUsers > 0 
        ? (Model.LockedUsers * 100.0 / Model.TotalUsers).ToString("0.#") 
        : "0";
    var inactivePercent = Model.TotalUsers > 0 
        ? (Model.InactiveUsers * 100.0 / Model.TotalUsers).ToString("0.#") 
        : "0";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/user.css" asp-append-version="true" />
}

<!-- =========================================================
     PAGE HEADER
     ========================================================= -->
<div class="page-header">
    <div>
        <h1 class="page-title">Users</h1>
        <p class="page-description">
            Manage user accounts, roles, and access status across the system.
        </p>
    </div>

    <a asp-action="Create" class="btn-primary">
        <i class="bi bi-person-plus"></i>
        <span>Add User</span>
    </a>
</div>

<!-- =========================================================
     KPI SUMMARY GRID (100% GENUINE DATABASE METRICS)
     ========================================================= -->
<div class="user-kpi-grid">
    <!-- Card 1: Total Users -->
    <div class="user-kpi-card">
        <div class="user-kpi-content">
            <span class="user-kpi-label">Total Users</span>
            <span class="user-kpi-value">@Model.TotalUsers.ToString("N0")</span>
            <div class="user-kpi-meta">
                <span class="kpi-meta-pill pill-blue">
                    <i class="bi bi-people"></i> System Accounts
                </span>
            </div>
        </div>
        <div class="user-kpi-icon icon-blue" aria-hidden="true">
            <i class="bi bi-people"></i>
        </div>
    </div>

    <!-- Card 2: Active -->
    <div class="user-kpi-card">
        <div class="user-kpi-content">
            <span class="user-kpi-label">Active</span>
            <span class="user-kpi-value">@Model.ActiveUsers.ToString("N0")</span>
            <div class="user-kpi-meta">
                <span class="kpi-meta-pill pill-green">
                    <i class="bi bi-check2"></i> @activePercent% of total
                </span>
            </div>
        </div>
        <div class="user-kpi-icon icon-green" aria-hidden="true">
            <i class="bi bi-check-circle"></i>
        </div>
    </div>

    <!-- Card 3: Locked -->
    <div class="user-kpi-card">
        <div class="user-kpi-content">
            <span class="user-kpi-label">Locked</span>
            <span class="user-kpi-value">@Model.LockedUsers.ToString("N0")</span>
            <div class="user-kpi-meta">
                <span class="kpi-meta-pill pill-amber">
                    <i class="bi bi-lock"></i> @lockedPercent% of total
                </span>
            </div>
        </div>
        <div class="user-kpi-icon icon-amber" aria-hidden="true">
            <i class="bi bi-lock"></i>
        </div>
    </div>

    <!-- Card 4: Inactive -->
    <div class="user-kpi-card">
        <div class="user-kpi-content">
            <span class="user-kpi-label">Inactive</span>
            <span class="user-kpi-value">@Model.InactiveUsers.ToString("N0")</span>
            <div class="user-kpi-meta">
                <span class="kpi-meta-pill pill-muted">
                    <i class="bi bi-person-slash"></i> @inactivePercent% of total
                </span>
            </div>
        </div>
        <div class="user-kpi-icon icon-slate" aria-hidden="true">
            <i class="bi bi-person-slash"></i>
        </div>
    </div>
</div>

<!-- =========================================================
     SEARCH & FILTER CARD
     ========================================================= -->
<div class="filter-card">
    <form asp-action="Index" method="get" class="user-filter">
        <input type="hidden" name="page" value="1" />

        <!-- 1. Keyword Search -->
        <div class="filter-field">
            <label for="keyword">Search</label>
            <input id="keyword"
                   name="keyword"
                   value="@Model.Keyword"
                   class="form-control"
                   placeholder="Username, full name, email, phone..." />
        </div>

        <!-- 2. Role Dropdown -->
        <div class="filter-field">
            <label for="role">Role</label>
            <select id="role" name="role" class="form-control">
                <option value="All" selected="@(string.IsNullOrEmpty(Model.Role) || Model.Role == "All")">
                    All Roles
                </option>
                <option value="Administrator" selected="@(Model.Role == "Administrator")">
                    Administrator
                </option>
                <option value="PurchasingStaff" selected="@(Model.Role == "PurchasingStaff")">
                    Purchasing Staff
                </option>
                <option value="Expert" selected="@(Model.Role == "Expert")">
                    Expert
                </option>
                <option value="Manager" selected="@(Model.Role == "Manager")">
                    Manager
                </option>
            </select>
        </div>

        <!-- 3. Status Dropdown -->
        <div class="filter-field">
            <label for="status">Status</label>
            <select id="status" name="status" class="form-control">
                <option value="All" selected="@(string.IsNullOrEmpty(Model.Status) || Model.Status == "All")">
                    All Statuses
                </option>
                <option value="Active" selected="@(Model.Status == "Active")">
                    Active
                </option>
                <option value="Locked" selected="@(Model.Status == "Locked")">
                    Locked
                </option>
                <option value="Inactive" selected="@(Model.Status == "Inactive")">
                    Inactive
                </option>
            </select>
        </div>

        <!-- 4. Filter Action Buttons (Same height 42px) -->
        <div class="filter-actions">
            <button type="submit" class="btn-primary" title="Search">
                Search
            </button>

            <a asp-action="Index" class="btn-outline" title="Reset filters">
                Reset
            </a>
        </div>
    </form>
</div>

<!-- =========================================================
     CENTRAL DATA TABLE CARD
     ========================================================= -->
<div class="table-card">
    @if (Model.Users.Any())
    {
        <div class="data-table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 140px;">Username</th>
                        <th style="min-width: 220px;">Full Name</th>
                        <th style="width: 170px;">Role</th>
                        <th style="min-width: 210px;">Contact Information</th>
                        <th style="width: 160px;">Last Login</th>
                        <th style="width: 140px;">Status</th>
                        <th style="width: 70px; text-align: center;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <!-- Username -->
                            <td>
                                <span class="user-code-badge">@user.Username</span>
                            </td>

                            <!-- Full Name + Created Date -->
                            <td>
                                <div class="user-name-cell">
                                    <a asp-action="Edit" asp-route-id="@user.UserId" class="user-name-link">
                                        @user.FullName
                                    </a>
                                    <span class="user-created-tag">
                                        <i class="bi bi-clock"></i> Created @user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                    </span>
                                </div>
                            </td>

                            <!-- Role -->
                            <td>
                                @switch (user.Role)
                                {
                                    case "Administrator":
                                        <span class="role-badge role-admin">
                                            <i class="bi bi-shield-lock"></i> Administrator
                                        </span>
                                        break;
                                    case "PurchasingStaff":
                                        <span class="role-badge role-staff">
                                            <i class="bi bi-cart3"></i> Purchasing Staff
                                        </span>
                                        break;
                                    case "Expert":
                                        <span class="role-badge role-expert">
                                            <i class="bi bi-award"></i> Expert
                                        </span>
                                        break;
                                    case "Manager":
                                        <span class="role-badge role-manager">
                                            <i class="bi bi-briefcase"></i> Manager
                                        </span>
                                        break;
                                    default:
                                        <span class="role-badge role-default">
                                            @user.Role
                                        </span>
                                        break;
                                }
                            </td>

                            <!-- Contact Information (Email, Phone) -->
                            <td>
                                <div class="user-contact-cell">
                                    @if (!string.IsNullOrWhiteSpace(user.Email))
                                    {
                                        <span class="user-contact-info">
                                            <i class="bi bi-envelope"></i>
                                            <a href="mailto:@user.Email">@user.Email</a>
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(user.Phone))
                                    {
                                        <span class="user-contact-info">
                                            <i class="bi bi-telephone"></i>
                                            <a href="tel:@user.Phone">@user.Phone</a>
                                        </span>
                                    }
                                    @if (string.IsNullOrWhiteSpace(user.Email) && string.IsNullOrWhiteSpace(user.Phone))
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </div>
                            </td>

                            <!-- Last Login -->
                            <td>
                                @if (user.LastLoginAt.HasValue)
                                {
                                    <span class="user-login-time" title="@user.LastLoginAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")">
                                        @user.LastLoginAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">Never Signed In</span>
                                }
                            </td>

                            <!-- Status -->
                            <td>
                                @switch (user.Status)
                                {
                                    case "Active":
                                        <span class="status-pill status-active">Active</span>
                                        break;
                                    case "Locked":
                                        <span class="status-pill status-locked">Locked</span>
                                        break;
                                    default:
                                        <span class="status-pill status-inactive">Inactive</span>
                                        break;
                                }
                            </td>

                            <!-- Actions dropdown [ ⋯ ] -->
                            <td style="text-align: center;">
                                <div class="user-actions-dropdown">
                                    <button type="button"
                                            class="btn-action-dots"
                                            aria-label="Actions for @user.FullName"
                                            title="Actions">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>

                                    <div class="user-actions-menu">
                                        <a asp-action="Edit"
                                           asp-route-id="@user.UserId"
                                           class="user-action-item">
                                            <i class="bi bi-pencil"></i>
                                            <span>Edit</span>
                                        </a>

                                        <div class="user-action-divider"></div>

                                        <form asp-action="ToggleStatus"
                                              method="post"
                                              class="m-0 p-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.UserId" />
                                            @if (user.Status == "Active")
                                            {
                                                <button type="submit"
                                                        class="user-action-item text-danger"
                                                        data-dss-confirm="Are you sure you want to deactivate user '@user.Username'?"
                                                        data-dss-title="Confirm Deactivation"
                                                        data-dss-btn-text="Deactivate">
                                                    <i class="bi bi-slash-circle"></i>
                                                    <span>Deactivate</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="user-action-item text-success"
                                                        data-dss-confirm="Are you sure you want to reactivate user '@user.Username'?"
                                                        data-dss-title="Confirm Activation"
                                                        data-dss-btn-text="Activate">
                                                    <i class="bi bi-check-circle"></i>
                                                    <span>Activate User</span>
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="Model" />
    }
    else
    {
        <div class="empty-state">
            <div style="font-size: 40px; color: var(--muted); margin-bottom: 12px;">
                <i class="bi bi-search"></i>
            </div>
            <h3>No users found</h3>
            <p>
                No user accounts match the current search criteria or filters.
                Please try again with different keywords or filters.
            </p>
            <div style="display: flex; gap: 10px; justify-content: center; margin-top: 16px;">
                <a asp-action="Index" class="btn-outline">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Reset Filters</span>
                </a>
                <a asp-action="Create" class="btn-primary">
                    <i class="bi bi-person-plus"></i>
                    <span>Add User</span>
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Dropdown menu toggle
            document.addEventListener("click", function (e) {
                const trigger = e.target.closest(".btn-action-dots");
                const openDropdown = document.querySelector(".user-actions-dropdown.is-open");

                if (trigger) {
                    e.stopPropagation();
                    const parent = trigger.closest(".user-actions-dropdown");
                    if (openDropdown && openDropdown !== parent) {
                        openDropdown.classList.remove("is-open");
                    }
                    if (parent) {
                        parent.classList.toggle("is-open");
                    }
                } else if (openDropdown && !e.target.closest(".user-actions-menu")) {
                    openDropdown.classList.remove("is-open");
                }
            });

            // Close on Escape key
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") {
                    const openDropdown = document.querySelector(".user-actions-dropdown.is-open");
                    if (openDropdown) {
                        openDropdown.classList.remove("is-open");
                    }
                }
            });
        });
    </script>
}
