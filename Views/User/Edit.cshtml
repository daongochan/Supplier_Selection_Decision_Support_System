@model SupplierSelectionDSS.Models.UserFormViewModel

@{
    ViewData["Title"] = "Edit User";
}

<div class="page-header">

    <div>

        <div class="page-eyebrow">
            USERS
        </div>

        <h1 class="page-title">
            Edit User
        </h1>

        <p class="page-description">
            Update user account information and access permissions.
        </p>

    </div>

</div>


<div class="form-card">

    <form asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="UserId"
               type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>

        <div class="form-grid">

            <!-- 1. Account Information -->
            <div class="form-section">
                <div class="form-section-title">Account Information</div>
                <div class="form-section-desc">Username, full name, and system role permissions</div>
            </div>

            <div class="form-group">
                <label asp-for="Username" class="required-field">
                    Username
                </label>
                <input asp-for="Username"
                       class="form-control"
                       maxlength="50"
                       readonly />
                <span class="form-hint">
                    Username cannot be changed once the account is created.
                </span>
            </div>

            <div class="form-group">
                <label asp-for="FullName" class="required-field">
                    Full Name
                </label>
                <input asp-for="FullName"
                       class="form-control"
                       maxlength="100" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Role" class="required-field">
                    Role
                </label>
                <select asp-for="Role" class="form-control">
                    <option value="Administrator">Administrator</option>
                    <option value="PurchasingStaff">Purchasing Staff</option>
                    <option value="Expert">Expert</option>
                    <option value="Manager">Manager</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Status" class="required-field">
                    Status
                </label>
                <select asp-for="Status" class="form-control">
                    <option value="Active">Active</option>
                    <option value="Locked">Locked</option>
                    <option value="Inactive">Inactive</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <!-- 2. Contact Information -->
            <div class="form-section">
                <div class="form-section-title">Contact Information</div>
                <div class="form-section-desc">Email address and phone number for system notifications</div>
            </div>

            <div class="form-group">
                <label asp-for="Email">
                    Email
                </label>
                <input asp-for="Email"
                       class="form-control"
                       type="email"
                       maxlength="100" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Phone">
                    Phone
                </label>
                <input asp-for="Phone"
                       class="form-control"
                       maxlength="20" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <!-- 3. Security Credentials -->
            <div class="form-section">
                <div class="form-section-title">Security & Password</div>
                <div class="form-section-desc">Leave password blank to keep current password</div>
            </div>

            <div class="form-group form-group-full">
                <label asp-for="Password">
                    New Password
                </label>
                <input asp-for="Password"
                       class="form-control"
                       type="password"
                       minlength="8"
                       placeholder="Enter new password (leave blank to keep current)"
                       autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn-outline">
                Cancel
            </a>
            <button type="submit" class="btn-primary">
                Save Changes
            </button>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
