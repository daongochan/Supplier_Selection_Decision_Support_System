@model SupplierSelectionDSS.Models.UserFormViewModel

@{
    ViewData["Title"] = "Add User";
}

<div class="page-header">

    <div>

        <h1 class="page-title">
            Add User
        </h1>

        <p class="page-description">
            Create user accounts and manage access permissions for the system.
        </p>

    </div>

</div>


<div class="form-card">

    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>

        <div class="form-grid">

            <!-- 1. Account Information -->
            <div class="form-section">
                <div class="form-section-title">Account Information</div>
                <div class="form-section-desc">Username, full name, and system role permissions</div>
            </div>

            <div class="form-group">
                <label asp-for="Username" class="required-field">
                    Username
                </label>
                <input asp-for="Username"
                       class="form-control"
                       maxlength="50"
                       placeholder="e.g. jsmith"
                       autocomplete="off" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FullName" class="required-field">
                    Full Name
                </label>
                <input asp-for="FullName"
                       class="form-control"
                       maxlength="100"
                       placeholder="Full name of the user" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Role" class="required-field">
                    Role
                </label>
                <select asp-for="Role" class="form-control">
                    <option value="Administrator">Administrator</option>
                    <option value="PurchasingStaff">Purchasing Staff</option>
                    <option value="Expert">Expert</option>
                    <option value="Manager">Manager</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Status" class="required-field">
                    Status
                </label>
                <select asp-for="Status" class="form-control">
                    <option value="Active">Active</option>
                    <option value="Locked">Locked</option>
                    <option value="Inactive">Inactive</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <!-- 2. Contact Information -->
            <div class="form-section">
                <div class="form-section-title">Contact Information</div>
                <div class="form-section-desc">Email address and phone number for system notifications</div>
            </div>

            <div class="form-group">
                <label asp-for="Email">
                    Email
                </label>
                <input asp-for="Email"
                       class="form-control"
                       type="email"
                       maxlength="100"
                       placeholder="email@domain.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Phone">
                    Phone
                </label>
                <input asp-for="Phone"
                       class="form-control"
                       maxlength="20"
                       placeholder="Contact phone number" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <!-- 3. Security Credentials -->
            <div class="form-section">
                <div class="form-section-title">Security & Initial Password</div>
                <div class="form-section-desc">Initial password used for signing in to the system (minimum 8 characters)</div>
            </div>

            <div class="form-group form-group-full">
                <label asp-for="Password" class="required-field">
                    Initial Password
                </label>
                <input asp-for="Password"
                       class="form-control"
                       type="password"
                       minlength="8"
                       placeholder="Enter password (minimum 8 characters)"
                       autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn-outline">
                Cancel
            </a>
            <button type="submit" class="btn-primary">
                Create User
            </button>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
