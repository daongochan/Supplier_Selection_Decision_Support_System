@model SupplierSelectionDSS.Models.AuditLogIndexViewModel
@using SupplierSelectionDSS.Constants

@{
    ViewData["Title"] = "Nhật ký hệ thống";
    var isFiltered = !string.IsNullOrWhiteSpace(Model.Keyword) ||
                     (!string.IsNullOrWhiteSpace(Model.ActionType) && Model.ActionType != "All") ||
                     Model.UserId.HasValue;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/audit-log.css" asp-append-version="true" />
}

<!-- =========================================================
     PAGE HEADER
     ========================================================= -->
<div class="page-header">
    <div>
        <h1 class="page-title">Nhật ký hệ thống</h1>
        <p class="page-description">
            Theo dõi và kiểm toán lịch sử thao tác của người dùng, thay đổi dữ liệu và các quyết định trong hệ thống DSS.
        </p>
    </div>
</div>

<!-- =========================================================
     KPI SUMMARY GRID (100% GENUINE DATABASE METRICS)
     ========================================================= -->
<div class="audit-kpi-grid">
    <!-- Card 1: Tổng bản ghi -->
    <div class="audit-kpi-card">
        <div class="audit-kpi-content">
            <span class="audit-kpi-label">Tổng bản ghi</span>
            <span class="audit-kpi-value">@Model.TotalLogs.ToString("N0")</span>
            <div class="audit-kpi-meta">
                <span class="kpi-meta-pill pill-blue">
                    <i class="bi bi-journal-text"></i> Toàn bộ hệ thống
                </span>
            </div>
        </div>
        <div class="audit-kpi-icon icon-blue" aria-hidden="true">
            <i class="bi bi-journal-text"></i>
        </div>
    </div>

    <!-- Card 2: Hoạt động hôm nay -->
    <div class="audit-kpi-card">
        <div class="audit-kpi-content">
            <span class="audit-kpi-label">Hôm nay</span>
            <span class="audit-kpi-value">@Model.TodayLogs.ToString("N0")</span>
            <div class="audit-kpi-meta">
                <span class="kpi-meta-pill pill-green">
                    <i class="bi bi-calendar-check"></i> Phát sinh trong ngày
                </span>
            </div>
        </div>
        <div class="audit-kpi-icon icon-green" aria-hidden="true">
            <i class="bi bi-calendar-check"></i>
        </div>
    </div>

    <!-- Card 3: Người thao tác -->
    <div class="audit-kpi-card">
        <div class="audit-kpi-content">
            <span class="audit-kpi-label">Người thao tác</span>
            <span class="audit-kpi-value">@Model.ActiveUsersCount.ToString("N0")</span>
            <div class="audit-kpi-meta">
                <span class="kpi-meta-pill pill-indigo">
                    <i class="bi bi-people"></i> Tài khoản ghi nhận
                </span>
            </div>
        </div>
        <div class="audit-kpi-icon icon-indigo" aria-hidden="true">
            <i class="bi bi-people"></i>
        </div>
    </div>

    <!-- Card 4: Thao tác trọng yếu -->
    <div class="audit-kpi-card">
        <div class="audit-kpi-content">
            <span class="audit-kpi-label">Thao tác trọng yếu</span>
            <span class="audit-kpi-value">@Model.CriticalActionsCount.ToString("N0")</span>
            <div class="audit-kpi-meta">
                <span class="kpi-meta-pill pill-amber">
                    <i class="bi bi-shield-check"></i> Đánh giá & Phê duyệt
                </span>
            </div>
        </div>
        <div class="audit-kpi-icon icon-amber" aria-hidden="true">
            <i class="bi bi-shield-check"></i>
        </div>
    </div>
</div>

<!-- =========================================================
     SEARCH & FILTER CARD
     ========================================================= -->
<div class="filter-card">
    <form asp-action="Index" method="get" class="audit-filter">
        <input type="hidden" name="page" value="1" />

        <!-- 1. Keyword Search -->
        <div class="filter-field">
            <label for="keyword">Tìm kiếm</label>
            <input id="keyword"
                   name="keyword"
                   value="@Model.Keyword"
                   class="form-control"
                   placeholder="Người dùng, thao tác, đối tượng, mô tả..." />
        </div>

        <!-- 2. Action Type Dropdown -->
        <div class="filter-field">
            <label for="actionType">Hành động</label>
            <select id="actionType" name="actionType" class="form-control">
                <option value="All" selected="@(string.IsNullOrEmpty(Model.ActionType) || Model.ActionType == "All")">
                    Tất cả hành động
                </option>
                @foreach (var action in AuditActions.All)
                {
                    <option value="@action" selected="@(Model.ActionType == action)">
                        @action
                    </option>
                }
            </select>
        </div>

        <!-- 3. User Dropdown -->
        <div class="filter-field">
            <label for="userId">Người thực hiện</label>
            <select id="userId" name="userId" class="form-control">
                <option value="" selected="@(!Model.UserId.HasValue)">
                    Tất cả người dùng
                </option>
                @foreach (var u in Model.Users)
                {
                    <option value="@u.UserId" selected="@(Model.UserId == u.UserId)">
                        @u.FullName · @u.Username
                    </option>
                }
            </select>
        </div>

        <!-- 4. Filter Action Buttons (Same height 42px) -->
        <div class="filter-actions">
            <button type="submit" class="btn-primary" title="Tìm kiếm">
                Tìm kiếm
            </button>

            <a asp-action="Index" class="btn-outline" title="Đặt lại bộ lọc">
                Đặt lại
            </a>
        </div>
    </form>
</div>

@if (isFiltered)
{
    <div class="audit-filter-banner">
        <div class="audit-filter-banner-text">
            <i class="bi bi-funnel-fill"></i>
            <span>
                Tìm thấy <strong>@Model.TotalCount.ToString("N0")</strong> bản ghi phù hợp với bộ lọc hiện tại.
            </span>
        </div>

        <a asp-action="Index" class="audit-filter-banner-reset">
            <i class="bi bi-x-circle"></i> Đặt lại bộ lọc
        </a>
    </div>
}

<!-- =========================================================
     CENTRAL DATA TABLE CARD
     ========================================================= -->
<div class="table-card">
    @if (Model.Logs.Any())
    {
        <div class="data-table-wrapper">
            <table class="data-table audit-table">
                <thead>
                    <tr>
                        <th style="width: 130px;">Thời gian</th>
                        <th style="min-width: 180px;">Người thực hiện</th>
                        <th style="width: 170px;">Hành động</th>
                        <th style="width: 160px;">Đối tượng</th>
                        <th style="min-width: 250px;">Nội dung mô tả</th>
                        <th style="min-width: 180px;">Thay đổi dữ liệu</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var log in Model.Logs)
                    {
                        var actionClass = "action-default";
                        if (log.ActionType.Contains("Create") || log.ActionType.Contains("Start"))
                        {
                            actionClass = "action-create";
                        }
                        else if (log.ActionType.Contains("Update") || log.ActionType.Contains("Save"))
                        {
                            actionClass = "action-update";
                        }
                        else if (log.ActionType.Contains("Approve"))
                        {
                            actionClass = "action-approve";
                        }
                        else if (log.ActionType.Contains("Reject") || log.ActionType.Contains("Cancel"))
                        {
                            actionClass = "action-danger";
                        }
                        else if (log.ActionType.Contains("Calculate") || log.ActionType.Contains("AHP") || log.ActionType.Contains("TOPSIS"))
                        {
                            actionClass = "action-calc";
                        }

                        <tr>
                            <!-- Thời gian -->
                            <td>
                                <div class="audit-time-cell">
                                    <strong>@log.ActionTime.ToLocalTime().ToString("dd/MM/yyyy")</strong>
                                    <span class="audit-time-sub">@log.ActionTime.ToLocalTime().ToString("HH:mm:ss")</span>
                                </div>
                            </td>

                            <!-- Người thực hiện -->
                            <td>
                                <div class="audit-user-cell">
                                    <span class="audit-user-name">@log.FullName</span>
                                    <span class="user-code-badge audit-username-tag">@log.Username</span>
                                </div>
                            </td>

                            <!-- Hành động -->
                            <td>
                                <span class="audit-action-badge @actionClass">
                                    @log.ActionType
                                </span>
                            </td>

                            <!-- Đối tượng -->
                            <td>
                                @if (!string.IsNullOrWhiteSpace(log.TargetTable))
                                {
                                    <div class="audit-target-cell">
                                        <span class="audit-target-table">@log.TargetTable</span>
                                        @if (log.TargetId.HasValue)
                                        {
                                            <span class="audit-target-id">#@log.TargetId.Value</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <!-- Nội dung mô tả -->
                            <td>
                                @if (!string.IsNullOrWhiteSpace(log.Description))
                                {
                                    <span class="audit-desc-text">@log.Description</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <!-- Thay đổi dữ liệu -->
                            <td>
                                @if (!string.IsNullOrWhiteSpace(log.OldValue) || !string.IsNullOrWhiteSpace(log.NewValue))
                                {
                                    <details class="audit-change-details">
                                        <summary class="audit-change-summary">
                                            <i class="bi bi-code-square"></i>
                                            <span>Xem thay đổi</span>
                                        </summary>
                                        <div class="audit-change-body">
                                            @if (!string.IsNullOrWhiteSpace(log.OldValue))
                                            {
                                                <div class="audit-change-block">
                                                    <span class="audit-change-label label-old">Dữ liệu cũ:</span>
                                                    <pre class="audit-change-pre">@log.OldValue</pre>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(log.NewValue))
                                            {
                                                <div class="audit-change-block">
                                                    <span class="audit-change-label label-new">Dữ liệu mới:</span>
                                                    <pre class="audit-change-pre">@log.NewValue</pre>
                                                </div>
                                            }
                                        </div>
                                    </details>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="Model" />
    }
    else
    {
        <div class="empty-state">
            <div style="font-size: 40px; color: var(--muted); margin-bottom: 12px;">
                <i class="bi bi-journal-x"></i>
            </div>
            <h3>Không tìm thấy nhật ký thao tác nào</h3>
            <p>
                Không có bản ghi nhật ký nào phù hợp với điều kiện tìm kiếm hoặc bộ lọc hiện tại.
                Vui lòng thử lại với từ khóa hoặc bộ lọc khác.
            </p>
            @if (isFiltered)
            {
                <div style="display: flex; gap: 10px; justify-content: center; margin-top: 16px;">
                    <a asp-action="Index" class="btn-outline">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        <span>Đặt lại bộ lọc</span>
                    </a>
                </div>
            }
        </div>
    }
</div>